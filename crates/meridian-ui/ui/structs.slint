// ═══════════════════════════════════════════════════════════
//  Structs — exported data types shared between Slint and Rust.
//
//  These are the *only* Slint structs that cross the FFI boundary.
//  Add new shared data types here.
// ═══════════════════════════════════════════════════════════


// ── InspectorRow ───────────────────────────────────────────
// One row in the scene-config inspector list.

export struct InspectorRow {
    section: string,
    label: string,
    value: string,
}


// ── MidiLoadState ──────────────────────────────────────────
// Describes the loading state for a particular tab mode.
//
// Rust maps these integer values:
//   0 = no-midi     — no MIDI file has been selected at all
//   1 = selected    — a file is selected but not loaded for this mode
//   2 = loading     — actively loading / building caches
//   3 = loaded      — fully loaded and ready for this mode
//   4 = error       — loading failed

export enum MidiLoadState {
    no-midi,
    selected,
    loading,
    loaded,
    error,
}


// ── BarValue ───────────────────────────────────────────────
// Single bar in a histogram / bar chart.
// `value` is normalised 0.0–1.0 (fraction of the max).
// `label` is an optional tooltip / x-axis label.

export struct BarValue {
    value: float,
    label: string,
    count: int,
}


// ── EventCount ─────────────────────────────────────────────
// Name + count pair for the event-type breakdown table.

export struct EventCount {
    name: string,
    count: int,
    fraction: float,
}


// ── SliderCurve ────────────────────────────────────────────
// Determines the mapping between the 0-1 slider position and
// the actual value range.  "linear" gives uniform resolution;
// "quadratic" gives more resolution near the low end (the
// position is squared before scaling). "exponential" keeps
// even more precision near the low end for wide positive ranges.

export enum SliderCurve {
    linear,
    quadratic,
    exponential,
}

import { Theme } from "theme.slint";

// ═══════════════════════════════════════════════════════════
//  Chrome — structural components for the app shell.
//  Profile tabs, transport controls, scrubber.
// ═══════════════════════════════════════════════════════════


// ── ProfileTab ─────────────────────────────────────────────
// Tab in the profile bar. Blue underline when active.

export component ProfileTab inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback pressed;

    min-width: 72px;
    height: 36px;
    background: transparent;

    Text {
        text: root.label;
        color: root.active ? Theme.text-accent-strong : touch.has-hover ? Theme.text-soft : Theme.text-muted;
        font-size: Theme.font-size-lg;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.active ? Theme.accent-fill : transparent;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.pressed(); }
    }
}


// ── TabGroupDivider ───────────────────────────────────────
// Subtle separator between top-level tab groups.

export component TabGroupDivider inherits Rectangle {
    width: 14px;
    height: 36px;
    background: transparent;

    Rectangle {
        x: parent.width / 2 - 0.5px;
        y: 9px;
        width: 1px;
        height: parent.height - 18px;
        border-radius: 0.5px;
        background: Theme.border-strong;
    }
}


// ── TransportButton ────────────────────────────────────────
// 32×32 icon button for play/pause, zoom ±.

export component TransportButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active: false;
    callback pressed;

    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.surface-control-hover : root.active ? #162638 : transparent;

    Text {
        text: root.icon;
        color: root.active ? Theme.text-accent : Theme.text-soft;
        font-size: Theme.font-size-2xl;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.pressed(); }
    }
}


// ── TimeScrubber ───────────────────────────────────────────
// Horizontal seek bar. Thin track, blue fill, round thumb.

export component TimeScrubber inherits Rectangle {
    in property <float> value: 0;
    in property <float> maximum: 1;
    callback scrubbed(float);

    private property <float> clamped-value: value < 0 ? 0 : value > maximum ? maximum : value;
    private property <float> fill-ratio: maximum <= 0 ? 0 : clamped-value / maximum;

    height: 32px;
    background: transparent;

    // Track
    Rectangle {
        x: 0px;
        y: parent.height / 2 - 2px;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-control;
    }
    // Fill
    Rectangle {
        x: 0px;
        y: parent.height / 2 - 2px;
        width: parent.width * root.fill-ratio;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent-fill;
    }
    // Thumb
    Rectangle {
        x: max(0px, min(parent.width - self.width, parent.width * root.fill-ratio - self.width / 2));
        y: parent.height / 2 - 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: touch.has-hover || touch.pressed ? #f0f4fa : #c0cce0;
        drop-shadow-blur: 3px;
        drop-shadow-color: Theme.shadow-soft;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        moved => {
            if (self.pressed) {
                root.scrubbed(maximum * max(0, min(1, self.mouse-x / max(1px, parent.width))));
            }
        }
        clicked => {
            root.scrubbed(maximum * max(0, min(1, self.mouse-x / max(1px, parent.width))));
        }
    }
}

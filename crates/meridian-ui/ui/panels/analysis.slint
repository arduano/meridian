// ═══════════════════════════════════════════════════════════
//  Analysis panel (profile 4).
//
//  Redesigned around a smaller number of thematic zones:
//   - summary / fingerprint
//   - register + tonal profile
//   - activity + tempo
//   - performance character
//   - source structure + event composition
//   - appendix metrics
// ═══════════════════════════════════════════════════════════

import { MidiLoadState, BarValue, EventCount } from "../structs.slint";
import { SectionHeader, Separator, FieldRow } from "../primitives.slint";
import { MidiStateSection } from "../midi_loading.slint";


component SurfaceCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";

    border-radius: 10px;
    background: #0c1420;
    border-width: 1px;
    border-color: #111a28;
    clip: true;
    horizontal-stretch: 1;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: root.title;
            color: #7d8fa8;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.8px;
        }

        if root.subtitle != "" : Text {
            text: root.subtitle;
            color: #4d6580;
            font-size: 10px;
            wrap: word-wrap;
        }

        @children
    }
}

component SummaryStat inherits Rectangle {
    in property <string> value;
    in property <string> label;
    in property <color> accent: #60a5fa;

    min-width: 120px;
    height: 78px;
    horizontal-stretch: 1;
    border-radius: 8px;
    background: #0a1220;
    border-width: 1px;
    border-color: #101a28;

    VerticalLayout {
        alignment: center;
        padding: 10px;
        spacing: 4px;

        Text {
            text: root.value;
            color: root.accent;
            font-family: "monospace";
            font-size: 16px;
            font-weight: 800;
            horizontal-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.label;
            color: #4d6580;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.4px;
            horizontal-alignment: center;
        }
    }
}


component MiniStat inherits Rectangle {
    in property <string> value;
    in property <string> label;

    height: 48px;
    horizontal-stretch: 1;
    border-radius: 7px;
    background: #09111d;

    VerticalLayout {
        alignment: center;
        padding: 6px;
        spacing: 1px;

        Text {
            text: root.value;
            color: #b9c8da;
            font-family: "monospace";
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.label;
            color: #445a75;
            font-size: 8px;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }
}


component InsightTile inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> detail;

    height: 92px;
    horizontal-stretch: 1;
    border-radius: 8px;
    background: #09111d;
    border-width: 1px;
    border-color: #101a28;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        Text {
            text: root.title;
            color: #516983;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 0.5px;
        }

        Text {
            text: root.value;
            color: #d7e3f2;
            font-size: 16px;
            font-weight: 800;
            wrap: word-wrap;
        }

        Text {
            text: root.detail;
            color: #6f829b;
            font-family: "monospace";
            font-size: 10px;
            wrap: word-wrap;
        }
    }
}


component HeroMetric inherits Rectangle {
    in property <string> value;
    in property <string> label;

    height: 58px;
    horizontal-stretch: 1;
    border-radius: 8px;
    background: #09111d;

    VerticalLayout {
        alignment: center;
        padding: 8px;
        spacing: 2px;

        Text {
            text: root.value;
            color: #d7e3f2;
            font-family: "monospace";
            font-size: 13px;
            font-weight: 700;
            horizontal-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.label;
            color: #4d6580;
            font-size: 8px;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }
}


component FooterMetric inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 34px;
    horizontal-stretch: 1;
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 2px;

        Text {
            text: root.value;
            color: #cbd8e8;
            font-family: "monospace";
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.label;
            color: #617691;
            font-size: 9px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}


component BarChart inherits Rectangle {
    in property <[BarValue]> model: [];
    in property <color> bar-color: #2563eb;
    in property <color> bar-color-hover: #3b82f6;
    in property <int> chart-height: 100;
    in property <bool> show-labels: false;

    height: root.chart-height * 1px + (root.show-labels ? 18px : 0px);
    border-radius: 6px;
    background: #080d16;
    clip: true;

    HorizontalLayout {
        spacing: 0px;
        padding-left: 2px;
        padding-right: 2px;

        for bar in root.model : Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            height: parent.height;

            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: root.chart-height * 1px;

                    VerticalLayout {
                        alignment: end;
                        padding-bottom: 1px;

                        Rectangle {
                            height: bar.count > 0 ? max(1px, parent.height * max(0.0, min(1.0, bar.value)) - 1px) : 0px;
                            border-radius: 1px;
                            background: bar-touch.has-hover ? root.bar-color-hover : root.bar-color;

                            bar-touch := TouchArea {
                                mouse-cursor: pointer;
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: #141e2e;
                    }
                }

                if root.show-labels : Rectangle {
                    height: 18px;
                    min-width: 0px;
                    preferred-width: 0px;
                    clip: true;

                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: bar.label;
                        color: #3d5068;
                        font-family: "monospace";
                        font-size: 8px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}


component DensityTimeline inherits Rectangle {
    in property <[BarValue]> model: [];
    in property <color> fill-color: #2563eb40;
    in property <color> peak-color: #60a5fa;
    in property <int> chart-height: 80;

    height: root.chart-height * 1px;
    border-radius: 6px;
    background: #080d16;
    clip: true;

    HorizontalLayout {
        spacing: 0px;
        padding-left: 1px;
        padding-right: 1px;

        for bar in root.model : Rectangle {
            horizontal-stretch: 1;
            height: parent.height;

            VerticalLayout {
                alignment: end;

                Rectangle {
                    height: max(0px, parent.height * max(0.0, min(1.0, bar.value)));
                    background: root.fill-color;

                    Rectangle {
                        height: 1px;
                        background: root.peak-color;
                    }
                }
            }
        }
    }
}


component ShareRow inherits Rectangle {
    in property <string> name;
    in property <int> count;
    in property <float> fraction;
    in property <string> share_text;
    in property <color> accent: #2563eb;

    height: 28px;
    background: transparent;

    HorizontalLayout {
        spacing: 8px;

        Rectangle {
            height: parent.height;
            min-width: 88px;
            background: transparent;

            Text {
                width: parent.width;
                height: parent.height;
                text: root.name;
                color: #8ea0b8;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: parent.height;
            horizontal-stretch: 1;
            background: transparent;

            Rectangle {
                y: (parent.height - 8px) / 2;
                width: parent.width;
                height: 8px;
                border-radius: 4px;
                background: #111a28;

                Rectangle {
                    width: root.fraction > 0 ? max(3px, parent.width * max(0.0, min(1.0, root.fraction))) : 0px;
                    height: parent.height;
                    border-radius: 4px;
                    background: root.accent;
                }
            }
        }

        Rectangle {
            height: parent.height;
            min-width: 48px;
            background: transparent;

            Text {
                width: parent.width;
                height: parent.height;
                text: root.share_text;
                color: #6b7d94;
                font-family: "monospace";
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        Rectangle {
            height: parent.height;
            min-width: 54px;
            background: transparent;

            Text {
                width: parent.width;
                height: parent.height;
                text: root.count;
                color: #b0c0d4;
                font-family: "monospace";
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
    }
}


component DetailRow inherits Rectangle {
    in property <string> name;
    in property <int> count;
    in property <string> share_text;

    height: 24px;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;

        Text {
            text: root.name;
            color: #6f829b;
            font-size: 9px;
            vertical-alignment: center;
            min-width: 110px;
            horizontal-stretch: 1;
        }

        Text {
            text: root.count;
            color: #a7b7ca;
            font-family: "monospace";
            font-size: 9px;
            font-weight: 600;
            vertical-alignment: center;
            min-width: 58px;
            horizontal-alignment: right;
        }

        Text {
            text: root.share_text;
            color: #516983;
            font-family: "monospace";
            font-size: 9px;
            vertical-alignment: center;
            min-width: 44px;
            horizontal-alignment: right;
        }
    }
}


export component AnalysisPanel inherits Rectangle {
    in property <MidiLoadState> midi-state: no-midi;
    in property <string> selected-midi-name: "";
    in property <string> loading-status: "Loading…";
    in property <float> loading-progress: 0;
    in property <string> load-error: "";

    callback select-file;
    callback load-midi;
    callback cancel-load;
    callback unload-midi;
    callback retry-load;

    in property <string> note-count-text: "—";
    in property <string> track-count-text: "—";
    in property <string> midi-length-text: "—";
    in property <string> tempo-text: "—";
    in property <string> time-signature-text: "—";
    in property <string> key-range-text: "—";
    in property <string> avg-velocity-text: "—";
    in property <string> median-velocity-text: "—";
    in property <string> p90-velocity-text: "—";
    in property <string> low-velocity-share-text: "—";
    in property <string> high-velocity-share-text: "—";
    in property <string> note-density-text: "—";
    in property <string> note-traffic-count-text: "—";
    in property <string> note-traffic-share-text: "—";
    in property <float> note-traffic-fraction: 0;
    in property <string> other-events-count-text: "—";
    in property <string> other-events-share-text: "—";
    in property <float> other-events-fraction: 0;
    in property <string> top-non-note-family-text: "—";
    in property <string> top-non-note-share-text: "—";
    in property <float> top-non-note-fraction: 0;
    in property <string> event-release-style-text: "—";
    in property <string> event-release-detail-text: "—";
    in property <string> event-routing-style-text: "—";
    in property <string> event-routing-detail-text: "—";
    in property <string> event-expression-style-text: "—";
    in property <string> event-expression-detail-text: "—";
    in property <string> event-metadata-style-text: "—";
    in property <string> event-metadata-detail-text: "—";

    in property <string> file-size-text: "—";
    in property <string> gzip-size-text: "—";
    in property <string> gzip-ratio-text: "—";
    in property <string> format-text: "—";
    in property <string> declared-tracks-text: "—";
    in property <string> actual-tracks-text: "—";
    in property <string> ticks-per-quarter-text: "—";
    in property <string> total-events-text: "—";

    in property <string> initial-bpm-text: "—";
    in property <string> min-bpm-text: "—";
    in property <string> max-bpm-text: "—";
    in property <string> avg-bpm-text: "—";

    in property <string> avg-note-length-text: "—";
    in property <string> min-note-length-text: "—";
    in property <string> max-note-length-text: "—";
    in property <string> total-note-duration-text: "—";
    in property <string> max-polyphony-text: "—";
    in property <string> avg-polyphony-text: "—";
    in property <string> peak-nps-text: "—";
    in property <string> avg-nps-text: "—";
    in property <string> unique-onsets-text: "—";
    in property <string> avg-notes-per-onset-text: "—";

    in property <string> total-blocks-text: "—";
    in property <string> keys-with-notes-text: "—";
    in property <string> densest-key-text: "—";
    in property <string> densest-key-notes-text: "—";
    in property <string> max-blocks-per-key-text: "—";
    in property <string> max-notes-in-block-text: "—";

    in property <[BarValue]> key-histogram: [];
    in property <[BarValue]> velocity-histogram: [];
    in property <[BarValue]> pitch-class-histogram: [];
    in property <[BarValue]> channel-histogram: [];
    in property <[BarValue]> track-histogram: [];
    in property <[BarValue]> density-timeline: [];

    in property <[EventCount]> event-composition: [];
    in property <[EventCount]> event-breakdown: [];
    in property <[EventCount]> event-breakdown-left: [];
    in property <[EventCount]> event-breakdown-right: [];
    in property <string> event-total-text: "—";

    clip: true;

    Flickable {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            width: parent.width;
            padding: 20px;
            padding-right: 24px;
            spacing: 16px;
            alignment: start;

            MidiStateSection {
                midi-state: root.midi-state;
                file-name: root.selected-midi-name;
                load-description: "Parses MIDI for structural analysis and derives the summary views used below.";
                load-label: "Load for Analysis";
                mode-label: "analysis";
                show-unload: false;
                loading-status: root.loading-status;
                loading-progress: root.loading-progress;
                error-message: root.load-error;
                select-file => { root.select-file(); }
                load => { root.load-midi(); }
                cancel-load => { root.cancel-load(); }
                unload => { root.unload-midi(); }
                retry-load => { root.retry-load(); }
            }

            if root.midi-state == MidiLoadState.loaded : HorizontalLayout {
                spacing: 12px;

                SurfaceCard {
                    title: "FILE OVERVIEW";
                    subtitle: "Fast read of the loaded MIDI before the deeper distributions.";
                    horizontal-stretch: 3;
                    min-width: 480px;

                    Text {
                        text: root.selected-midi-name;
                        color: #dbe6f4;
                        font-size: 18px;
                        font-weight: 700;
                        overflow: elide;
                    }

                    Text {
                        text: root.note-density-text + " / " + root.tempo-text;
                        color: #7d8fa8;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        HeroMetric { value: root.midi-length-text; label: "DURATION"; }
                        HeroMetric { value: root.key-range-text; label: "KEY RANGE"; }
                        HeroMetric { value: root.peak-nps-text + "/s"; label: "PEAK RATE"; }
                    }

                    Rectangle { height: 1px; background: #111a28; }

                    HorizontalLayout {
                        spacing: 16px;
                        FooterMetric { label: "TRACK COUNT"; value: root.track-count-text; }
                        FooterMetric { label: "PEAK POLYPHONY"; value: root.max-polyphony-text; }
                        FooterMetric { label: "EVENT COUNT"; value: root.total-events-text; }
                    }
                }

                VerticalLayout {
                    spacing: 12px;
                    horizontal-stretch: 2;
                    min-width: 360px;

                    HorizontalLayout {
                        spacing: 12px;
                        SummaryStat { value: root.note-count-text; label: "TOTAL NOTES"; accent: #60a5fa; }
                        SummaryStat { value: root.track-count-text; label: "TRACK COUNT"; accent: #a78bfa; }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        SummaryStat { value: root.max-polyphony-text; label: "PEAK POLYPHONY"; accent: #e879f9; }
                        SummaryStat { value: root.avg-bpm-text; label: "AVG TEMPO"; accent: #f87171; }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        SummaryStat { value: root.total-events-text; label: "EVENT COUNT"; accent: #38bdf8; }
                        SummaryStat { value: root.avg-velocity-text; label: "AVG VELOCITY"; accent: #34d399; }
                    }
                }
            }

            if root.midi-state == MidiLoadState.loaded : HorizontalLayout {
                spacing: 12px;

                Rectangle {
                    horizontal-stretch: 2;
                    min-width: 660px;

                    SurfaceCard {
                        width: parent.width;
                        height: parent.height;
                        title: "NOTE REGISTER";
                        subtitle: "Distribution across MIDI key numbers. This stays large because the range shape remains readable even in dense files.";

                        BarChart {
                            model: root.key-histogram;
                            bar-color: #2563eb;
                            bar-color-hover: #60a5fa;
                            chart-height: 152;
                        }

                        HorizontalLayout {
                            spacing: 14px;

                            FooterMetric { label: "RANGE"; value: root.key-range-text; }
                            FooterMetric { label: "MOST ACTIVE KEY"; value: root.densest-key-text + " (" + root.densest-key-notes-text + " notes)"; }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 320px;

                    SurfaceCard {
                        width: parent.width;
                        height: parent.height;
                        title: "PITCH-CLASS PROFILE";
                        subtitle: "Compact pitch-class balance so tonal bias reads as support data instead of another full-width report band.";

                        BarChart {
                            model: root.pitch-class-histogram;
                            bar-color: #7c3aed;
                            bar-color-hover: #a78bfa;
                            chart-height: 104;
                            show-labels: true;
                        }

                        FieldRow { label: "Tempo Context"; value: root.tempo-text; }
                        FieldRow { label: "Mean Velocity"; value: root.avg-velocity-text; }
                    }
                }
            }

            if root.midi-state == MidiLoadState.loaded : HorizontalLayout {
                spacing: 12px;

                Rectangle {
                    horizontal-stretch: 2;
                    min-width: 660px;

                    SurfaceCard {
                        width: parent.width;
                        height: parent.height;
                        title: "ONSET ACTIVITY";
                        subtitle: "Bucketed note starts across the file. This stays wide because it is one of the clearest views of where the arrangement thickens or thins.";

                        DensityTimeline {
                            model: root.density-timeline;
                            fill-color: #2563eb40;
                            peak-color: #60a5fa;
                            chart-height: 126;
                        }

                        HorizontalLayout {
                            spacing: 16px;
                            MiniStat { value: root.peak-nps-text + "/s"; label: "PEAK RATE"; }
                            MiniStat { value: root.avg-nps-text + "/s"; label: "AVG RATE"; }
                            MiniStat { value: root.unique-onsets-text; label: "ONSET COUNT"; }
                            MiniStat { value: root.avg-notes-per-onset-text; label: "NOTES / ONSET"; }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 320px;

                    SurfaceCard {
                        width: parent.width;
                        height: parent.height;
                        title: "TEMPO SUMMARY";
                        subtitle: "Tempo sits beside onset activity so pulse and density read together.";

                        Text {
                            text: root.tempo-text;
                            color: #e5eef9;
                            font-family: "monospace";
                            font-size: 18px;
                            font-weight: 800;
                            overflow: elide;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            MiniStat { value: root.initial-bpm-text; label: "START"; }
                            MiniStat { value: root.avg-bpm-text; label: "AVG"; }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            MiniStat { value: root.min-bpm-text; label: "MIN"; }
                            MiniStat { value: root.max-bpm-text; label: "MAX"; }
                        }

                        FieldRow { label: "Meter"; value: root.time-signature-text; }
                    }
                }
            }

            if root.midi-state == MidiLoadState.loaded : HorizontalLayout {
                spacing: 12px;

                SurfaceCard {
                    title: "VELOCITY PROFILE";
                    subtitle: "Re-bucketed into 16-step bands with percentile summaries so low-velocity spikes do not flatten the rest of the shape.";
                    horizontal-stretch: 3;
                    min-width: 320px;

                    BarChart {
                        model: root.velocity-histogram;
                        bar-color: #059669;
                        bar-color-hover: #34d399;
                        chart-height: 128;
                        show-labels: true;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        MiniStat { value: root.median-velocity-text; label: "MEDIAN"; }
                        MiniStat { value: root.p90-velocity-text; label: "P90"; }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        MiniStat { value: root.low-velocity-share-text; label: "LOW <=32"; }
                        MiniStat { value: root.high-velocity-share-text; label: "HIGH >=96"; }
                    }
                }

                VerticalLayout {
                    spacing: 12px;
                    horizontal-stretch: 2;
                    min-width: 420px;

                    SurfaceCard {
                        title: "NOTE DURATIONS";
                        subtitle: "Compact duration statistics are more useful here than another histogram.";

                        HorizontalLayout {
                            spacing: 8px;
                            MiniStat { value: root.avg-note-length-text; label: "AVG"; }
                            MiniStat { value: root.min-note-length-text; label: "SHORTEST"; }
                            MiniStat { value: root.max-note-length-text; label: "LONGEST"; }
                        }

                        FieldRow { label: "Total Held Time"; value: root.total-note-duration-text; }
                    }

                    SurfaceCard {
                        title: "POLYPHONY";
                        subtitle: "Simultaneity remains one of the clearest differentiators in dense files.";

                        HorizontalLayout {
                            spacing: 8px;
                            MiniStat { value: root.max-polyphony-text; label: "PEAK"; }
                            MiniStat { value: root.avg-polyphony-text; label: "AVG"; }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            MiniStat { value: root.unique-onsets-text; label: "ONSET COUNT"; }
                            MiniStat { value: root.avg-notes-per-onset-text; label: "NOTES / ONSET"; }
                        }
                    }
                }
            }

            if root.midi-state == MidiLoadState.loaded : SurfaceCard {
                title: "TRACK & CHANNEL LAYOUT";
                subtitle: "Track and channel note counts are grouped here as source structure and routing context, not promoted as hero charts.";

                SectionHeader { title: "TRACK ACTIVITY"; }
                BarChart {
                    model: root.track-histogram;
                    bar-color: #0891b2;
                    bar-color-hover: #22d3ee;
                    chart-height: 78;
                    show-labels: true;
                }

                Rectangle { height: 2px; }
                SectionHeader { title: "CHANNEL ACTIVITY"; }
                BarChart {
                    model: root.channel-histogram;
                    bar-color: #dc2626;
                    bar-color-hover: #f87171;
                    chart-height: 78;
                    show-labels: true;
                }
            }

            if root.midi-state == MidiLoadState.loaded : HorizontalLayout {
                spacing: 12px;

                VerticalLayout {
                    spacing: 12px;
                    horizontal-stretch: 2;

                    SurfaceCard {
                        title: "NON-NOTE EVENT FAMILIES";
                        subtitle: "Note traffic is called out separately. The bars below compare only the remaining event families, normalized within that group.";

                        for ev in root.event-composition : ShareRow {
                            name: ev.name;
                            count: ev.count;
                            fraction: ev.fraction;
                            share_text: ev.share_text;
                            accent: ev.name == "Controllers" ? #22c55e
                                : ev.name == "Expressive" ? #f97316
                                : ev.name == "Meta text" ? #a78bfa
                                : ev.name == "Tempo/signature" ? #fbbf24
                                : #06b6d4;
                        }
                    }

                    SurfaceCard {
                        title: "EVENT TYPE COUNTS";
                        subtitle: "Raw event counts compressed into a denser two-column table.";

                        HorizontalLayout {
                            spacing: 18px;

                            VerticalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;

                                for ev in root.event-breakdown-left : DetailRow {
                                    name: ev.name;
                                    count: ev.count;
                                    share_text: ev.share_text;
                                }
                            }

                            VerticalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;

                                for ev in root.event-breakdown-right : DetailRow {
                                    name: ev.name;
                                    count: ev.count;
                                    share_text: ev.share_text;
                                }
                            }
                        }
                    }
                }

                SurfaceCard {
                    title: "EVENT READS";
                    subtitle: "Quick interpretations of release handling, routing, expression, and score metadata.";
                    horizontal-stretch: 1;
                    min-width: 320px;

                    HorizontalLayout {
                        spacing: 8px;
                        
                        VerticalLayout {
                            spacing: 8px;
                            horizontal-stretch: 1;

                            MiniStat { value: root.event-total-text; label: "TOTAL EVENTS"; }
                            MiniStat { value: root.note-traffic-count-text; label: "NOTE EVENTS"; }
                            MiniStat { value: root.other-events-share-text; label: "NON-NOTE SHARE"; }

                            InsightTile {
                                title: "NOTE RELEASES";
                                value: root.event-release-style-text;
                                detail: root.event-release-detail-text;
                            }

                            InsightTile {
                                title: "EXPRESSION DATA";
                                value: root.event-expression-style-text;
                                detail: root.event-expression-detail-text;
                            }
                        }

                        VerticalLayout {
                            spacing: 8px;
                            horizontal-stretch: 1;

                            MiniStat { value: root.note-traffic-share-text; label: "NOTE SHARE"; }
                            MiniStat { value: root.other-events-count-text; label: "NON-NOTE EVENTS"; }
                            MiniStat { value: root.top-non-note-family-text; label: "LEADING FAMILY"; }

                            InsightTile {
                                title: "ROUTING & PATCHES";
                                value: root.event-routing-style-text;
                                detail: root.event-routing-detail-text;
                            }

                            InsightTile {
                                title: "SCORE METADATA";
                                value: root.event-metadata-style-text;
                                detail: root.event-metadata-detail-text;
                            }
                        }
                    }
                }
            }

            if root.midi-state == MidiLoadState.loaded : HorizontalLayout {
                spacing: 12px;

                SurfaceCard {
                    title: "FILE METADATA";
                    subtitle: "Technical file details kept visible, but secondary.";
                    min-width: 340px;

                    HorizontalLayout {
                        spacing: 8px;
                        MiniStat { value: root.file-size-text; label: "FILE SIZE"; }
                        MiniStat { value: root.gzip-size-text; label: "GZIP SIZE"; }
                        MiniStat { value: root.gzip-ratio-text; label: "GZIP RATIO"; }
                    }

                    FieldRow { label: "MIDI Format"; value: root.format-text; }
                    FieldRow { label: "Declared Tracks"; value: root.declared-tracks-text; }
                    FieldRow { label: "Actual Tracks"; value: root.actual-tracks-text; }
                    FieldRow { label: "Ticks / Quarter"; value: root.ticks-per-quarter-text; }
                }

                SurfaceCard {
                    title: "GRID SUMMARY";
                    subtitle: "Internal block-grid stats kept as an appendix rather than part of the main musical read.";
                    min-width: 340px;

                    HorizontalLayout {
                        spacing: 8px;
                        MiniStat { value: root.total-blocks-text; label: "TOTAL BLOCKS"; }
                        MiniStat { value: root.keys-with-notes-text; label: "KEYS WITH NOTES"; }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        MiniStat { value: root.max-blocks-per-key-text; label: "MAX BLOCKS / KEY"; }
                        MiniStat { value: root.max-notes-in-block-text; label: "MAX NOTES / BLOCK"; }
                    }

                    FieldRow { label: "Most Active Key"; value: root.densest-key-text + " (" + root.densest-key-notes-text + " notes)"; }
                }
            }

            if root.midi-state != MidiLoadState.loaded : SurfaceCard {
                title: "ANALYSIS PENDING";
                subtitle: "The full report stays collapsed until the analysis payload is ready, so the page does not present a wall of empty charts while work is still in progress.";

                Text {
                    text: root.midi-state == MidiLoadState.loading
                        ? "Analysis is still loading. The summary zones will appear when the processed MIDI payload is ready."
                        : root.midi-state == MidiLoadState.selected
                            ? "A MIDI is selected but not yet loaded for analysis."
                            : root.midi-state == MidiLoadState.error
                                ? "Analysis failed to load. Retry from the loader above to regenerate the report."
                                : "Choose a MIDI above to populate the analysis dashboard.";
                    color: #7d8fa8;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }

            Rectangle { height: 28px; }
        }
    }
}

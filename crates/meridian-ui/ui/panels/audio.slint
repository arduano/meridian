// ═══════════════════════════════════════════════════════════
//  Audio panel (profile 2).
//
//  Live realtime synth configuration. Tune playback parameters
//  on the fly — sample rate, soundfont, voice shaping, engine
//  threading, envelope curves.
//
//  WAV export is out of scope for this page.
// ═══════════════════════════════════════════════════════════

import { MidiLoadState } from "../structs.slint";
import {
    SectionHeader, Separator, FieldRow, OptionChip,
    InlineOptionRow, InlineCustomRow, FilePicker, StatusBadge
} from "../primitives.slint";
import { MidiStateSection } from "../midi_loading.slint";

export component AudioPanel inherits Rectangle {
    // ── MIDI state bindings ──
    in property <MidiLoadState> midi-state: no-midi;
    in property <string> selected-midi-name: "";
    in property <string> loading-status: "Loading…";
    in property <float> loading-progress: 0;
    in property <string> load-error: "";

    // ── MIDI state callbacks ──
    callback select-file;
    callback load-midi;
    callback cancel-load;
    callback unload-midi;
    callback retry-load;

    // ── Audio config bindings ──
    in property <string> audio-backend-text: "xsynth";
    in property <string> audio-engine-status-text: "Idle";
    in property <string> audio-output-stream-text: "2 ch @ 48000 Hz";
    in property <bool> audio-supports-44100: true;
    in property <bool> audio-supports-48000: true;
    in property <bool> audio-supports-88200: false;
    in property <bool> audio-supports-96000: false;
    in property <bool> audio-supports-176400: false;
    in property <bool> audio-supports-192000: false;
    in property <bool> audio-supports-mono: false;
    in property <bool> audio-supports-stereo: true;
    in property <string> audio-sample-rate-text: "48000";
    in property <string> audio-channel-count-text: "stereo";
    in property <string> audio-render-window-text: "10.0 ms";
    in property <string> soundfont-text: "(default)";
    in property <string> soundfont-count-text: "1 loaded";
    in property <bool> audio-soundfont-enabled: true;
    in property <string> audio-engine-detail-text: "Effects on / limiter off";
    in property <string> audio-effects-text: "on";
    in property <string> audio-interpolation-text: "nearest";
    in property <string> audio-voice-count-text: "—";
    in property <string> audio-layer-limit-text: "4 max";
    in property <string> audio-limiter-text: "on";
    in property <string> audio-threading-text: "auto";
    in property <string> audio-ignore-range-text: "8";
    in property <string> audio-attack-curve-text: "exponential";
    in property <string> audio-decay-curve-text: "linear";
    in property <string> audio-release-curve-text: "linear";
    in property <string> audio-parallelism-text: "Auto / Auto";

    // ── Callbacks ──
    callback select-sample-rate(string);
    callback select-channel-count(string);
    callback select-render-window(string);
    callback select-soundfont;
    callback reset-soundfont;
    callback toggle-soundfont-enabled;
    callback select-interpolation(string);
    callback select-effects(string);
    callback select-layer-limit(string);
    callback select-limiter(string);
    callback select-threading(string);
    callback select-ignore-range(string);
    callback select-attack-curve(string);
    callback select-decay-curve(string);
    callback select-release-curve(string);

    // ── Local state for custom rows ──
    // (InlineCustomRow manages its own editing state internally;
    //  we only need the is-preset derivations here.)
    private property <bool> layer-is-preset:
        root.audio-layer-limit-text == "4" || root.audio-layer-limit-text == "8"
        || root.audio-layer-limit-text == "16" || root.audio-layer-limit-text == "off";

    private property <bool> vel-is-preset:
        root.audio-ignore-range-text == "off" || root.audio-ignore-range-text == "8"
        || root.audio-ignore-range-text == "16";

    private property <bool> rw-is-preset:
        root.audio-render-window-text == "5.0 ms" || root.audio-render-window-text == "10.0 ms"
        || root.audio-render-window-text == "20.0 ms";

    clip: true;

    Flickable {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            width: parent.width;
            padding: 20px;
            padding-right: 24px;
            spacing: 0px;
            alignment: start;

            // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            //  MIDI FILE
            // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            MidiStateSection {
                midi-state: root.midi-state;
                file-name: root.selected-midi-name;
                load-description: "Builds the audio cache only — no video pipeline. Use Preview for synced playback with visuals.";
                load-label: "Load for Audio";
                mode-label: "audio";
                loading-status: root.loading-status;
                loading-progress: root.loading-progress;
                error-message: root.load-error;
                select-file => { root.select-file(); }
                load => { root.load-midi(); }
                cancel-load => { root.cancel-load(); }
                unload => { root.unload-midi(); }
                retry-load => { root.retry-load(); }
            }

            Rectangle { height: 12px; }
            Separator { }
            Rectangle { height: 16px; }

            // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            //  ENGINE STATUS
            // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            HorizontalLayout {
                spacing: 8px;
                height: 26px;

                Text {
                    text: "Engine";
                    color: #4d6580;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 0.8px;
                    vertical-alignment: center;
                }

                StatusBadge {
                    label: root.audio-engine-status-text;
                    active: root.audio-engine-status-text == "Running";
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: root.audio-output-stream-text;
                    color: #4d6580;
                    font-family: "monospace";
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            Rectangle { height: 14px; }

            // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            //  STREAM FORMAT
            // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            SectionHeader { title: "STREAM FORMAT"; }
            Rectangle { height: 8px; }

            // Sample Rate
            InlineOptionRow {
                label: "Sample Rate";

                if root.audio-supports-44100 : OptionChip {
                    label: "44.1k";
                    active: root.audio-sample-rate-text == "44100";
                    pressed => { root.select-sample-rate("44100"); }
                }
                if root.audio-supports-48000 : OptionChip {
                    label: "48k";
                    active: root.audio-sample-rate-text == "48000";
                    pressed => { root.select-sample-rate("48000"); }
                }
                if root.audio-supports-88200 : OptionChip {
                    label: "88.2k";
                    active: root.audio-sample-rate-text == "88200";
                    pressed => { root.select-sample-rate("88200"); }
                }
                if root.audio-supports-96000 : OptionChip {
                    label: "96k";
                    active: root.audio-sample-rate-text == "96000";
                    pressed => { root.select-sample-rate("96000"); }
                }
                if root.audio-supports-176400 : OptionChip {
                    label: "176.4k";
                    active: root.audio-sample-rate-text == "176400";
                    pressed => { root.select-sample-rate("176400"); }
                }
                if root.audio-supports-192000 : OptionChip {
                    label: "192k";
                    active: root.audio-sample-rate-text == "192000";
                    pressed => { root.select-sample-rate("192000"); }
                }
            }

            Rectangle { height: 4px; }

            // Channels
            InlineOptionRow {
                label: "Channels";

                if root.audio-supports-mono : OptionChip {
                    label: "Mono";
                    active: root.audio-channel-count-text == "mono";
                    pressed => { root.select-channel-count("mono"); }
                }
                if root.audio-supports-stereo : OptionChip {
                    label: "Stereo";
                    active: root.audio-channel-count-text == "stereo";
                    pressed => { root.select-channel-count("stereo"); }
                }
            }

            Rectangle { height: 4px; }

            // Render Window (with custom input)
            InlineCustomRow {
                label: "Buffer";
                value: root.audio-render-window-text;
                is-preset: root.rw-is-preset;
                custom-submitted(val) => {
                    root.select-render-window(val);
                }

                OptionChip {
                    label: "5 ms";
                    active: root.audio-render-window-text == "5.0 ms";
                    pressed => { root.select-render-window("5"); }
                }
                OptionChip {
                    label: "10 ms";
                    active: root.audio-render-window-text == "10.0 ms";
                    pressed => { root.select-render-window("10"); }
                }
                OptionChip {
                    label: "20 ms";
                    active: root.audio-render-window-text == "20.0 ms";
                    pressed => { root.select-render-window("20"); }
                }
            }

            Rectangle { height: 16px; }
            Separator { }
            Rectangle { height: 16px; }

            // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            //  SOUNDFONT
            // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            SectionHeader { title: "SOUNDFONT"; }
            Rectangle { height: 8px; }

            FilePicker {
                file-name: root.soundfont-text;
                file-label: root.soundfont-count-text;
                enabled: root.audio-soundfont-enabled;
                browse => { root.select-soundfont(); }
                reset => { root.reset-soundfont(); }
                toggle-enabled => { root.toggle-soundfont-enabled(); }
            }

            Rectangle { height: 6px; }

            // Enable/disable toggle inline
            InlineOptionRow {
                label: "Status";

                OptionChip {
                    label: "Enabled";
                    active: root.audio-soundfont-enabled;
                    pressed => { if (!root.audio-soundfont-enabled) { root.toggle-soundfont-enabled(); } }
                }
                OptionChip {
                    label: "Disabled";
                    active: !root.audio-soundfont-enabled;
                    pressed => { if (root.audio-soundfont-enabled) { root.toggle-soundfont-enabled(); } }
                }
            }

            Rectangle { height: 16px; }
            Separator { }
            Rectangle { height: 16px; }

            // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            //  VOICE SHAPING
            // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            SectionHeader { title: "VOICE SHAPING"; }
            Rectangle { height: 8px; }

            // Interpolation
            InlineOptionRow {
                label: "Interpolation";

                OptionChip {
                    label: "Nearest";
                    active: root.audio-interpolation-text == "nearest";
                    pressed => { root.select-interpolation("nearest"); }
                }
                OptionChip {
                    label: "Linear";
                    active: root.audio-interpolation-text == "linear";
                    pressed => { root.select-interpolation("linear"); }
                }
            }

            Rectangle { height: 4px; }

            // Effects
            InlineOptionRow {
                label: "Effects";

                OptionChip {
                    label: "Off";
                    active: root.audio-effects-text == "off";
                    pressed => { root.select-effects("off"); }
                }
                OptionChip {
                    label: "On";
                    active: root.audio-effects-text == "on";
                    pressed => { root.select-effects("on"); }
                }
            }

            Rectangle { height: 4px; }

            // Limiter
            InlineOptionRow {
                label: "Limiter";

                OptionChip {
                    label: "Off";
                    active: root.audio-limiter-text == "off";
                    pressed => { root.select-limiter("off"); }
                }
                OptionChip {
                    label: "On";
                    active: root.audio-limiter-text == "on";
                    pressed => { root.select-limiter("on"); }
                }
            }

            Rectangle { height: 16px; }
            Separator { }
            Rectangle { height: 16px; }

            // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            //  PLAYBACK ENGINE
            // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            SectionHeader { title: "PLAYBACK ENGINE"; }
            Rectangle { height: 4px; }

            FieldRow { label: "Active Voices"; value: root.audio-voice-count-text; }

            Rectangle { height: 6px; }

            // Layer Limit (with custom input)
            InlineCustomRow {
                label: "Layer Limit";
                value: root.audio-layer-limit-text;
                is-preset: root.layer-is-preset;
                custom-submitted(val) => {
                    root.select-layer-limit(val);
                }

                OptionChip {
                    label: "4";
                    active: root.audio-layer-limit-text == "4";
                    pressed => { root.select-layer-limit("4"); }
                }
                OptionChip {
                    label: "8";
                    active: root.audio-layer-limit-text == "8";
                    pressed => { root.select-layer-limit("8"); }
                }
                OptionChip {
                    label: "16";
                    active: root.audio-layer-limit-text == "16";
                    pressed => { root.select-layer-limit("16"); }
                }
                OptionChip {
                    label: "Off";
                    active: root.audio-layer-limit-text == "off";
                    pressed => { root.select-layer-limit("off"); }
                }
            }

            Rectangle { height: 4px; }

            // Threading
            InlineOptionRow {
                label: "Threading";

                OptionChip {
                    label: "Single";
                    active: root.audio-threading-text == "none";
                    pressed => { root.select-threading("none"); }
                }
                OptionChip {
                    label: "Auto";
                    active: root.audio-threading-text == "auto";
                    pressed => { root.select-threading("auto"); }
                }
                OptionChip {
                    label: "4 Threads";
                    active: root.audio-threading-text == "4";
                    pressed => { root.select-threading("4"); }
                }
            }

            Rectangle { height: 16px; }
            Separator { }
            Rectangle { height: 16px; }

            // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            //  ADVANCED
            // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            SectionHeader { title: "ADVANCED"; }
            Rectangle { height: 8px; }

            // Velocity Gate (with custom input)
            InlineCustomRow {
                label: "Keep Velocity";
                value: root.audio-ignore-range-text;
                is-preset: root.vel-is-preset;
                custom-display: root.audio-ignore-range-text == "off" ? "All" : root.audio-ignore-range-text + "+";
                custom-submitted(val) => {
                    root.select-ignore-range(val);
                }

                OptionChip {
                    label: "All";
                    active: root.audio-ignore-range-text == "off";
                    pressed => { root.select-ignore-range("off"); }
                }
                OptionChip {
                    label: "8+";
                    active: root.audio-ignore-range-text == "8";
                    pressed => { root.select-ignore-range("8"); }
                }
                OptionChip {
                    label: "16+";
                    active: root.audio-ignore-range-text == "16";
                    pressed => { root.select-ignore-range("16"); }
                }
            }

            Rectangle { height: 10px; }

            // ── Envelope Curves ──
            Text {
                text: "ENVELOPE CURVES";
                color: #3d5068;
                font-size: 9px;
                font-weight: 700;
                letter-spacing: 0.8px;
            }

            Rectangle { height: 6px; }

            // Attack
            InlineOptionRow {
                label: "Attack";

                OptionChip {
                    label: "Linear";
                    active: root.audio-attack-curve-text == "linear";
                    pressed => { root.select-attack-curve("linear"); }
                }
                OptionChip {
                    label: "Exponential";
                    active: root.audio-attack-curve-text == "exponential";
                    pressed => { root.select-attack-curve("exponential"); }
                }
            }

            Rectangle { height: 4px; }

            // Decay
            InlineOptionRow {
                label: "Decay";

                OptionChip {
                    label: "Linear";
                    active: root.audio-decay-curve-text == "linear";
                    pressed => { root.select-decay-curve("linear"); }
                }
                OptionChip {
                    label: "Exponential";
                    active: root.audio-decay-curve-text == "exponential";
                    pressed => { root.select-decay-curve("exponential"); }
                }
            }

            Rectangle { height: 4px; }

            // Release
            InlineOptionRow {
                label: "Release";

                OptionChip {
                    label: "Linear";
                    active: root.audio-release-curve-text == "linear";
                    pressed => { root.select-release-curve("linear"); }
                }
                OptionChip {
                    label: "Exponential";
                    active: root.audio-release-curve-text == "exponential";
                    pressed => { root.select-release-curve("exponential"); }
                }
            }

            Rectangle { height: 24px; }
        }
    }
}

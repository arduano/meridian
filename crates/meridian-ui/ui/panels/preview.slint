// ═══════════════════════════════════════════════════════════
//  Preview Welcome — hero UX for opening a MIDI file.
//
//  Shown on the Preview tab when no MIDI is loaded. Features
//  a large centered drop zone with a browse button. This is
//  the fanciest and most welcoming entry point.
// ═══════════════════════════════════════════════════════════

import { MidiLoadState } from "../structs.slint";
import { MidiLoadingBar, MidiLoadedBar, MidiErrorBar } from "../midi_loading.slint";
import { Theme } from "../theme.slint";

export component PreviewWelcome inherits Rectangle {
    in property <MidiLoadState> midi-state: no-midi;
    in property <string> selected-midi-name: "";
    in property <string> loading-status: "Loading…";
    in property <float> loading-progress: 0;
    in property <string> load-error: "";
    in property <bool> drop-hovering: false;

    callback select-file;
    callback load-midi;
    callback cancel-load;
    callback unload-midi;
    callback retry-load;

    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 0px;

        // Centered card
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 420px;
                border-radius: 16px;
                background: Theme.surface-card;
                border-width: root.drop-hovering ? 2px : 1px;
                border-color: root.drop-hovering ? Theme.accent-fill : Theme.surface-control;

                drop-shadow-blur: root.drop-hovering ? 40px : 0px;
                drop-shadow-color: root.drop-hovering ? Theme.accent-glow : transparent;

                VerticalLayout {
                    padding: 40px;
                    padding-top: 48px;
                    padding-bottom: 40px;
                    spacing: 0px;
                    alignment: center;

                    // ── Icon ──
                    HorizontalLayout {
                        alignment: center;
                        Image {
                            width: root.drop-hovering ? 72px : 64px;
                            height: root.drop-hovering ? 72px : 64px;
                            source: @image-url("../../../../assets/icons/meridian.png");
                            image-fit: contain;
                            opacity: root.drop-hovering ? 1 : 0.9;

                            animate width { duration: 150ms; }
                            animate height { duration: 150ms; }
                            animate opacity { duration: 150ms; }
                        }
                    }

                    Rectangle { height: 20px; }

                    // ── Title ──
                    Text {
                        text: root.drop-hovering ? "Drop to open" : "Open a MIDI file";
                        color: root.drop-hovering ? rgb(96, 165, 250) : Theme.text-primary;
                        font-size: Theme.font-size-display-md;
                        font-weight: 700;
                        horizontal-alignment: center;

                        animate color { duration: 150ms; }
                    }

                    Rectangle { height: 8px; }

                    // ── Subtitle ──
                    Text {
                        text: root.drop-hovering
                            ? "Release to load this file"
                            : "Drag and drop a .mid file here, or browse to select one. Preview loads visuals and audio together, then starts playback.";
                        color: Theme.text-muted;
                        font-size: Theme.font-size-lg;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    Rectangle { height: 24px; }

                    // ── State-dependent content ──
                    if root.midi-state == MidiLoadState.no-midi || root.midi-state == MidiLoadState.selected : HorizontalLayout {
                        alignment: center;
                        // Browse button
                        Rectangle {
                            width: 160px;
                            height: 40px;
                            border-radius: 10px;
                            background: browse-touch.has-hover ? Theme.accent-fill-hover : Theme.accent-fill;

                            Text {
                                text: "Browse Files";
                                color: Theme.text-on-accent;
                                font-size: Theme.font-size-2xl;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            browse-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.select-file(); }
                            }
                        }
                    }

                    if root.midi-state == MidiLoadState.loading : MidiLoadingBar {
                        status: root.loading-status;
                        progress: root.loading-progress;
                        cancel => { root.cancel-load(); }
                    }

                    if root.midi-state == MidiLoadState.loaded : MidiLoadedBar {
                        file-name: root.selected-midi-name;
                        mode-label: "preview";
                        unload => { root.unload-midi(); }
                    }

                    if root.midi-state == MidiLoadState.error : MidiErrorBar {
                        error-message: root.load-error;
                        retry => { root.retry-load(); }
                    }

                    // ── Selected file hint (when in selected state) ──
                    if root.midi-state == MidiLoadState.selected : VerticalLayout {
                        spacing: 0px;
                        alignment: center;

                        Rectangle { height: 16px; }

                        Text {
                            text: "Preview loads display + audio together and jumps straight into playback.";
                            color: Theme.text-muted;
                            font-size: Theme.font-size-md;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        Rectangle { height: 12px; }

                        Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            background: Theme.surface-card-raised;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;

                                Text {
                                    text: "♪";
                                    color: Theme.accent-fill;
                                    font-size: Theme.font-size-lg;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: root.selected-midi-name;
                                    color: Theme.text-soft;
                                    font-size: Theme.font-size-lg;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }

                                VerticalLayout {
                                    spacing: 0px;
                                    alignment: center;

                                    // Quick load hint
                                    Rectangle {
                                        width: 40px;
                                        height: 22px;
                                        border-radius: 5px;
                                        background: load-touch.has-hover ? Theme.accent-fill-hover : Theme.accent-fill;

                                        Text {
                                            text: "Load";
                                            color: Theme.text-on-accent;
                                            font-size: Theme.font-size-sm;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        load-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.load-midi(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}


// ── DropOverlay ────────────────────────────────────────────
// Full-window overlay shown when a file is being dragged over
// the application. Semi-transparent with pulsing border.
// Place as the last child of the root layout so it's on top.

export component DropOverlay inherits Rectangle {
    in property <bool> visible-when: false;

    visible: root.visible-when;
    background: Theme.overlay-background;

    // Border glow
    Rectangle {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: parent.height - 12px;
        border-radius: 12px;
        border-width: 2px;
        border-color: Theme.accent-fill;
        background: transparent;
    }

    // Center content
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;

            VerticalLayout {
                spacing: 12px;
                alignment: center;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: 28px;
                        background: Theme.surface-badge;

                        Text {
                            text: "♪";
                            color: rgb(96, 165, 250);
                            font-size: 26px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: "Drop MIDI file to open";
                    color: rgb(96, 165, 250);
                    font-size: Theme.font-size-display-sm;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Release to load this file into Meridian";
                    color: Theme.text-muted;
                    font-size: Theme.font-size-lg;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

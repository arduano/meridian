// ═══════════════════════════════════════════════════════════
//  Render panel (profile 1).
//
//  Video output configuration, scene overrides, codec, render
//  action + progress. Includes full MIDI loading lifecycle.
//
//  The render tab loads MIDI for *video rendering* (display +
//  audio caches, display session). If the user switches here
//  with a selected but not-yet-loaded file, a load prompt is
//  shown.
// ═══════════════════════════════════════════════════════════

import { MidiLoadState } from "../structs.slint";
import { SectionHeader, Separator, FieldRow, ToggleButton, PrimaryButton, ProgressBar } from "../primitives.slint";
import { MidiStateSection } from "../midi_loading.slint";

export component RenderPanel inherits Rectangle {
    // ── MIDI state bindings ──
    in property <MidiLoadState> midi-state: no-midi;
    in property <string> selected-midi-name: "";
    in property <string> loading-status: "Loading…";
    in property <float> loading-progress: 0;
    in property <string> load-error: "";

    // ── MIDI state callbacks ──
    callback select-file;
    callback load-midi;
    callback cancel-load;
    callback unload-midi;
    callback retry-load;

    // ── Scene bindings (only relevant when loaded) ──
    in property <string> current-renderer-text;
    in property <string> time-space-text;
    in property <string> view-range-text;
    in property <string> scene-summary-text;

    // ── Render job bindings ──
    in property <float> render-progress: 0;
    in property <string> render-status: "Idle";
    in property <string> render-frames: "—";
    in property <string> render-avg-fps: "—";
    in property <string> render-elapsed: "—";

    // ── Callbacks forwarded up to App ──
    callback select-renderer(string);
    callback select-time-space(string);
    callback start-render;
    callback cancel-render;

    clip: true;

    Flickable {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            padding: 20px;
            padding-right: 24px;
            spacing: 6px;

            // ── MIDI FILE ──
            MidiStateSection {
                midi-state: root.midi-state;
                file-name: root.selected-midi-name;
                load-description: "Builds display + audio caches for video rendering.";
                load-label: "Load for Render";
                mode-label: "render";
                loading-status: root.loading-status;
                loading-progress: root.loading-progress;
                error-message: root.load-error;
                select-file => { root.select-file(); }
                load => { root.load-midi(); }
                cancel-load => { root.cancel-load(); }
                unload => { root.unload-midi(); }
                retry-load => { root.retry-load(); }
            }

            Rectangle { height: 8px; }
            Separator { }
            Rectangle { height: 8px; }

            // ── OUTPUT ── (only show when loaded)
            SectionHeader { title: "OUTPUT"; }
            Rectangle { height: 4px; }
            FieldRow { label: "Resolution";  value: "1920 × 1080"; }
            FieldRow { label: "Frame Rate";  value: "60 fps"; }
            FieldRow { label: "Output Path"; value: "output.mp4"; }

            Rectangle { height: 8px; }
            Separator { }
            Rectangle { height: 8px; }

            // ── SCENE ──
            SectionHeader { title: "SCENE"; }
            Rectangle { height: 4px; }
            HorizontalLayout {
                spacing: 4px;
                ToggleButton { label: "PFA";      active: root.current-renderer-text == "pfa";  pressed => { root.select-renderer("pfa"); } }
                ToggleButton { label: "Flat";     active: root.current-renderer-text == "flat"; pressed => { root.select-renderer("flat"); } }
                ToggleButton { label: "3D Trail"; active: root.current-renderer-text == "3d";   pressed => { root.select-renderer("3d"); } }
            }
            HorizontalLayout {
                spacing: 4px;
                ToggleButton { label: "Time"; active: root.time-space-text == "time"; pressed => { root.select-time-space("time"); } }
                ToggleButton { label: "Tick"; active: root.time-space-text == "tick"; pressed => { root.select-time-space("tick"); } }
            }
            FieldRow { label: "View Range"; value: root.view-range-text; }
            FieldRow { label: "Scene";      value: root.scene-summary-text; }

            Rectangle { height: 8px; }
            Separator { }
            Rectangle { height: 8px; }

            // ── CODEC ──
            SectionHeader { title: "CODEC"; }
            Rectangle { height: 4px; }
            FieldRow { label: "Container";   value: "MP4"; }
            FieldRow { label: "Video Codec"; value: "libx264"; }
            FieldRow { label: "Audio Codec"; value: "aac"; }
            FieldRow { label: "Extra Args";  value: "(none)"; }

            Rectangle { height: 8px; }
            Separator { }
            Rectangle { height: 12px; }

            // ── RENDER ACTION ──
            PrimaryButton {
                label: "Start Render";
                enabled: root.midi-state == MidiLoadState.loaded;
                pressed => { root.start-render(); }
            }

            Rectangle { height: 8px; }
            SectionHeader { title: "PROGRESS"; }
            Rectangle { height: 4px; }
            ProgressBar { progress: root.render-progress; }
            Rectangle { height: 4px; }
            FieldRow { label: "Status";   value: root.render-status; }
            FieldRow { label: "Frames";   value: root.render-frames; }
            FieldRow { label: "Avg. FPS"; value: root.render-avg-fps; }
            FieldRow { label: "Elapsed";  value: root.render-elapsed; }

            Rectangle { height: 20px; }
        }
    }
}

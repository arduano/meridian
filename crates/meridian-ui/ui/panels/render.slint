// ═══════════════════════════════════════════════════════════
//  Render panel (profile 2).
//
//  Export orchestration — a task-flow surface:
//   1. Choose render mode (video+audio / video only / audio only)
//   2. Set output destination
//   3. Verify stream settings
//   4. Start export
//
//  Status and progress appear inline when a render is active.
//  Project inputs are shown as reference at the bottom.
// ═══════════════════════════════════════════════════════════

import { MidiLoadState } from "../structs.slint";
import {
    SectionHeader, Separator, FieldRow, ToggleButton, OptionChip, InlineOptionRow,
    InlineCustomRow, ProgressBar, StatusBadge, PrimaryButton
} from "../primitives.slint";
import { Theme } from "../theme.slint";

export component RenderPanel inherits Rectangle {
    in property <string> selected-midi-name: "";
    in property <string> midi-length-text: "0.000 s";
    in property <string> scene-summary-text: "—";
    in property <MidiLoadState> render-load-state: no-midi;
    in property <MidiLoadState> audio-load-state: no-midi;

    in property <string> render-mode-text: "video_audio";
    in property <string> render-range-mode-text: "full_song";
    in property <string> render-start-time-text: "0.0";
    in property <string> render-end-time-text: "";
    in property <string> render-output-path-text: "";
    in property <string> render-video-resolution-text: "1920x1080";
    in property <string> render-video-fps-text: "60";
    in property <string> render-video-container-text: "mp4";
    in property <string> render-audio-format-text: "wav";
    in property <string> render-audio-sample-rate-text: "48000";
    in property <string> render-audio-channel-count-text: "stereo";
    in property <string> render-video-codec-text: "libx264";
    in property <string> render-video-crf-text: "18";
    in property <string> render-video-preset-text: "medium";
    in property <string> render-video-pix-fmt-text: "yuv420p";
    in property <string> render-video-rgb-mode-text: "premultiplied";
    in property <string> render-video-ffmpeg-args-text: "";
    in property <string> render-audio-bitrate-text: "192k";
    in property <string> render-audio-ffmpeg-args-text: "";
    in property <bool> render-export-alpha-mask: false;
    in property <bool> render-use-limiter: true;
    in property <bool> render-open-after-export: false;

    in property <bool> audio-supports-44100: true;
    in property <bool> audio-supports-48000: true;
    in property <bool> audio-supports-88200: false;
    in property <bool> audio-supports-96000: false;
    in property <bool> audio-supports-176400: false;
    in property <bool> audio-supports-192000: false;
    in property <bool> audio-supports-mono: false;
    in property <bool> audio-supports-stereo: true;

    in property <float> video-render-progress: 0;
    in property <string> video-render-status: "Idle";
    in property <string> video-render-elapsed: "—";
    in property <string> video-render-output-text: "output.mp4";

    in property <float> audio-render-progress: 0;
    in property <string> audio-render-status: "Idle";
    in property <string> audio-render-elapsed: "—";
    in property <string> audio-render-output-text: "output.wav";

    in property <float> export-progress: 0;
    in property <string> export-status: "Ready";
    in property <string> export-detail-text: "Choose a mode and output path.";

    callback select-mode(string);
    callback select-range-mode(string);
    callback browse-output;
    callback submit-custom-start-time(string);
    callback submit-custom-end-time(string);
    callback select-resolution(string);
    callback submit-custom-resolution(string);
    callback select-fps(string);
    callback select-video-container(string);
    callback submit-custom-fps(string);
    callback select-audio-format(string);
    callback select-audio-sample-rate(string);
    callback select-audio-channel-count(string);
    callback select-video-codec(string);
    callback select-video-crf(string);
    callback submit-custom-crf(string);
    callback select-video-preset(string);
    callback select-video-pix-fmt(string);
    callback select-video-rgb-mode(string);
    callback change-video-ffmpeg-args(string);
    callback select-audio-bitrate(string);
    callback submit-custom-audio-bitrate(string);
    callback change-audio-ffmpeg-args(string);
    callback toggle-export-alpha-mask;
    callback toggle-use-limiter;
    callback toggle-open-after-export;
    callback start-export;
    callback cancel-export;

    private property <bool> resolution-is-preset:
        root.render-video-resolution-text == "1280x720"
        || root.render-video-resolution-text == "1920x1080"
        || root.render-video-resolution-text == "2560x1440";
    private property <bool> fps-is-preset:
        root.render-video-fps-text == "30"
        || root.render-video-fps-text == "60"
        || root.render-video-fps-text == "120";
    private property <bool> encoding-open: false;
    private property <bool> crf-is-preset:
        root.render-video-crf-text == "0"
        || root.render-video-crf-text == "15"
        || root.render-video-crf-text == "18"
        || root.render-video-crf-text == "23"
        || root.render-video-crf-text == "28";
    private property <bool> bitrate-is-preset:
        root.render-audio-bitrate-text == "128k"
        || root.render-audio-bitrate-text == "192k"
        || root.render-audio-bitrate-text == "256k"
        || root.render-audio-bitrate-text == "320k";
    private property <bool> advanced-open: false;
    private property <bool> custom-range-enabled: root.render-range-mode-text == "custom";

    private property <bool> wants-video:
        root.render-mode-text == "video_audio" || root.render-mode-text == "video_only";
    private property <bool> wants-audio:
        root.render-mode-text == "video_audio" || root.render-mode-text == "audio_only";
    private property <bool> audio-only: root.render-mode-text == "audio_only";
    private property <bool> is-combined-mode: root.render-mode-text == "video_audio";
    private property <bool> video-ready: root.render-load-state == MidiLoadState.loaded;
    private property <bool> audio-ready: root.audio-load-state == MidiLoadState.loaded;
    private property <bool> has-midi: root.selected-midi-name != "";
    private property <bool> render-busy:
        root.export-status == "Preparing audio cache"
        || root.export-status == "Preparing export"
        || root.export-status == "Rendering video + audio"
        || root.export-status == "Rendering video"
        || root.export-status == "Rendering audio"
        || root.export-status == "Finalizing output"
        || root.video-render-status != "Idle"
        || root.audio-render-status != "Idle";
    private property <bool> export-succeeded: root.export-status == "Finished";
    private property <bool> export-failed: root.export-status == "Failed";
    private property <bool> export-cancelled: root.export-status == "Cancelled";
    private property <bool> has-export-result:
        root.export-succeeded || root.export-failed || root.export-cancelled;
    private property <string> audio-format-ext:
        root.render-audio-format-text == "flac" ? ".flac"
        : root.render-audio-format-text == "mp3" ? ".mp3"
        : ".wav";
    private property <string> video-container-ext:
        root.render-video-container-text == "mkv" ? ".mkv" : ".mp4";
    private property <string> video-container-label:
        root.render-video-container-text == "mkv" ? "MKV" : "MP4";
    private property <string> mode-summary:
        root.render-mode-text == "video_audio"
            ? "Renders video and audio into a single " + root.video-container-ext + " file."
            : root.render-mode-text == "video_only"
                ? "Renders a silent video as " + root.video-container-ext + " — no audio track."
                : "Exports audio as a " + root.audio-format-ext + " file — no video.";
    private property <string> start-label:
        root.render-mode-text == "video_audio"
            ? "Render Video + Audio"
            : root.render-mode-text == "video_only"
                ? "Render Video"
                : "Render Audio";
    private property <bool> single-mode-pass-active:
        !root.is-combined-mode
        && (root.audio-only ? root.audio-render-status != "Idle" : root.video-render-status != "Idle");
    private property <string> single-mode-pass-label: root.audio-only ? "Audio" : "Video";
    private property <string> single-mode-pass-status:
        root.audio-only ? root.audio-render-status : root.video-render-status;
    private property <string> single-mode-pass-elapsed:
        root.audio-only ? root.audio-render-elapsed : root.video-render-elapsed;

    clip: true;

    Flickable {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            width: parent.width;
            padding: 20px;
            padding-right: 24px;
            spacing: 0px;
            alignment: start;

            // ─────────────────────────────────────────
            //  1. RENDER MODE — the primary decision
            // ─────────────────────────────────────────
            SectionHeader { title: "RENDER MODE"; }
            Rectangle { height: 8px; }

            HorizontalLayout {
                spacing: 6px;

                ToggleButton {
                    label: "Video + Audio";
                    active: root.render-mode-text == "video_audio";
                    pressed => { root.select-mode("video_audio"); }
                }
                ToggleButton {
                    label: "Video Only";
                    active: root.render-mode-text == "video_only";
                    pressed => { root.select-mode("video_only"); }
                }
                ToggleButton {
                    label: "Audio Only";
                    active: root.render-mode-text == "audio_only";
                    pressed => { root.select-mode("audio_only"); }
                }
            }

            Rectangle { height: 6px; }
            Text {
                text: root.mode-summary;
                color: Theme.text-secondary;
                font-size: Theme.font-size-md;
                wrap: word-wrap;
            }

            Rectangle { height: 16px; }
            Separator { }
            Rectangle { height: 16px; }

            // ─────────────────────────────────────────
            //  2. OUTPUT DESTINATION
            // ─────────────────────────────────────────
            SectionHeader { title: "OUTPUT"; }
            Rectangle { height: 8px; }

            Rectangle {
                height: 58px;
                border-radius: 8px;
                background: Theme.surface-panel;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    spacing: 10px;

                    VerticalLayout {
                        spacing: 1px;
                        horizontal-stretch: 1;
                        alignment: center;

                        Text {
                            text: root.render-output-path-text != "" ? root.render-output-path-text : "(choose output)";
                            color: root.render-output-path-text != "" ? Theme.text-primary : Theme.text-muted;
                            font-size: Theme.font-size-md;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: root.audio-only
                                ? "Audio file (" + root.audio-format-ext + ")"
                                : root.video-container-label + " container";
                            color: Theme.text-faint;
                            font-size: Theme.font-size-xs;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: 64px;
                            height: 28px;
                            border-radius: 5px;
                            background: browse-touch.has-hover ? Theme.surface-control-hover : Theme.surface-control;

                            Text {
                                text: "Browse";
                                color: Theme.text-soft;
                                font-size: Theme.font-size-sm;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            browse-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.browse-output(); }
                            }
                        }
                    }
                }
            }

            if root.wants-video : Rectangle { height: 8px; }
            if root.wants-video : InlineOptionRow {
                label: "Range";
                OptionChip {
                    label: "Full song";
                    active: !root.custom-range-enabled;
                    pressed => { root.select-range-mode("full_song"); }
                }
                OptionChip {
                    label: "Custom";
                    active: root.custom-range-enabled;
                    pressed => { root.select-range-mode("custom"); }
                }
            }

            if root.wants-video && root.custom-range-enabled : Rectangle { height: 4px; }
            if root.wants-video && root.custom-range-enabled : InlineCustomRow {
                label: "Start (s)";
                value: root.render-start-time-text;
                is-preset: false;
                custom-submitted(val) => { root.submit-custom-start-time(val); }
            }
            if root.wants-video && root.custom-range-enabled : Rectangle { height: 4px; }
            if root.wants-video && root.custom-range-enabled : InlineCustomRow {
                label: "End (s)";
                value: root.render-end-time-text != "" ? root.render-end-time-text : root.midi-length-text;
                is-preset: false;
                custom-submitted(val) => { root.submit-custom-end-time(val); }
            }

            Rectangle { height: 4px; }

            InlineOptionRow {
                label: "After Export";
                OptionChip {
                    label: "Do nothing";
                    active: !root.render-open-after-export;
                    pressed => { root.toggle-open-after-export(); }
                }
                OptionChip {
                    label: "Open file";
                    active: root.render-open-after-export;
                    pressed => { root.toggle-open-after-export(); }
                }
            }

            // ─────────────────────────────────────────
            //  3. VIDEO SETTINGS (conditional)
            // ─────────────────────────────────────────
            if root.wants-video : Rectangle { height: 16px; }
            if root.wants-video : Separator { }
            if root.wants-video : Rectangle { height: 16px; }
            if root.wants-video : SectionHeader { title: "VIDEO"; }
            if root.wants-video : Rectangle { height: 8px; }

            if root.wants-video : InlineCustomRow {
                label: "Resolution";
                value: root.render-video-resolution-text;
                is-preset: root.resolution-is-preset;
                custom-submitted(val) => { root.submit-custom-resolution(val); }

                OptionChip {
                    label: "720p";
                    active: root.render-video-resolution-text == "1280x720";
                    pressed => { root.select-resolution("1280x720"); }
                }
                OptionChip {
                    label: "1080p";
                    active: root.render-video-resolution-text == "1920x1080";
                    pressed => { root.select-resolution("1920x1080"); }
                }
                OptionChip {
                    label: "1440p";
                    active: root.render-video-resolution-text == "2560x1440";
                    pressed => { root.select-resolution("2560x1440"); }
                }
            }

            if root.wants-video : Rectangle { height: 4px; }

            if root.wants-video : InlineCustomRow {
                label: "FPS";
                value: root.render-video-fps-text;
                is-preset: root.fps-is-preset;
                custom-submitted(val) => { root.submit-custom-fps(val); }

                OptionChip {
                    label: "30";
                    active: root.render-video-fps-text == "30";
                    pressed => { root.select-fps("30"); }
                }
                OptionChip {
                    label: "60";
                    active: root.render-video-fps-text == "60";
                    pressed => { root.select-fps("60"); }
                }
                OptionChip {
                    label: "120";
                    active: root.render-video-fps-text == "120";
                    pressed => { root.select-fps("120"); }
                }
            }

            if root.wants-video : Rectangle { height: 4px; }

            if root.wants-video : InlineOptionRow {
                label: "Container";
                OptionChip {
                    label: "MP4";
                    active: root.render-video-container-text == "mp4";
                    pressed => { root.select-video-container("mp4"); }
                }
                OptionChip {
                    label: "MKV";
                    active: root.render-video-container-text == "mkv";
                    pressed => { root.select-video-container("mkv"); }
                }
            }

            if root.wants-video : Rectangle { height: 4px; }

            if root.wants-video : InlineOptionRow {
                label: "RGB";
                OptionChip {
                    label: "Premultiplied";
                    active: root.render-video-rgb-mode-text == "premultiplied";
                    pressed => { root.select-video-rgb-mode("premultiplied"); }
                }
                OptionChip {
                    label: "Straight";
                    active: root.render-video-rgb-mode-text == "straight";
                    pressed => { root.select-video-rgb-mode("straight"); }
                }
            }

            if root.wants-video : Rectangle { height: 4px; }

            if root.wants-video : InlineOptionRow {
                label: "Alpha Mask";
                OptionChip {
                    label: "Off";
                    active: !root.render-export-alpha-mask;
                    pressed => { root.toggle-export-alpha-mask(); }
                }
                OptionChip {
                    label: "On";
                    active: root.render-export-alpha-mask;
                    pressed => { root.toggle-export-alpha-mask(); }
                }
            }

            if root.wants-video : Rectangle { height: 4px; }

            if root.wants-video : Text {
                text: root.render-export-alpha-mask
                    ? "Writes an additional grayscale sidecar video next to the main " + root.video-container-label + " as *.alpha" + root.video-container-ext + "."
                    : "Alpha mask export is off. Main " + root.video-container-label + " uses the selected RGB interpretation.";
                color: Theme.text-secondary;
                font-size: Theme.font-size-sm;
                wrap: word-wrap;
            }

            // Video encoding options (collapsible)
            if root.wants-video : Rectangle { height: 8px; }

            if root.wants-video : Rectangle {
                height: 24px;
                border-radius: 4px;
                background: enc-toggle-touch.has-hover ? Theme.surface-panel : transparent;

                enc-toggle-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.encoding-open = !root.encoding-open; }
                }

                HorizontalLayout {
                    padding-left: 2px;
                    padding-right: 4px;
                    spacing: 0px;

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "ENCODING";
                            color: Theme.text-muted;
                            font-size: Theme.font-size-sm;
                            font-weight: 700;
                            letter-spacing: Theme.tracking-wide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        padding-left: 5px;
                        Text {
                            text: root.encoding-open ? "▾" : "▸";
                            color: Theme.text-muted;
                            font-size: Theme.font-size-sm;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }

            if root.wants-video && root.encoding-open : Rectangle { height: 4px; }

            if root.wants-video && root.encoding-open : InlineOptionRow {
                label: "Codec";
                OptionChip {
                    label: "H.264";
                    active: root.render-video-codec-text == "libx264";
                    pressed => { root.select-video-codec("libx264"); }
                }
                OptionChip {
                    label: "H.265";
                    active: root.render-video-codec-text == "libx265";
                    pressed => { root.select-video-codec("libx265"); }
                }
                OptionChip {
                    label: "NVENC";
                    active: root.render-video-codec-text == "h264_nvenc";
                    pressed => { root.select-video-codec("h264_nvenc"); }
                }
            }

            if root.wants-video && root.encoding-open : Rectangle { height: 4px; }

            if root.wants-video && root.encoding-open : InlineCustomRow {
                label: "Quality (CRF)";
                value: root.render-video-crf-text;
                is-preset: root.crf-is-preset;
                custom-submitted(val) => { root.submit-custom-crf(val); }

                OptionChip {
                    label: "Lossless";
                    active: root.render-video-crf-text == "0";
                    pressed => { root.select-video-crf("0"); }
                }
                OptionChip {
                    label: "High (15)";
                    active: root.render-video-crf-text == "15";
                    pressed => { root.select-video-crf("15"); }
                }
                OptionChip {
                    label: "Good (18)";
                    active: root.render-video-crf-text == "18";
                    pressed => { root.select-video-crf("18"); }
                }
                OptionChip {
                    label: "Medium (23)";
                    active: root.render-video-crf-text == "23";
                    pressed => { root.select-video-crf("23"); }
                }
                OptionChip {
                    label: "Low (28)";
                    active: root.render-video-crf-text == "28";
                    pressed => { root.select-video-crf("28"); }
                }
            }

            if root.wants-video && root.encoding-open : Rectangle { height: 4px; }

            if root.wants-video && root.encoding-open : InlineOptionRow {
                label: "Speed";
                OptionChip {
                    label: "ultrafast";
                    active: root.render-video-preset-text == "ultrafast";
                    pressed => { root.select-video-preset("ultrafast"); }
                }
                OptionChip {
                    label: "fast";
                    active: root.render-video-preset-text == "fast";
                    pressed => { root.select-video-preset("fast"); }
                }
                OptionChip {
                    label: "medium";
                    active: root.render-video-preset-text == "medium";
                    pressed => { root.select-video-preset("medium"); }
                }
                OptionChip {
                    label: "slow";
                    active: root.render-video-preset-text == "slow";
                    pressed => { root.select-video-preset("slow"); }
                }
                OptionChip {
                    label: "veryslow";
                    active: root.render-video-preset-text == "veryslow";
                    pressed => { root.select-video-preset("veryslow"); }
                }
            }

            if root.wants-video && root.encoding-open : Rectangle { height: 4px; }

            if root.wants-video && root.encoding-open : InlineOptionRow {
                label: "Pixel Fmt";
                OptionChip {
                    label: "yuv420p";
                    active: root.render-video-pix-fmt-text == "yuv420p";
                    pressed => { root.select-video-pix-fmt("yuv420p"); }
                }
                OptionChip {
                    label: "yuv444p";
                    active: root.render-video-pix-fmt-text == "yuv444p";
                    pressed => { root.select-video-pix-fmt("yuv444p"); }
                }
            }

            // ─────────────────────────────────────────
            //  4. AUDIO SETTINGS (conditional)
            // ─────────────────────────────────────────
            if root.wants-audio : Rectangle { height: 16px; }
            if root.wants-audio : Separator { }
            if root.wants-audio : Rectangle { height: 16px; }
            if root.wants-audio : SectionHeader { title: "AUDIO"; }
            if root.wants-audio : Rectangle { height: 8px; }

            if root.audio-only : InlineOptionRow {
                label: "Format";
                OptionChip {
                    label: "WAV";
                    active: root.render-audio-format-text == "wav";
                    pressed => { root.select-audio-format("wav"); }
                }
                OptionChip {
                    label: "FLAC";
                    active: root.render-audio-format-text == "flac";
                    pressed => { root.select-audio-format("flac"); }
                }
                OptionChip {
                    label: "MP3";
                    active: root.render-audio-format-text == "mp3";
                    pressed => { root.select-audio-format("mp3"); }
                }
            }

            if root.is-combined-mode : FieldRow {
                label: "Codec";
                value: "AAC (muxed into " + root.video-container-label + ")";
            }

            if root.wants-audio : Rectangle { height: 4px; }

            if root.wants-audio : InlineOptionRow {
                label: "Sample Rate";

                if root.audio-supports-44100 : OptionChip {
                    label: "44.1k";
                    active: root.render-audio-sample-rate-text == "44100";
                    pressed => { root.select-audio-sample-rate("44100"); }
                }
                if root.audio-supports-48000 : OptionChip {
                    label: "48k";
                    active: root.render-audio-sample-rate-text == "48000";
                    pressed => { root.select-audio-sample-rate("48000"); }
                }
                if root.audio-supports-88200 : OptionChip {
                    label: "88.2k";
                    active: root.render-audio-sample-rate-text == "88200";
                    pressed => { root.select-audio-sample-rate("88200"); }
                }
                if root.audio-supports-96000 : OptionChip {
                    label: "96k";
                    active: root.render-audio-sample-rate-text == "96000";
                    pressed => { root.select-audio-sample-rate("96000"); }
                }
                if root.audio-supports-176400 : OptionChip {
                    label: "176.4k";
                    active: root.render-audio-sample-rate-text == "176400";
                    pressed => { root.select-audio-sample-rate("176400"); }
                }
                if root.audio-supports-192000 : OptionChip {
                    label: "192k";
                    active: root.render-audio-sample-rate-text == "192000";
                    pressed => { root.select-audio-sample-rate("192000"); }
                }
            }

            if root.wants-audio : Rectangle { height: 4px; }

            if root.wants-audio : InlineOptionRow {
                label: "Channels";

                if root.audio-supports-mono : OptionChip {
                    label: "Mono";
                    active: root.render-audio-channel-count-text == "mono";
                    pressed => { root.select-audio-channel-count("mono"); }
                }
                if root.audio-supports-stereo : OptionChip {
                    label: "Stereo";
                    active: root.render-audio-channel-count-text == "stereo";
                    pressed => { root.select-audio-channel-count("stereo"); }
                }
            }

            if root.is-combined-mode : Rectangle { height: 4px; }

            if root.is-combined-mode || (root.audio-only && root.render-audio-format-text == "mp3") : InlineCustomRow {
                label: "Bitrate";
                value: root.render-audio-bitrate-text;
                is-preset: root.bitrate-is-preset;
                custom-submitted(val) => { root.submit-custom-audio-bitrate(val); }

                OptionChip {
                    label: "128k";
                    active: root.render-audio-bitrate-text == "128k";
                    pressed => { root.select-audio-bitrate("128k"); }
                }
                OptionChip {
                    label: "192k";
                    active: root.render-audio-bitrate-text == "192k";
                    pressed => { root.select-audio-bitrate("192k"); }
                }
                OptionChip {
                    label: "256k";
                    active: root.render-audio-bitrate-text == "256k";
                    pressed => { root.select-audio-bitrate("256k"); }
                }
                OptionChip {
                    label: "320k";
                    active: root.render-audio-bitrate-text == "320k";
                    pressed => { root.select-audio-bitrate("320k"); }
                }
            }

            if root.wants-audio : Rectangle { height: 4px; }

            if root.wants-audio : InlineOptionRow {
                label: "Limiter";
                OptionChip {
                    label: "Off";
                    active: !root.render-use-limiter;
                    pressed => { root.toggle-use-limiter(); }
                }
                OptionChip {
                    label: "On";
                    active: root.render-use-limiter;
                    pressed => { root.toggle-use-limiter(); }
                }
            }

            // ─────────────────────────────────────────
            //  5. ADVANCED (collapsible ffmpeg flags)
            // ─────────────────────────────────────────
            Rectangle { height: 16px; }
            Separator { }
            Rectangle { height: 16px; }

            Rectangle {
                height: 24px;
                border-radius: 4px;
                background: adv-toggle-touch.has-hover ? Theme.surface-panel : transparent;

                adv-toggle-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.advanced-open = !root.advanced-open; }
                }

                HorizontalLayout {
                    padding-left: 2px;
                    padding-right: 4px;
                    spacing: 0px;

                    VerticalLayout {
                        alignment: center;
                        SectionHeader { title: "ADVANCED"; }
                    }

                    VerticalLayout {
                        alignment: center;
                        padding-left: 5px;
                        Text {
                            text: root.advanced-open ? "▾" : "▸";
                            color: Theme.text-muted;
                            font-size: Theme.font-size-sm;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }

            if root.advanced-open : Rectangle { height: 8px; }

            if root.advanced-open && root.wants-video : VerticalLayout {
                spacing: 4px;

                Text {
                    text: "Video FFmpeg args";
                    color: Theme.text-detail;
                    font-size: Theme.font-size-md;
                }

                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: Theme.surface-canvas;
                    border-width: 1px;
                    border-color: video-ffmpeg-input.has-focus ? Theme.accent-border : Theme.border-strong;

                    video-ffmpeg-input := TextInput {
                        text: root.render-video-ffmpeg-args-text;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-md;
                        font-family: Theme.font-family-mono;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        edited => {
                            root.change-video-ffmpeg-args(self.text);
                        }
                    }
                }

                Text {
                    text: "Extra flags appended after the structured settings above. Overrides are last-wins.";
                    color: Theme.text-faint;
                    font-size: Theme.font-size-xs;
                    wrap: word-wrap;
                }
            }

            if root.advanced-open && root.wants-video && root.wants-audio : Rectangle { height: 8px; }

            if root.advanced-open && root.wants-audio : VerticalLayout {
                spacing: 4px;

                Text {
                    text: root.is-combined-mode ? "Audio / mux FFmpeg args" : "Audio FFmpeg args";
                    color: Theme.text-detail;
                    font-size: Theme.font-size-md;
                }

                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: Theme.surface-canvas;
                    border-width: 1px;
                    border-color: audio-ffmpeg-input.has-focus ? Theme.accent-border : Theme.border-strong;

                    audio-ffmpeg-input := TextInput {
                        text: root.render-audio-ffmpeg-args-text;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-md;
                        font-family: Theme.font-family-mono;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        edited => {
                            root.change-audio-ffmpeg-args(self.text);
                        }
                    }
                }

                Text {
                    text: root.is-combined-mode
                        ? (root.render-video-container-text == "mp4"
                            ? "Extra flags for the mux/encode step. e.g. -movflags +faststart"
                            : "Extra flags for the mux/encode step. e.g. -metadata title=\"Song\"")
                        : "Extra flags for the audio encode step. e.g. -compression_level 8";
                    color: Theme.text-faint;
                    font-size: Theme.font-size-xs;
                    wrap: word-wrap;
                }
            }

            // ─────────────────────────────────────────
            //  6. EXPORT — action + live status
            // ─────────────────────────────────────────
            Rectangle { height: 16px; }
            Separator { }
            Rectangle { height: 16px; }

            // Result banner (shown after export finishes / fails / cancels)
            if root.has-export-result && !root.render-busy : Rectangle {
                height: 40px;
                border-radius: 8px;
                background: root.export-succeeded ? #0c2a1a
                    : root.export-failed ? #2a0c0c
                    : #141820;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: root.export-succeeded ? "✓" : root.export-failed ? "✗" : "—";
                        color: root.export-succeeded ? Theme.status-success
                            : root.export-failed ? Theme.status-danger
                            : Theme.text-secondary;
                        font-size: Theme.font-size-2xl;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.export-status;
                        color: root.export-succeeded ? Theme.status-success
                            : root.export-failed ? Theme.status-danger
                            : Theme.text-secondary;
                        font-size: Theme.font-size-lg;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.export-detail-text;
                        color: root.export-succeeded ? #1a6b4d
                            : root.export-failed ? #9b3030
                            : Theme.text-muted;
                        font-family: Theme.font-family-mono;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            if root.has-export-result && !root.render-busy : Rectangle { height: 10px; }

            // Active render progress (only visible during export)
            if root.render-busy : Rectangle {
                border-radius: 8px;
                background: Theme.surface-panel;

                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: root.export-status;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-lg;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.export-detail-text;
                            color: Theme.text-muted;
                            font-family: Theme.font-family-mono;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    if !root.is-combined-mode : ProgressBar { progress: root.export-progress; }

                    if root.single-mode-pass-active : HorizontalLayout {
                        spacing: 8px;
                        height: 20px;

                        Text {
                            text: root.single-mode-pass-label;
                            color: Theme.text-muted;
                            font-size: Theme.font-size-sm;
                            min-width: 44px;
                            vertical-alignment: center;
                        }
                        StatusBadge {
                            label: root.single-mode-pass-status;
                            active: root.single-mode-pass-status != "Idle";
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.single-mode-pass-elapsed;
                            color: Theme.text-faint;
                            font-family: Theme.font-family-mono;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }
                    }

                    // Per-pass breakdown (only shown for combined video+audio renders)
                    if root.is-combined-mode : Rectangle { height: 2px; }

                    if root.is-combined-mode : HorizontalLayout {
                        spacing: 8px;
                        height: 20px;

                        Text {
                            text: "Video";
                            color: Theme.text-muted;
                            font-size: Theme.font-size-sm;
                            min-width: 44px;
                            vertical-alignment: center;
                        }
                        StatusBadge {
                            label: root.video-render-status;
                            active: root.video-render-status != "Idle";
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.video-render-elapsed;
                            color: Theme.text-faint;
                            font-family: Theme.font-family-mono;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }
                    }

                    if root.is-combined-mode : ProgressBar {
                        progress: root.video-render-progress;
                    }

                    if root.is-combined-mode : Rectangle { height: 2px; }

                    if root.is-combined-mode : HorizontalLayout {
                        spacing: 8px;
                        height: 20px;

                        Text {
                            text: "Audio";
                            color: Theme.text-muted;
                            font-size: Theme.font-size-sm;
                            min-width: 44px;
                            vertical-alignment: center;
                        }
                        StatusBadge {
                            label: root.audio-render-status;
                            active: root.audio-render-status != "Idle";
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.audio-render-elapsed;
                            color: Theme.text-faint;
                            font-family: Theme.font-family-mono;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }
                    }

                    if root.is-combined-mode : ProgressBar {
                        progress: root.audio-render-progress;
                    }
                }
            }

            if root.render-busy : Rectangle { height: 10px; }

            // Action buttons
            HorizontalLayout {
                spacing: 8px;

                start-button := PrimaryButton {
                    horizontal-stretch: 1;
                    label: root.start-label;
                    enabled: root.has-midi && !root.render-busy;
                    pressed => { root.start-export(); }
                }

                if root.render-busy : Rectangle {
                    width: 124px;
                    height: start-button.height;
                    border-radius: 8px;
                    background: cancel-touch.has-hover ? #3a1525 : #211521;
                    border-width: 1px;
                    border-color: #4f2438;

                    Text {
                        text: "Cancel";
                        color: #f6b4cb;
                        font-size: Theme.font-size-lg;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    cancel-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cancel-export(); }
                    }
                }
            }

            // Guidance when no MIDI is loaded
            if !root.has-midi : Rectangle { height: 8px; }
            if !root.has-midi : Text {
                text: "Load a MIDI file on the Preview tab to begin exporting.";
                color: Theme.text-muted;
                font-size: Theme.font-size-md;
                wrap: word-wrap;
            }

            // ─────────────────────────────────────────
            //  7. PROJECT INPUTS (read-only reference)
            // ─────────────────────────────────────────
            Rectangle { height: 16px; }
            Separator { }
            Rectangle { height: 16px; }

            SectionHeader { title: "PROJECT INPUTS"; }
            Rectangle { height: 8px; }

            FieldRow {
                label: "MIDI";
                value: root.has-midi ? root.selected-midi-name : "No MIDI selected";
            }
            FieldRow { label: "Duration"; value: root.midi-length-text; }
            FieldRow { label: "Scene"; value: root.scene-summary-text; }
            Rectangle { height: 8px; }

            HorizontalLayout {
                spacing: 8px;
                height: 26px;

                Text {
                    text: "Visual";
                    color: Theme.text-muted;
                    font-size: Theme.font-size-sm;
                    font-weight: 700;
                    letter-spacing: Theme.tracking-wide;
                    vertical-alignment: center;
                    min-width: 52px;
                }

                StatusBadge {
                    horizontal-stretch: 1;
                    label: root.video-ready ? "Ready" : "Uses current scene";
                    active: root.video-ready;
                }
            }

            Rectangle { height: 4px; }

            HorizontalLayout {
                spacing: 8px;
                height: 26px;

                Text {
                    text: "Audio";
                    color: Theme.text-muted;
                    font-size: Theme.font-size-sm;
                    font-weight: 700;
                    letter-spacing: Theme.tracking-wide;
                    vertical-alignment: center;
                    min-width: 52px;
                }

                StatusBadge {
                    horizontal-stretch: 1;
                    label: root.audio-ready ? "Ready" : "Prepares on demand";
                    active: root.audio-ready;
                }
            }

            Rectangle { height: 24px; }
        }
    }
}

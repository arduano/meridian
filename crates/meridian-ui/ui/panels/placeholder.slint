// Placeholder scaffold for profiles not yet built.

import { Separator } from "../primitives.slint";

export component PlaceholderPanel inherits Rectangle {
    in property <string> panel-title;
    in property <string> panel-description;

    background: transparent;

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        alignment: start;

        Text {
            text: root.panel-title;
            color: #d0dae8;
            font-size: 14px;
            font-weight: 700;
        }

        Text {
            text: root.panel-description;
            color: #4d6580;
            font-size: 12px;
            wrap: word-wrap;
        }

        Separator { }

        Text {
            text: "Coming soon";
            color: #2d3d52;
            font-size: 11px;
        }
    }
}

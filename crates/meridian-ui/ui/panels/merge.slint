import { MergeSourceRow } from "../structs.slint";
import { FieldRow, OptionChip, PrimaryButton, ProgressBar, SectionHeader, Separator } from "../primitives.slint";
import { Theme } from "../theme.slint";

component MiniActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback pressed;

    height: 26px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.enabled ? #1a2a40 : Theme.border-subtle;
    background: root.enabled ? (touch.has-hover ? #152338 : #0d1726) : Theme.surface-canvas;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;

        Text {
            text: root.label;
            color: root.enabled ? #8ea6c2 : Theme.text-faint;
            font-size: Theme.font-size-sm;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.pressed(); } }
    }
}

component MergeMetricCell inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 42px;
    border-radius: 8px;
    background: #0b1320;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 1px;

        Text { text: root.label; color: #40536d; font-size: Theme.font-size-xs; font-weight: 700; }
        Text { text: root.value; color: #9fb2c8; font-size: Theme.font-size-sm; font-family: Theme.font-family-mono; font-weight: 600; }
    }
}

component MergeTextRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> hint: "";
    callback submitted(string);

    private property <string> draft: root.value;

    changed value => {
        root.draft = root.value;
    }

    height: root.hint != "" ? 56px : 36px;
    background: transparent;

    VerticalLayout {
        spacing: 3px;
        alignment: start;

        HorizontalLayout {
            spacing: 8px;
            height: 30px;

            Text {
                text: root.label;
                color: Theme.text-detail;
                font-size: Theme.font-size-md;
                vertical-alignment: center;
                min-width: 100px;
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                border-radius: 6px;
                background: Theme.surface-canvas;
                border-width: 1px;
                border-color: editor.has-focus ? Theme.accent-border : Theme.border-strong;

                editor := TextInput {
                    text: root.draft;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-md;
                    vertical-alignment: center;
                    font-family: Theme.font-family-mono;
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    edited => { root.draft = self.text; }
                    accepted => { root.submitted(root.draft); }
                }
            }

            Rectangle {
                width: 44px;
                height: 28px;
                border-radius: 6px;
                background: apply-area.has-hover ? #0f1724 : #09101a;
                border-width: 1px;
                border-color: Theme.border-strong;

                Text {
                    text: "Apply";
                    color: #8aa0bb;
                    font-size: Theme.font-size-sm;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                apply-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.submitted(root.draft); }
                }
            }
        }

        if root.hint != "" : Text {
            text: root.hint;
            color: #556b86;
            font-size: Theme.font-size-xs;
            wrap: word-wrap;
        }
    }
}

component MergeSourceCard inherits Rectangle {
    in property <MergeSourceRow> source-data;
    in property <int> index: 0;
    callback move-source(int, int);
    callback remove-source(int);

    border-radius: 12px;
    background: source-data.is_error ? #1a1014 : Theme.surface-panel;
    border-width: 1px;
    border-color: source-data.is_error ? #38212c : source-data.is_loading ? #19304a : Theme.border-subtle;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 10px;

            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    text: source-data.name;
                    color: source-data.is_error ? #f0b8ca : #d7e2f0;
                    font-size: Theme.font-size-2xl;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: source-data.path;
                    color: #60748f;
                    font-size: Theme.font-size-xs;
                    font-family: Theme.font-family-mono;
                    overflow: elide;
                }
            }

            Rectangle {
                height: 24px;
                border-radius: 12px;
                background: source-data.is_error ? #31131f : source-data.is_loading ? #122337 : #0f2230;
                border-width: 1px;
                border-color: source-data.is_error ? #5a2437 : source-data.is_loading ? #1d4064 : #163145;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: center;

                    Text {
                        text: source-data.status;
                        color: source-data.is_error ? #ff9dbc : source-data.is_loading ? #8abff7 : #7fd1c4;
                        font-size: Theme.font-size-sm;
                        font-weight: 700;
                    }
                }
            }

            MiniActionButton { label: "Up"; enabled: index > 0; pressed => { root.move-source(index, -1); } }
            MiniActionButton { label: "Down"; pressed => { root.move-source(index, 1); } }
            MiniActionButton { label: "Remove"; pressed => { root.remove-source(index); } }
        }

        HorizontalLayout {
            spacing: 8px;
            MergeMetricCell { label: "Tracks"; value: source-data.tracks_text; }
            MergeMetricCell { label: "Notes"; value: source-data.notes_text; }
            MergeMetricCell { label: "Tempo"; value: source-data.tempo_text; }
            MergeMetricCell { label: "Length"; value: source-data.length_text; }
            MergeMetricCell { label: "PPQ"; value: source-data.ppq_text; }
        }

        HorizontalLayout {
            spacing: 20px;
            Text { text: source-data.bpm_text; color: #87a0bc; font-size: Theme.font-size-sm; font-family: Theme.font-family-mono; }
            Text { text: source-data.meta_text; color: #556b86; font-size: Theme.font-size-sm; overflow: elide; }
        }
    }
}

export component MergePanel inherits Rectangle {
    in property <[MergeSourceRow]> merge-sources: [];
    in property <string> merge-source-count-text: "0";
    in property <string> merge-track-total-text: "—";
    in property <string> merge-note-total-text: "—";
    in property <string> merge-tempo-total-text: "—";
    in property <string> merge-layout-text: "append_tracks";
    in property <string> merge-metadata-mode-text: "keep";
    in property <string> merge-ppq-override-text: "";
    in property <string> merge-output-path-text: "";
    in property <float> merge-progress: 0;
    in property <bool> merge-job-active: false;
    in property <string> merge-status-text: "Ready";
    in property <string> merge-detail-text: "Drop MIDI files here or browse to assemble a merge.";
    in property <string> merge-result-output-text: "merged-output.mid";
    in property <string> merge-result-input-count-text: "—";
    in property <string> merge-result-track-count-text: "—";
    in property <string> merge-result-ppq-text: "—";
    in property <string> merge-result-event-count-text: "—";

    callback select-merge-files;
    callback clear-merge-files;
    callback remove-merge-source(int);
    callback move-merge-source(int, int);
    callback update-merge-control(string, string);
    callback browse-merge-output;
    callback start-merge-job;
    callback cancel-merge-job;

    private property <bool> has-sources: root.merge-source-count-text != "0";
    private property <bool> start-enabled:
        root.has-sources && root.merge-output-path-text != "" && !root.merge-job-active;

    clip: true;
    background: Theme.surface-canvas;

    Flickable {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            width: parent.width;
            padding: 24px;
            padding-right: 28px;
            spacing: 0px;
            alignment: start;

            Rectangle {
                border-radius: 18px;
                background: #0d1625;
                border-width: 1px;
                border-color: #152338;

                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;

                    Text {
                        text: "MERGE MIDI SOURCES";
                        color: #e2ebf6;
                        font-size: 20px;
                        font-weight: 800;
                    }
                    Text {
                        text: "Build a merge queue, inspect each source, then render a clean combined MIDI with track-layout and metadata rules baked in.";
                        color: #7590ad;
                        font-size: Theme.font-size-md;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        border-radius: 14px;
                        background: Theme.surface-card;
                        border-width: 1px;
                        border-color: #17304a;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 10px;
                            alignment: center;

                            Text {
                                text: "Drag MIDIs into the window to append them to this merge.";
                                color: #9fb5cd;
                                font-size: Theme.font-size-lg;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Each file gets a lightweight inspection pass first: track counts, tempo map activity, PPQ, note count, and rough timing.";
                                color: #5d738e;
                                font-size: Theme.font-size-sm;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;

                                Rectangle {
                                    width: 150px;
                                    PrimaryButton {
                                        width: parent.width;
                                        label: "Add MIDI Files";
                                        pressed => { root.select-merge-files(); }
                                    }
                                }
                                MiniActionButton {
                                    label: "Clear Queue";
                                    enabled: root.has-sources && !root.merge-job-active;
                                    pressed => { root.clear-merge-files(); }
                                }
                            }
                        }
                    }

                    if root.has-sources : HorizontalLayout {
                        spacing: 8px;
                        MergeMetricCell { label: "Sources"; value: root.merge-source-count-text; }
                        MergeMetricCell { label: "Tracks"; value: root.merge-track-total-text; }
                        MergeMetricCell { label: "Notes"; value: root.merge-note-total-text; }
                        MergeMetricCell { label: "Tempo Events"; value: root.merge-tempo-total-text; }
                    }
                }
            }

            Rectangle { height: 18px; }
            Separator {}
            Rectangle { height: 18px; }

            SectionHeader { title: "SOURCE QUEUE"; }
            Rectangle { height: 6px; }
            Text {
                text: "Order matters for track stacking, first-tempo preference, and any shared metadata lane you enable below.";
                color: Theme.text-muted;
                font-size: Theme.font-size-sm;
                wrap: word-wrap;
            }
            Rectangle { height: 12px; }

            if !root.has-sources : Rectangle {
                border-radius: 14px;
                background: Theme.surface-panel;
                border-width: 1px;
                border-color: Theme.border-subtle;
                height: 120px;

                VerticalLayout {
                    alignment: center;
                    spacing: 6px;

                    Text { text: "No MIDI files queued"; color: #93a8c1; font-size: Theme.font-size-2xl; font-weight: 700; }
                    Text { text: "Drop files here or use Add MIDI Files above."; color: #506683; font-size: Theme.font-size-sm; }
                }
            }

            if root.has-sources : VerticalLayout {
                spacing: 10px;

                for source[index] in root.merge-sources : MergeSourceCard {
                    source-data: source;
                    index: index;
                    move-source(i, delta) => { root.move-merge-source(i, delta); }
                    remove-source(i) => { root.remove-merge-source(i); }
                }
            }

            Rectangle { height: 18px; }
            Separator {}
            Rectangle { height: 18px; }

            SectionHeader { title: "MERGE RECIPE"; }
            Rectangle { height: 10px; }

            HorizontalLayout {
                spacing: 12px;

                Rectangle {
                    border-radius: 14px;
                    background: Theme.surface-panel;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        Text { text: "TRACK LAYOUT"; color: Theme.text-primary-strong; font-size: Theme.font-size-lg; font-weight: 700; }
                        Text { text: "Choose whether files append their tracks in order or merge matching track indexes together."; color: #5f7490; font-size: Theme.font-size-sm; wrap: word-wrap; }

                        HorizontalLayout {
                            spacing: 6px;
                            OptionChip { label: "Append"; active: root.merge-layout-text == "append_tracks"; pressed => { root.update-merge-control("layout", "append_tracks"); } }
                            OptionChip { label: "By Index"; active: root.merge-layout-text == "merge_tracks"; pressed => { root.update-merge-control("layout", "merge_tracks"); } }
                        }
                    }
                }

                Rectangle {
                    border-radius: 14px;
                    background: Theme.surface-panel;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        Text { text: "METADATA TRACK"; color: Theme.text-primary-strong; font-size: Theme.font-size-lg; font-weight: 700; }
                        Text { text: "Either keep metadata in place, or normalize shared metadata into a dedicated first track."; color: #5f7490; font-size: Theme.font-size-sm; wrap: word-wrap; }

                        HorizontalLayout {
                            spacing: 6px;
                            OptionChip { label: "Keep"; active: root.merge-metadata-mode-text == "keep"; pressed => { root.update-merge-control("metadata_mode", "keep"); } }
                            OptionChip { label: "Normalize"; active: root.merge-metadata-mode-text == "normalize"; pressed => { root.update-merge-control("metadata_mode", "normalize"); } }
                        }
                    }
                }
            }

            Rectangle { height: 12px; }

            Rectangle {
                border-radius: 14px;
                background: Theme.surface-panel;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text { text: "TIMING"; color: Theme.text-primary-strong; font-size: Theme.font-size-lg; font-weight: 700; }
                    Text { text: "Leave blank to keep the source PPQ when they already match, or set an override to scale everything into a new PPQ."; color: #5f7490; font-size: Theme.font-size-sm; wrap: word-wrap; }
                    MergeTextRow { label: "PPQ override"; value: root.merge-ppq-override-text; hint: "Blank keeps source PPQ."; submitted(text) => { root.update-merge-control("ppq_override", text); } }
                }
            }

            Rectangle { height: 18px; }
            Separator {}
            Rectangle { height: 18px; }

            SectionHeader { title: "OUTPUT + RUN"; }
            Rectangle { height: 10px; }

            Rectangle {
                border-radius: 14px;
                background: Theme.surface-panel;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    Text { text: "OUTPUT FILE"; color: Theme.text-primary-strong; font-size: Theme.font-size-lg; font-weight: 700; }

                    Rectangle {
                        border-radius: 10px;
                        background: #09101a;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 10px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 8px;

                            Text {
                                text: root.merge-output-path-text != "" ? root.merge-output-path-text : "Choose an output path";
                                color: root.merge-output-path-text != "" ? #a6b8cd : #506683;
                                font-size: Theme.font-size-sm;
                                font-family: Theme.font-family-mono;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            MiniActionButton { label: "Browse"; pressed => { root.browse-merge-output(); } }
                        }
                    }

                    Text { text: root.merge-status-text; color: #dbe6f3; font-size: Theme.font-size-lg; font-weight: 700; }
                    Text { text: root.merge-detail-text; color: #67809c; font-size: Theme.font-size-sm; wrap: word-wrap; }
                    ProgressBar { progress: root.merge-progress; }

                    HorizontalLayout {
                        spacing: 12px;

                        Rectangle {
                            width: 160px;
                            PrimaryButton {
                                width: parent.width;
                                label: root.merge-job-active ? "Processing..." : "Write Merged MIDI";
                                enabled: root.start-enabled;
                                pressed => { root.start-merge-job(); }
                            }
                        }

                        MiniActionButton {
                            label: "Cancel";
                            enabled: root.merge-job-active;
                            pressed => { root.cancel-merge-job(); }
                        }
                    }

                    Rectangle { height: 4px; }
                    FieldRow { label: "Output"; value: root.merge-result-output-text; }
                    FieldRow { label: "Inputs"; value: root.merge-result-input-count-text; }
                    FieldRow { label: "Tracks"; value: root.merge-result-track-count-text; }
                    FieldRow { label: "PPQ"; value: root.merge-result-ppq-text; }
                    FieldRow { label: "Events"; value: root.merge-result-event-count-text; }
                }
            }

            Rectangle { height: 40px; }
        }
    }
}

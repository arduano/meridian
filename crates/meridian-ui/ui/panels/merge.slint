// ═══════════════════════════════════════════════════════════
//  Merge panel.
//
//  Workflow:
//   1. Add MIDI source files (drag-drop or browse)
//   2. Inspect + reorder the source queue
//   3. Configure merge recipe (layout, metadata, PPQ)
//   4. Set output path → Write merged MIDI
//
//  Layout:  single-column scroll, progressive disclosure.
//   • Source queue — compact per-source rows
//   • Merge recipe — inline option rows in a single card
//   • Output & Run — flat action area
// ═══════════════════════════════════════════════════════════

import { MergeSourceRow } from "../structs.slint";
import {
    FieldRow, InlineCustomRow, InlineOptionRow, OptionChip,
    PrimaryButton, ProgressBar, SectionHeader, Separator, StatusBadge
} from "../primitives.slint";
import { Theme } from "../theme.slint";

// ── MergeCard ──────────────────────────────────────────────
// Rounded container card (same role as ModifyCard).

component MergeCard inherits Rectangle {
    border-radius: 10px;
    background: Theme.surface-panel;
    border-width: 1px;
    border-color: #132031;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        alignment: start;

        @children
    }
}


// ── MergeSourceItem ────────────────────────────────────────
// Compact row for one source in the queue.

component MergeSourceItem inherits Rectangle {
    in property <MergeSourceRow> data;
    in property <int> index: 0;
    in property <bool> is-first: false;
    in property <bool> is-last: false;
    callback move-source(int, int);
    callback remove-source(int);

    border-radius: 8px;
    background: data.is_error ? #1a1014 : Theme.surface-panel;
    border-width: 1px;
    border-color: data.is_error ? #38212c : data.is_loading ? #19304a : #132031;

    VerticalLayout {
        padding: 10px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;

        // ── Top row: name + status + actions ──
        HorizontalLayout {
            spacing: 8px;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: data.name;
                    color: data.is_error ? #f0b8ca : Theme.text-primary;
                    font-size: Theme.font-size-md;
                    font-weight: 700;
                    overflow: elide;
                }
            }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 20px;
                    border-radius: 10px;
                    background: data.is_error ? #31131f : data.is_loading ? #122337 : #0f2230;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        Text {
                            text: data.status;
                            color: data.is_error ? #ff9dbc : data.is_loading ? #8abff7 : #7fd1c4;
                            font-size: Theme.font-size-xs;
                            font-weight: 700;
                        }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 4px;

                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 4px;
                        background: !root.is-first ? (up-touch.has-hover ? #152338 : transparent) : transparent;

                        Text { text: "↑"; color: !root.is-first ? #8ea6c2 : #2a3a4f; font-size: Theme.font-size-sm; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        up-touch := TouchArea { mouse-cursor: !root.is-first ? pointer : default; clicked => { if (!root.is-first) { root.move-source(root.index, -1); } } }
                    }

                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 4px;
                        background: !root.is-last ? (down-touch.has-hover ? #152338 : transparent) : transparent;

                        Text { text: "↓"; color: !root.is-last ? #8ea6c2 : #2a3a4f; font-size: Theme.font-size-sm; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        down-touch := TouchArea { mouse-cursor: !root.is-last ? pointer : default; clicked => { if (!root.is-last) { root.move-source(root.index, 1); } } }
                    }

                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 4px;
                        background: remove-touch.has-hover ? #2a1218 : transparent;

                        Text { text: "×"; color: #8ea6c2; font-size: Theme.font-size-md; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        remove-touch := TouchArea { mouse-cursor: pointer; clicked => { root.remove-source(root.index); } }
                    }
                }
            }
        }

        // ── Stats strip ──
        HorizontalLayout {
            spacing: 12px;

            Text { text: "Tracks"; color: Theme.text-faint; font-size: Theme.font-size-xs; vertical-alignment: center; }
            Text { text: data.tracks_text; color: Theme.text-secondary; font-size: Theme.font-size-xs; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; }

            Text { text: "·"; color: #1e2d40; font-size: Theme.font-size-xs; vertical-alignment: center; }

            Text { text: "Notes"; color: Theme.text-faint; font-size: Theme.font-size-xs; vertical-alignment: center; }
            Text { text: data.notes_text; color: Theme.text-secondary; font-size: Theme.font-size-xs; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; }

            Text { text: "·"; color: #1e2d40; font-size: Theme.font-size-xs; vertical-alignment: center; }

            Text { text: "PPQ"; color: Theme.text-faint; font-size: Theme.font-size-xs; vertical-alignment: center; }
            Text { text: data.ppq_text; color: Theme.text-secondary; font-size: Theme.font-size-xs; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; }

            Text { text: "·"; color: #1e2d40; font-size: Theme.font-size-xs; vertical-alignment: center; }

            Text { text: "Length"; color: Theme.text-faint; font-size: Theme.font-size-xs; vertical-alignment: center; }
            Text { text: data.length_text; color: Theme.text-secondary; font-size: Theme.font-size-xs; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; }

            Text { text: "·"; color: #1e2d40; font-size: Theme.font-size-xs; vertical-alignment: center; }

            Text { text: data.bpm_text; color: Theme.text-faint; font-size: Theme.font-size-xs; font-family: Theme.font-family-mono; vertical-alignment: center; }
        }
    }
}


// ═══════════════════════════════════════════════════════════
//  Main panel
// ═══════════════════════════════════════════════════════════

export component MergePanel inherits Rectangle {
    in property <[MergeSourceRow]> merge-sources: [];
    in property <string> merge-source-count-text: "0";
    in property <string> merge-track-total-text: "—";
    in property <string> merge-note-total-text: "—";
    in property <string> merge-tempo-total-text: "—";
    in property <string> merge-layout-text: "append_tracks";
    in property <string> merge-metadata-mode-text: "keep";
    in property <string> merge-ppq-override-text: "";
    in property <string> merge-output-path-text: "";
    in property <float> merge-progress: 0;
    in property <bool> merge-job-active: false;
    in property <string> merge-status-text: "Ready";
    in property <string> merge-detail-text: "Drop MIDI files here or browse to assemble a merge.";
    in property <string> merge-result-output-text: "merged-output.mid";
    in property <string> merge-result-input-count-text: "—";
    in property <string> merge-result-track-count-text: "—";
    in property <string> merge-result-ppq-text: "—";
    in property <string> merge-result-event-count-text: "—";

    callback select-merge-files;
    callback clear-merge-files;
    callback remove-merge-source(int);
    callback move-merge-source(int, int);
    callback update-merge-control(string, string);
    callback browse-merge-output;
    callback start-merge-job;
    callback cancel-merge-job;

    private property <bool> has-sources: root.merge-source-count-text != "0";
    private property <bool> has-output: root.merge-output-path-text != "";
    private property <bool> start-enabled:
        root.has-sources && root.has-output && !root.merge-job-active;
    private property <bool> ppq-is-preset:
        root.merge-ppq-override-text == ""
        || root.merge-ppq-override-text == "480"
        || root.merge-ppq-override-text == "960";

    clip: true;
    background: Theme.surface-canvas;

    Flickable {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            width: parent.width;
            padding: 20px;
            padding-right: 24px;
            spacing: 0px;
            alignment: start;

            // ══════════════════════════════════════
            //  1 · SOURCE FILES
            // ══════════════════════════════════════

            SectionHeader { title: "MERGE SOURCES"; }
            Rectangle { height: 4px; }
            Text {
                text: "Add MIDI files to build a merge queue. Order matters for track stacking and tempo preference.";
                color: Theme.text-muted;
                font-size: Theme.font-size-sm;
                wrap: word-wrap;
            }
            Rectangle { height: 10px; }

            // ── Actions ──
            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                PrimaryButton {
                    width: 150px;
                    label: "Add MIDI Files";
                    pressed => { root.select-merge-files(); }
                }
                Rectangle {
                    width: 90px;
                    height: 36px;
                    border-radius: 8px;
                    background: root.has-sources && !root.merge-job-active
                        ? (clear-touch.has-hover ? #152338 : #111822)
                        : #111822;

                    Text {
                        text: "Clear All";
                        color: root.has-sources && !root.merge-job-active ? #8ea6c2 : #415269;
                        font-size: Theme.font-size-lg;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    clear-touch := TouchArea {
                        mouse-cursor: root.has-sources && !root.merge-job-active ? pointer : default;
                        clicked => {
                            if (root.has-sources && !root.merge-job-active) {
                                root.clear-merge-files();
                            }
                        }
                    }
                }
            }

            Rectangle { height: 10px; }

            // ── Source summary strip ──
            if root.has-sources : Rectangle {
                height: 28px;
                border-radius: 6px;
                background: Theme.surface-card;
                border-width: 1px;
                border-color: Theme.border-subtle;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 16px;
                    alignment: center;

                    HorizontalLayout { spacing: 4px;
                        Text { text: "Sources"; color: Theme.text-faint; font-size: Theme.font-size-xs; font-weight: 600; vertical-alignment: center; }
                        Text { text: root.merge-source-count-text; color: Theme.text-secondary; font-size: Theme.font-size-xs; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; }
                    }
                    HorizontalLayout { spacing: 4px;
                        Text { text: "Tracks"; color: Theme.text-faint; font-size: Theme.font-size-xs; font-weight: 600; vertical-alignment: center; }
                        Text { text: root.merge-track-total-text; color: Theme.text-secondary; font-size: Theme.font-size-xs; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; }
                    }
                    HorizontalLayout { spacing: 4px;
                        Text { text: "Notes"; color: Theme.text-faint; font-size: Theme.font-size-xs; font-weight: 600; vertical-alignment: center; }
                        Text { text: root.merge-note-total-text; color: Theme.text-secondary; font-size: Theme.font-size-xs; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; }
                    }
                    HorizontalLayout { spacing: 4px;
                        Text { text: "Tempo Events"; color: Theme.text-faint; font-size: Theme.font-size-xs; font-weight: 600; vertical-alignment: center; }
                        Text { text: root.merge-tempo-total-text; color: Theme.text-secondary; font-size: Theme.font-size-xs; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; }
                    }
                }
            }

            if root.has-sources : Rectangle { height: 10px; }

            // ── Source queue ──
            if !root.has-sources : Rectangle {
                height: 60px;
                border-radius: 8px;
                background: Theme.surface-panel;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "No MIDI files queued — drop files here or use Add MIDI Files.";
                        color: Theme.text-muted;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                    }
                }
            }

            if root.has-sources : VerticalLayout {
                spacing: 4px;

                for source[index] in root.merge-sources : MergeSourceItem {
                    data: source;
                    index: index;
                    is-first: index == 0;
                    is-last: index == root.merge-sources.length - 1;
                    move-source(i, delta) => { root.move-merge-source(i, delta); }
                    remove-source(i) => { root.remove-merge-source(i); }
                }
            }

            Rectangle { height: 16px; }
            Separator { }
            Rectangle { height: 16px; }

            // ══════════════════════════════════════
            //  2 · MERGE RECIPE
            // ══════════════════════════════════════

            SectionHeader { title: "MERGE RECIPE"; }
            Rectangle { height: 4px; }
            Text {
                text: "Configure how sources are combined.";
                color: Theme.text-muted;
                font-size: Theme.font-size-sm;
                wrap: word-wrap;
            }
            Rectangle { height: 10px; }

            MergeCard {
                InlineOptionRow {
                    label: "Track Layout";
                    OptionChip { label: "Append"; active: root.merge-layout-text == "append_tracks"; pressed => { root.update-merge-control("layout", "append_tracks"); } }
                    OptionChip { label: "By Index"; active: root.merge-layout-text == "merge_tracks"; pressed => { root.update-merge-control("layout", "merge_tracks"); } }
                }

                InlineOptionRow {
                    label: "Metadata";
                    OptionChip { label: "Keep"; active: root.merge-metadata-mode-text == "keep"; pressed => { root.update-merge-control("metadata_mode", "keep"); } }
                    OptionChip { label: "Normalize"; active: root.merge-metadata-mode-text == "normalize"; pressed => { root.update-merge-control("metadata_mode", "normalize"); } }
                }

                InlineCustomRow {
                    label: "PPQ Override";
                    value: root.merge-ppq-override-text;
                    is-preset: root.ppq-is-preset;
                    custom-display: root.merge-ppq-override-text == "" ? "Source" : root.merge-ppq-override-text;
                    custom-submitted(v) => { root.update-merge-control("ppq_override", v); }
                    OptionChip { label: "Source"; active: root.merge-ppq-override-text == ""; pressed => { root.update-merge-control("ppq_override", ""); } }
                    OptionChip { label: "480"; active: root.merge-ppq-override-text == "480"; pressed => { root.update-merge-control("ppq_override", "480"); } }
                    OptionChip { label: "960"; active: root.merge-ppq-override-text == "960"; pressed => { root.update-merge-control("ppq_override", "960"); } }
                }

                Rectangle { height: 2px; }
                Text {
                    text: "Append stacks tracks sequentially; By Index merges matching track numbers. Normalize consolidates shared metadata into track 0. PPQ Source keeps originals when they match.";
                    color: Theme.text-faint;
                    font-size: Theme.font-size-xs;
                    wrap: word-wrap;
                }
            }

            Rectangle { height: 16px; }
            Separator { }
            Rectangle { height: 16px; }

            // ══════════════════════════════════════
            //  3 · OUTPUT & RUN
            // ══════════════════════════════════════

            SectionHeader { title: "OUTPUT & RUN"; }
            Rectangle { height: 8px; }

            MergeCard {
                // ── Output path ──
                HorizontalLayout {
                    spacing: 10px;

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Output";
                            color: Theme.text-faint;
                            font-size: Theme.font-size-sm;
                            font-weight: 600;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.has-output ? root.merge-output-path-text : "(choose output path)";
                            color: root.has-output ? Theme.text-primary : Theme.text-muted;
                            font-size: Theme.font-size-md;
                            font-weight: 600;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 56px;
                            height: 26px;
                            border-radius: 5px;
                            background: browse-touch.has-hover ? Theme.surface-control-hover : Theme.surface-control;

                            Text {
                                text: "Browse";
                                color: Theme.text-soft;
                                font-size: Theme.font-size-sm;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            browse-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.browse-merge-output(); }
                            }
                        }
                    }
                }

                Separator { }

                // ── Buttons + progress ──
                HorizontalLayout {
                    spacing: 8px;

                    PrimaryButton {
                        label: root.merge-job-active ? "Processing…" : "Write Merged MIDI";
                        enabled: root.start-enabled;
                        pressed => { root.start-merge-job(); }
                    }

                    Rectangle {
                        width: 100px;
                        height: 36px;
                        border-radius: 8px;
                        background: root.merge-job-active
                            ? (cancel-touch.has-hover ? #3a1820 : #261218)
                            : #111822;

                        Text {
                            text: "Cancel";
                            color: root.merge-job-active ? #ef6b73 : #415269;
                            font-size: Theme.font-size-lg;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cancel-touch := TouchArea {
                            mouse-cursor: root.merge-job-active ? pointer : default;
                            clicked => {
                                if (root.merge-job-active) {
                                    root.cancel-merge-job();
                                }
                            }
                        }
                    }
                }

                if root.merge-progress > 0 : ProgressBar { progress: root.merge-progress; }

                if root.merge-detail-text != "" : Text {
                    text: root.merge-detail-text;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }

                // ── Compact last-result ──
                if root.merge-result-track-count-text != "—" : Separator { }
                if root.merge-result-track-count-text != "—" : HorizontalLayout {
                    spacing: 16px;
                    alignment: start;

                    Text { text: "Last result"; color: Theme.text-muted; font-size: Theme.font-size-xs; font-weight: 700; letter-spacing: Theme.tracking-tight; vertical-alignment: center; }
                    HorizontalLayout { spacing: 4px; Text { text: "Inputs"; color: Theme.text-faint; font-size: Theme.font-size-sm; vertical-alignment: center; } Text { text: root.merge-result-input-count-text; color: Theme.text-secondary; font-size: Theme.font-size-sm; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; } }
                    HorizontalLayout { spacing: 4px; Text { text: "Tracks"; color: Theme.text-faint; font-size: Theme.font-size-sm; vertical-alignment: center; } Text { text: root.merge-result-track-count-text; color: Theme.text-secondary; font-size: Theme.font-size-sm; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; } }
                    HorizontalLayout { spacing: 4px; Text { text: "PPQ"; color: Theme.text-faint; font-size: Theme.font-size-sm; vertical-alignment: center; } Text { text: root.merge-result-ppq-text; color: Theme.text-secondary; font-size: Theme.font-size-sm; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; } }
                    HorizontalLayout { spacing: 4px; Text { text: "Events"; color: Theme.text-faint; font-size: Theme.font-size-sm; vertical-alignment: center; } Text { text: root.merge-result-event-count-text; color: Theme.text-secondary; font-size: Theme.font-size-sm; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; } }
                }
            }

            Rectangle { height: 24px; }
        }
    }
}

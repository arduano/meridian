// ═══════════════════════════════════════════════════════════
//  Modify panel (profile 3).
//
//  Workflow:
//   1. Load a MIDI file
//   2. Pick a modifier pass from the library
//   3. Tune pass-specific settings with structured controls
//   4. Set output path → Write modified MIDI
//
//  Layout:  single-column scroll, progressive disclosure.
//   • Pass library — compact categorised list
//   • Pass settings — full-width card with structured controls
//   • Output & Run — unified action area
//   • Advanced JSON — collapsed escape hatch at the bottom
//
//  Controls use the shared primitives:
//   • InlineOptionRow + OptionChip  — enum / toggle selections
//   • InlineCustomRow + OptionChip  — preset + custom text entry
//   • FieldRow                      — read-only display
//   • SectionHeader / Separator     — structure
// ═══════════════════════════════════════════════════════════

import { MidiLoadState } from "../structs.slint";
import {
    FieldRow, InlineOptionRow, InlineCustomRow, OptionChip, PrimaryButton,
    ProgressBar, SectionHeader, Separator, StatusBadge
} from "../primitives.slint";
import { MidiStateSection } from "../midi_loading.slint";
import { TextEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";


// ── ModifyPassItem ─────────────────────────────────────────
// Compact list item for the pass library with label + description.

component ModifyPassItem inherits Rectangle {
    in property <string> label;
    in property <string> subtitle: "";
    in property <bool> active: false;
    callback pressed;

    height: 38px;
    horizontal-stretch: 1;
    border-radius: 6px;
    background: root.active ? #11243f : touch.has-hover ? #0e1724 : transparent;

    HorizontalLayout {
        padding-top: 5px;
        padding-bottom: 5px;
        padding-left: 8px;
        padding-right: 10px;
        alignment: start;
        spacing: 8px;

        Rectangle {
            width: 3px;
            height: parent.height - 10px;
            border-radius: 2px;
            background: root.active ? #3b8eea : transparent;
        }

        VerticalLayout {
            spacing: 1px;
            alignment: center;

            Text {
                text: root.label;
                color: root.active ? #8cc2ff : Theme.text-primary;
                font-size: Theme.font-size-sm;
                font-weight: root.active ? 600 : 400;
            }
            if root.subtitle != "" : Text {
                text: root.subtitle;
                color: root.active ? #4a7baa : Theme.text-faint;
                font-size: Theme.font-size-xs;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.pressed(); }
    }
}

// ── ModifyCard ─────────────────────────────────────────────
// Rounded container card for grouped controls.

component ModifyCard inherits Rectangle {
    border-radius: 10px;
    background: Theme.surface-panel;
    border-width: 1px;
    border-color: #132031;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        alignment: start;

        @children
    }
}


// ═══════════════════════════════════════════════════════════
//  Main panel
// ═══════════════════════════════════════════════════════════

export component ModifyPanel inherits Rectangle {
    // ── MIDI loading ──
    in property <MidiLoadState> midi-state: no-midi;
    in property <string> selected-midi-name: "";
    in property <string> loading-status: "Loading…";
    in property <float> loading-progress: 0;
    in property <string> load-error: "";

    // ── Pass metadata ──
    in property <string> modify-pass-key-text: "quantize";
    in property <string> modify-pass-title-text: "Quantize";
    in property <string> modify-pass-description-text: "";
    in property <string> modify-pass-hint-text: "";

    // ── Config / job state ──
    in property <string> modify-config-text: "";
    in property <bool> modify-config-valid: true;
    in property <string> modify-config-status-text: "Ready";
    in property <string> modify-output-path-text: "";
    in property <float> modify-progress: 0;
    in property <bool> modify-job-active: false;
    in property <string> modify-status-text: "Ready";
    in property <string> modify-detail-text: "";

    // ── Result ──
    in property <string> modify-result-output-text: "output.mid";
    in property <string> modify-result-input-count-text: "—";
    in property <string> modify-result-track-count-text: "—";
    in property <string> modify-result-ppq-text: "—";
    in property <string> modify-result-event-count-text: "—";

    // ── Pass: range select ──
    in property <string> modify-range-track-select-text: "";
    in property <string> modify-range-start-ticks-text: "";
    in property <string> modify-range-end-ticks-text: "";
    in property <string> modify-range-offset-ticks-text: "";
    in property <string> modify-range-preserve-system-text: "off";
    in property <string> modify-range-edge-behavior-text: "trim";

    // ── Pass: tempo ──
    in property <string> modify-tempo-mode-text: "scale_bpm";
    in property <string> modify-tempo-flatten-tempo-text: "500000";
    in property <string> modify-tempo-scale-factor-text: "1.0";
    in property <string> modify-tempo-replace-points-text: "";

    // ── Pass: time warp, channel remap ──
    in property <string> modify-time-warp-points-text: "";
    in property <string> modify-channel-remap-mappings-text: "";

    // ── Pass: track route ──
    in property <string> modify-track-route-mode-text: "collapse_all";
    in property <string> modify-track-route-mappings-text: "";

    // ── Pass: program ──
    in property <string> modify-program-force-program-text: "";
    in property <string> modify-program-strip-changes-text: "off";
    in property <string> modify-program-startup-programs-text: "";

    // ── Pass: control change ──
    in property <string> modify-control-strip-controllers-text: "";
    in property <string> modify-control-remap-controllers-text: "";
    in property <string> modify-control-scale-controllers-text: "";
    in property <string> modify-control-inject-start-text: "";

    // ── Pass: pitch bend ──
    in property <string> modify-pitch-strip-text: "off";
    in property <string> modify-pitch-scale-text: "1.0";
    in property <string> modify-pitch-offset-text: "0";
    in property <string> modify-pitch-min-bend-text: "-8192";
    in property <string> modify-pitch-max-bend-text: "8191";

    // ── Pass: velocity map ──
    in property <string> modify-velocity-mode-text: "scale";
    in property <string> modify-velocity-scale-text: "1.0";
    in property <string> modify-velocity-gamma-text: "1.0";
    in property <string> modify-velocity-points-text: "";

    // ── Pass: note length ──
    in property <string> modify-note-length-min-ticks-text: "";
    in property <string> modify-note-length-max-ticks-text: "";
    in property <string> modify-note-length-scale-text: "1.0";
    in property <string> modify-note-length-fixed-ticks-text: "";

    // ── Pass: quantize ──
    in property <string> modify-quantize-grid-ticks-text: "120";
    in property <string> modify-quantize-mode-text: "note_start_only";

    // ── Pass: humanize ──
    in property <string> modify-humanize-start-jitter-text: "8";
    in property <string> modify-humanize-length-jitter-text: "6";
    in property <string> modify-humanize-velocity-jitter-text: "5";
    in property <string> modify-humanize-seed-text: "1";
    in property <string> modify-humanize-collision-mode-text: "stable";

    // ── Pass: key map ──
    in property <string> modify-key-map-mappings-text: "";
    in property <string> modify-key-map-fold-range-text: "";
    in property <string> modify-key-map-drop-unmapped-text: "off";

    // ── Pass: meta text ──
    in property <string> modify-meta-keep-kinds-text: "";

    // ── Pass: sysex ──
    in property <string> modify-sysex-strip-all-text: "off";
    in property <string> modify-sysex-prepend-text: "";

    // ── Pass: change ppq ──
    in property <string> modify-change-ppq-text: "480";

    // ── Pass: extract track ──
    in property <string> modify-extract-track-index-text: "0";

    // ── Pass: shared metadata track ──
    in property <string> modify-shared-dest-mode-text: "create_new";
    in property <string> modify-shared-dest-track-text: "0";
    in property <string> modify-shared-strip-redundant-text: "off";
    in property <string> modify-shared-move-tempo-text: "on";
    in property <string> modify-shared-move-time-sig-text: "on";
    in property <string> modify-shared-move-key-sig-text: "on";
    in property <string> modify-shared-move-text-text: "off";
    in property <string> modify-shared-move-unknown-meta-text: "off";
    in property <string> modify-shared-move-channel-prefix-text: "off";
    in property <string> modify-shared-move-midi-port-text: "off";
    in property <string> modify-shared-move-cc-text: "off";
    in property <string> modify-shared-move-program-text: "off";
    in property <string> modify-shared-move-pitch-bend-text: "off";
    in property <string> modify-shared-move-channel-pressure-text: "off";

    // ── Reference analytics (cheap subset) ──
    in property <string> analysis-note-count-text: "—";
    in property <string> analysis-track-count-text: "—";
    in property <string> analysis-midi-length-text: "—";
    in property <string> analysis-tempo-text: "—";
    in property <string> analysis-key-range-text: "—";
    in property <string> analysis-avg-velocity-text: "—";
    in property <string> analysis-note-density-text: "—";
    in property <string> analysis-total-events-text: "—";
    in property <string> analysis-ticks-per-quarter-text: "—";

    // ── Callbacks ──
    callback select-file;
    callback load-midi;
    callback cancel-load;
    callback unload-midi;
    callback retry-load;
    callback select-pass(string);
    callback update-control(string, string);
    callback edit-config(string);
    callback reset-config;
    callback browse-output;
    callback start-job;
    callback cancel-job;

    // ── Derived / private ──
    private property <bool> has-midi: root.selected-midi-name != "";
    private property <bool> has-output: root.modify-output-path-text != "";
    private property <bool> start-enabled:
        root.has-midi && root.has-output && root.modify-config-valid && !root.modify-job-active;
    private property <bool> is-custom: root.modify-pass-key-text == "custom";
    private property <bool> advanced-open: false;

    // ── Preset detection helpers ──
    private property <bool> grid-is-preset:
        root.modify-quantize-grid-ticks-text == "0.0625"
        || root.modify-quantize-grid-ticks-text == "0.125"
        || root.modify-quantize-grid-ticks-text == "0.25"
        || root.modify-quantize-grid-ticks-text == "0.5"
        || root.modify-quantize-grid-ticks-text == "1";

    private property <bool> start-jitter-is-preset:
        root.modify-humanize-start-jitter-text == "0"
        || root.modify-humanize-start-jitter-text == "0.005"
        || root.modify-humanize-start-jitter-text == "0.01"
        || root.modify-humanize-start-jitter-text == "0.02";

    private property <bool> length-jitter-is-preset:
        root.modify-humanize-length-jitter-text == "0"
        || root.modify-humanize-length-jitter-text == "0.005"
        || root.modify-humanize-length-jitter-text == "0.01"
        || root.modify-humanize-length-jitter-text == "0.02";

    private property <bool> vel-jitter-is-preset:
        root.modify-humanize-velocity-jitter-text == "0"
        || root.modify-humanize-velocity-jitter-text == "5"
        || root.modify-humanize-velocity-jitter-text == "10"
        || root.modify-humanize-velocity-jitter-text == "20";

    private property <bool> note-scale-is-preset:
        root.modify-note-length-scale-text == "0.5"
        || root.modify-note-length-scale-text == "1.0"
        || root.modify-note-length-scale-text == "2.0";

    private property <bool> vel-scale-is-preset:
        root.modify-velocity-scale-text == "0.5"
        || root.modify-velocity-scale-text == "1.0"
        || root.modify-velocity-scale-text == "2.0";

    private property <bool> vel-gamma-is-preset:
        root.modify-velocity-gamma-text == "0.5"
        || root.modify-velocity-gamma-text == "1.0"
        || root.modify-velocity-gamma-text == "2.0";

    private property <bool> tempo-factor-is-preset:
        root.modify-tempo-scale-factor-text == "0.5"
        || root.modify-tempo-scale-factor-text == "1.0"
        || root.modify-tempo-scale-factor-text == "2.0";

    private property <bool> pitch-scale-is-preset:
        root.modify-pitch-scale-text == "0.5"
        || root.modify-pitch-scale-text == "1.0"
        || root.modify-pitch-scale-text == "2.0";

    private property <bool> ppq-is-preset:
        root.modify-change-ppq-text == "96"
        || root.modify-change-ppq-text == "120"
        || root.modify-change-ppq-text == "240"
        || root.modify-change-ppq-text == "480"
        || root.modify-change-ppq-text == "960";

    clip: true;

    Flickable {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            width: parent.width;
            padding: 20px;
            padding-right: 24px;
            alignment: start;

            VerticalLayout {
                spacing: 8px;

                // ══════════════════════════════════════
                //  1 · MIDI FILE LOADING
                // ══════════════════════════════════════

                MidiStateSection {
                    midi-state: root.midi-state;
                    file-name: root.selected-midi-name;
                    load-description: "Parses MIDI data for the modify workflow. Processing writes a separate file — the source is never touched.";
                    load-label: "Load for Modify";
                    mode-label: "modify";
                    show-unload: true;
                    loading-status: root.loading-status;
                    loading-progress: root.loading-progress;
                    error-message: root.load-error;
                    select-file => { root.select-file(); }
                    load => { root.load-midi(); }
                    cancel-load => { root.cancel-load(); }
                    unload => { root.unload-midi(); }
                    retry-load => { root.retry-load(); }
                }

                // ── Source file quick-reference strip ──
                if root.has-midi && root.analysis-note-count-text != "—" : Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: Theme.surface-card;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 16px;
                        alignment: center;

                        HorizontalLayout {
                            spacing: 4px;
                            Text { text: "Notes"; color: Theme.text-faint; font-size: Theme.font-size-xs; font-weight: 600; vertical-alignment: center; }
                            Text { text: root.analysis-note-count-text; color: Theme.text-secondary; font-size: Theme.font-size-xs; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            Text { text: "Tracks"; color: Theme.text-faint; font-size: Theme.font-size-xs; font-weight: 600; vertical-alignment: center; }
                            Text { text: root.analysis-track-count-text; color: Theme.text-secondary; font-size: Theme.font-size-xs; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            Text { text: "PPQ"; color: Theme.text-faint; font-size: Theme.font-size-xs; font-weight: 600; vertical-alignment: center; }
                            Text { text: root.analysis-ticks-per-quarter-text; color: Theme.text-secondary; font-size: Theme.font-size-xs; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            Text { text: "Length"; color: Theme.text-faint; font-size: Theme.font-size-xs; font-weight: 600; vertical-alignment: center; }
                            Text { text: root.analysis-midi-length-text; color: Theme.text-secondary; font-size: Theme.font-size-xs; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; }
                        }
                    }
                }
            }

            Rectangle { height: 16px; }
            Separator { }
            Rectangle { height: 16px; }

            // ══════════════════════════════════════
            //  2 · PASS LIBRARY
            // ══════════════════════════════════════

            SectionHeader { title: "SELECT A PASS"; }
            Rectangle { height: 4px; }
            Text {
                text: "Choose a modifier to configure. Each pass transforms the MIDI in a specific way.";
                color: Theme.text-muted;
                font-size: Theme.font-size-sm;
                wrap: word-wrap;
            }
            Rectangle { height: 10px; }

            ModifyCard {
                GridLayout {
                    spacing: 4px;

                    // ── Timing + Grid ──
                    Row { Text { colspan: 2; text: "TIMING + GRID"; color: Theme.text-faint; font-size: Theme.font-size-xs; font-weight: 700; letter-spacing: Theme.tracking-wide; } }
                    Row { ModifyPassItem { label: "Range Select"; subtitle: "Extract a time range.";              active: root.modify-pass-key-text == "range_select"; pressed => { root.select-pass("range_select"); } }
                          ModifyPassItem { label: "Tempo Map";    subtitle: "Flatten, scale, or replace tempo.";  active: root.modify-pass-key-text == "tempo_map";    pressed => { root.select-pass("tempo_map"); } } }
                    Row { ModifyPassItem { label: "Time Warp";    subtitle: "Remap ticks via a piecewise curve."; active: root.modify-pass-key-text == "time_warp";    pressed => { root.select-pass("time_warp"); } }
                          ModifyPassItem { label: "Quantize";     subtitle: "Snap timing to a rhythmic grid.";    active: root.modify-pass-key-text == "quantize";     pressed => { root.select-pass("quantize"); } } }
                    Row { ModifyPassItem { label: "Humanize";     subtitle: "Add deterministic jitter.";           active: root.modify-pass-key-text == "humanize";     pressed => { root.select-pass("humanize"); } }
                          ModifyPassItem { label: "Note Length";  subtitle: "Scale, clamp, or fix durations.";    active: root.modify-pass-key-text == "note_length";  pressed => { root.select-pass("note_length"); } } }

                    Row { Rectangle { colspan: 2; height: 4px; } }
                    Row { Separator  { colspan: 2; } }
                    Row { Rectangle { colspan: 2; height: 4px; } }

                    // ── Routing + Dynamics ──
                    Row { Text { colspan: 2; text: "ROUTING + DYNAMICS"; color: Theme.text-faint; font-size: Theme.font-size-xs; font-weight: 700; letter-spacing: Theme.tracking-wide; } }
                    Row { ModifyPassItem { label: "Channel Remap"; subtitle: "Rewrite channel numbers.";        active: root.modify-pass-key-text == "channel_remap"; pressed => { root.select-pass("channel_remap"); } }
                          ModifyPassItem { label: "Track Route";   subtitle: "Collapse, split, or map tracks.";  active: root.modify-pass-key-text == "track_route";   pressed => { root.select-pass("track_route"); } } }
                    Row { ModifyPassItem { label: "Key Map";       subtitle: "Remap pitches, fold, or drop.";    active: root.modify-pass-key-text == "key_map";       pressed => { root.select-pass("key_map"); } }
                          ModifyPassItem { label: "Velocity Map";  subtitle: "Scale, gamma-shape, or redraw.";   active: root.modify-pass-key-text == "velocity_map";  pressed => { root.select-pass("velocity_map"); } } }
                    Row { ModifyPassItem { label: "Pitch Bend";    subtitle: "Scale, offset, clamp, or strip.";  active: root.modify-pass-key-text == "pitch_bend";    pressed => { root.select-pass("pitch_bend"); } }
                          ModifyPassItem { label: "Program";       subtitle: "Strip, force, or inject changes."; active: root.modify-pass-key-text == "program";       pressed => { root.select-pass("program"); } } }

                    Row { Rectangle { colspan: 2; height: 4px; } }
                    Row { Separator  { colspan: 2; } }
                    Row { Rectangle { colspan: 2; height: 4px; } }

                    // ── Structure + Cleanup ──
                    Row { Text { colspan: 2; text: "STRUCTURE + CLEANUP"; color: Theme.text-faint; font-size: Theme.font-size-xs; font-weight: 700; letter-spacing: Theme.tracking-wide; } }
                    Row { ModifyPassItem { label: "Control Change";  subtitle: "Strip, remap, scale, or inject CC.";  active: root.modify-pass-key-text == "control_change";        pressed => { root.select-pass("control_change"); } }
                          ModifyPassItem { label: "Extract Track";   subtitle: "Write one track to a new file.";       active: root.modify-pass-key-text == "extract_track";         pressed => { root.select-pass("extract_track"); } } }
                    Row { ModifyPassItem { label: "Change PPQ";      subtitle: "Resample ticks to a new PPQ.";         active: root.modify-pass-key-text == "change_ppq";            pressed => { root.select-pass("change_ppq"); } }
                          ModifyPassItem { label: "Meta Text";       subtitle: "Keep only chosen text event kinds.";   active: root.modify-pass-key-text == "meta_text";             pressed => { root.select-pass("meta_text"); } } }
                    Row { ModifyPassItem { label: "Sysex";           subtitle: "Strip SysEx or prepend device msgs."; active: root.modify-pass-key-text == "sysex";                 pressed => { root.select-pass("sysex"); } }
                          ModifyPassItem { label: "Shared Metadata"; subtitle: "Centralise metadata into one track."; active: root.modify-pass-key-text == "shared_metadata_track"; pressed => { root.select-pass("shared_metadata_track"); } } }
                }
            }

            Rectangle { height: 16px; }
            Separator { }
            Rectangle { height: 16px; }

            // ══════════════════════════════════════
            //  3 · PASS SETTINGS
            // ══════════════════════════════════════

            ModifyCard {
                // ── Card header ──
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: root.modify-pass-title-text;
                        color: #e4eefc;
                        font-size: Theme.font-size-2xl;
                        font-weight: 700;
                        horizontal-stretch: 1;
                    }

                    StatusBadge {
                        label: root.modify-config-valid ? "Config OK" : "Error";
                        active: root.modify-config-valid;
                    }
                }

                if root.modify-pass-description-text != "" : Text {
                    text: root.modify-pass-description-text;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-md;
                    wrap: word-wrap;
                }

                if root.is-custom : Text {
                    text: "JSON contains a custom pipeline. Pick a pass above to use the structured controls.";
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-md;
                    wrap: word-wrap;
                }

                // ────────────────────────────────
                //  range_select
                // ────────────────────────────────
                if root.modify-pass-key-text == "range_select" : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    InlineCustomRow {
                        label: "Track";
                        value: root.modify-range-track-select-text;
                        is-preset: root.modify-range-track-select-text == "";
                        custom-display: root.modify-range-track-select-text == "" ? "All" : root.modify-range-track-select-text;
                        custom-submitted(v) => { root.update-control("range.track_select", v); }
                        OptionChip { label: "All"; active: root.modify-range-track-select-text == ""; pressed => { root.update-control("range.track_select", ""); } }
                    }

                    InlineCustomRow {
                        label: "Start";
                        value: root.modify-range-start-ticks-text;
                        is-preset: false;
                        custom-submitted(v) => { root.update-control("range.start_ticks", v); }
                    }

                    InlineCustomRow {
                        label: "End";
                        value: root.modify-range-end-ticks-text;
                        is-preset: false;
                        custom-submitted(v) => { root.update-control("range.end_ticks", v); }
                    }

                    InlineCustomRow {
                        label: "Offset";
                        value: root.modify-range-offset-ticks-text;
                        is-preset: root.modify-range-offset-ticks-text == "";
                        custom-display: root.modify-range-offset-ticks-text == "" ? "Keep" : root.modify-range-offset-ticks-text;
                        custom-submitted(v) => { root.update-control("range.offset_ticks", v); }
                        OptionChip { label: "Keep"; active: root.modify-range-offset-ticks-text == ""; pressed => { root.update-control("range.offset_ticks", ""); } }
                    }

                    InlineOptionRow {
                        label: "System Events";
                        OptionChip { label: "Off"; active: root.modify-range-preserve-system-text == "off"; pressed => { root.update-control("range.preserve_system_events", "off"); } }
                        OptionChip { label: "Preserve"; active: root.modify-range-preserve-system-text == "on"; pressed => { root.update-control("range.preserve_system_events", "on"); } }
                    }

                    InlineOptionRow {
                        label: "Edge Behavior";
                        OptionChip { label: "Keep"; active: root.modify-range-edge-behavior-text == "keep"; pressed => { root.update-control("range.edge_behavior", "keep"); } }
                        OptionChip { label: "Skip"; active: root.modify-range-edge-behavior-text == "skip"; pressed => { root.update-control("range.edge_behavior", "skip"); } }
                        OptionChip { label: "Trim"; active: root.modify-range-edge-behavior-text == "trim"; pressed => { root.update-control("range.edge_behavior", "trim"); } }
                    }

                    Rectangle { height: 2px; }
                    Text {
                        text: "Track = zero-based index, blank = all tracks. Start/End = positions in full notes (1.0 = whole note, 0.25 = quarter note). Offset = shift all positions after extraction (blank = keep original). Keep = notes can extend past boundaries · Skip = drop boundary-crossing notes · Trim = clamp note edges to range.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                }

                // ────────────────────────────────
                //  tempo_map
                // ────────────────────────────────
                if root.modify-pass-key-text == "tempo_map" : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    InlineOptionRow {
                        label: "Mode";
                        OptionChip { label: "Scale BPM"; active: root.modify-tempo-mode-text == "scale_bpm"; pressed => { root.update-control("tempo.mode", "scale_bpm"); } }
                        OptionChip { label: "Flatten"; active: root.modify-tempo-mode-text == "flatten"; pressed => { root.update-control("tempo.mode", "flatten"); } }
                        OptionChip { label: "Replace"; active: root.modify-tempo-mode-text == "replace"; pressed => { root.update-control("tempo.mode", "replace"); } }
                    }

                    if root.modify-tempo-mode-text == "flatten" : InlineCustomRow {
                        label: "Tempo (μs/qn)";
                        value: root.modify-tempo-flatten-tempo-text;
                        is-preset: false;
                        custom-submitted(v) => { root.update-control("tempo.flatten_tempo", v); }
                    }
                    if root.modify-tempo-mode-text == "flatten" : Text {
                        text: "Microseconds per quarter note. 500000 = 120 BPM, 600000 = 100 BPM, 750000 = 80 BPM.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }

                    if root.modify-tempo-mode-text == "scale_bpm" : InlineCustomRow {
                        label: "Factor";
                        value: root.modify-tempo-scale-factor-text;
                        is-preset: root.tempo-factor-is-preset;
                        custom-submitted(v) => { root.update-control("tempo.scale_factor", v); }
                        OptionChip { label: "0.5×"; active: root.modify-tempo-scale-factor-text == "0.5"; pressed => { root.update-control("tempo.scale_factor", "0.5"); } }
                        OptionChip { label: "1.0×"; active: root.modify-tempo-scale-factor-text == "1.0"; pressed => { root.update-control("tempo.scale_factor", "1.0"); } }
                        OptionChip { label: "2.0×"; active: root.modify-tempo-scale-factor-text == "2.0"; pressed => { root.update-control("tempo.scale_factor", "2.0"); } }
                    }

                    if root.modify-tempo-mode-text == "replace" : InlineCustomRow {
                        label: "Points";
                        value: root.modify-tempo-replace-points-text;
                        is-preset: false;
                        custom-submitted(v) => { root.update-control("tempo.replace_points", v); }
                    }
                    if root.modify-tempo-mode-text == "replace" : Text {
                        text: "Comma-separated position:tempo pairs in full notes, e.g. 0:500000, 0.5:600000. Positions must be ascending.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                }

                // ────────────────────────────────
                //  time_warp
                // ────────────────────────────────
                if root.modify-pass-key-text == "time_warp" : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    InlineCustomRow {
                        label: "Warp Points";
                        value: root.modify-time-warp-points-text;
                        is-preset: false;
                        custom-submitted(v) => { root.update-control("time_warp.points", v); }
                    }

                    Text {
                        text: "Comma-separated source→dest full-note pairs, e.g. 0->0, 0.25->0.5, 1.0->0.75. Dest values must be monotonically increasing.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                }

                // ────────────────────────────────
                //  quantize
                // ────────────────────────────────
                if root.modify-pass-key-text == "quantize" : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    InlineCustomRow {
                        label: "Grid";
                        value: root.modify-quantize-grid-ticks-text;
                        is-preset: root.grid-is-preset;
                        custom-submitted(v) => { root.update-control("quantize.grid_ticks", v); }
                        OptionChip { label: "1/16"; active: root.modify-quantize-grid-ticks-text == "0.0625"; pressed => { root.update-control("quantize.grid_ticks", "0.0625"); } }
                        OptionChip { label: "1/8"; active: root.modify-quantize-grid-ticks-text == "0.125"; pressed => { root.update-control("quantize.grid_ticks", "0.125"); } }
                        OptionChip { label: "1/4"; active: root.modify-quantize-grid-ticks-text == "0.25"; pressed => { root.update-control("quantize.grid_ticks", "0.25"); } }
                        OptionChip { label: "1/2"; active: root.modify-quantize-grid-ticks-text == "0.5"; pressed => { root.update-control("quantize.grid_ticks", "0.5"); } }
                        OptionChip { label: "1"; active: root.modify-quantize-grid-ticks-text == "1"; pressed => { root.update-control("quantize.grid_ticks", "1"); } }
                    }

                    InlineOptionRow {
                        label: "Scope";
                        OptionChip { label: "Starts"; active: root.modify-quantize-mode-text == "note_start_only"; pressed => { root.update-control("quantize.mode", "note_start_only"); } }
                        OptionChip { label: "Start+End"; active: root.modify-quantize-mode-text == "note_start_and_end"; pressed => { root.update-control("quantize.mode", "note_start_and_end"); } }
                        OptionChip { label: "All Events"; active: root.modify-quantize-mode-text == "all_events"; pressed => { root.update-control("quantize.mode", "all_events"); } }
                    }

                    Text {
                        text: "Grid size in full notes. 0.25 = quarter note, 0.125 = eighth, 0.0625 = sixteenth, 1 = whole note.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                }

                // ────────────────────────────────
                //  humanize
                // ────────────────────────────────
                if root.modify-pass-key-text == "humanize" : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    InlineCustomRow {
                        label: "Start Jitter";
                        value: root.modify-humanize-start-jitter-text;
                        is-preset: root.start-jitter-is-preset;
                        custom-submitted(v) => { root.update-control("humanize.start_jitter", v); }
                        OptionChip { label: "0"; active: root.modify-humanize-start-jitter-text == "0"; pressed => { root.update-control("humanize.start_jitter", "0"); } }
                        OptionChip { label: "0.005"; active: root.modify-humanize-start-jitter-text == "0.005"; pressed => { root.update-control("humanize.start_jitter", "0.005"); } }
                        OptionChip { label: "0.01"; active: root.modify-humanize-start-jitter-text == "0.01"; pressed => { root.update-control("humanize.start_jitter", "0.01"); } }
                        OptionChip { label: "0.02"; active: root.modify-humanize-start-jitter-text == "0.02"; pressed => { root.update-control("humanize.start_jitter", "0.02"); } }
                    }

                    InlineCustomRow {
                        label: "Length Jitter";
                        value: root.modify-humanize-length-jitter-text;
                        is-preset: root.length-jitter-is-preset;
                        custom-submitted(v) => { root.update-control("humanize.length_jitter", v); }
                        OptionChip { label: "0"; active: root.modify-humanize-length-jitter-text == "0"; pressed => { root.update-control("humanize.length_jitter", "0"); } }
                        OptionChip { label: "0.005"; active: root.modify-humanize-length-jitter-text == "0.005"; pressed => { root.update-control("humanize.length_jitter", "0.005"); } }
                        OptionChip { label: "0.01"; active: root.modify-humanize-length-jitter-text == "0.01"; pressed => { root.update-control("humanize.length_jitter", "0.01"); } }
                        OptionChip { label: "0.02"; active: root.modify-humanize-length-jitter-text == "0.02"; pressed => { root.update-control("humanize.length_jitter", "0.02"); } }
                    }

                    InlineCustomRow {
                        label: "Velocity Jitter";
                        value: root.modify-humanize-velocity-jitter-text;
                        is-preset: root.vel-jitter-is-preset;
                        custom-submitted(v) => { root.update-control("humanize.velocity_jitter", v); }
                        OptionChip { label: "0"; active: root.modify-humanize-velocity-jitter-text == "0"; pressed => { root.update-control("humanize.velocity_jitter", "0"); } }
                        OptionChip { label: "5"; active: root.modify-humanize-velocity-jitter-text == "5"; pressed => { root.update-control("humanize.velocity_jitter", "5"); } }
                        OptionChip { label: "10"; active: root.modify-humanize-velocity-jitter-text == "10"; pressed => { root.update-control("humanize.velocity_jitter", "10"); } }
                        OptionChip { label: "20"; active: root.modify-humanize-velocity-jitter-text == "20"; pressed => { root.update-control("humanize.velocity_jitter", "20"); } }
                    }

                    InlineCustomRow {
                        label: "Seed";
                        value: root.modify-humanize-seed-text;
                        is-preset: false;
                        custom-submitted(v) => { root.update-control("humanize.seed", v); }
                    }

                    InlineOptionRow {
                        label: "Collision Mode";
                        OptionChip { label: "Stable"; active: root.modify-humanize-collision-mode-text == "stable"; pressed => { root.update-control("humanize.collision_mode", "stable"); } }
                        OptionChip { label: "By Track"; active: root.modify-humanize-collision-mode-text == "distinguish_by_track"; pressed => { root.update-control("humanize.collision_mode", "distinguish_by_track"); } }
                        OptionChip { label: "By Note"; active: root.modify-humanize-collision-mode-text == "distinguish_by_note"; pressed => { root.update-control("humanize.collision_mode", "distinguish_by_note"); } }
                    }

                    Text {
                        text: "Jitter values are in full notes (1.0 = whole note). Seed makes results reproducible. Stable = same-position notes stay aligned · By Track = they can differ across tracks · By Note = stacked notes can diverge.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                }

                // ────────────────────────────────
                //  note_length
                // ────────────────────────────────
                if root.modify-pass-key-text == "note_length" : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    InlineCustomRow {
                        label: "Scale";
                        value: root.modify-note-length-scale-text;
                        is-preset: root.note-scale-is-preset;
                        custom-submitted(v) => { root.update-control("note_length.scale", v); }
                        OptionChip { label: "0.5×"; active: root.modify-note-length-scale-text == "0.5"; pressed => { root.update-control("note_length.scale", "0.5"); } }
                        OptionChip { label: "1.0×"; active: root.modify-note-length-scale-text == "1.0"; pressed => { root.update-control("note_length.scale", "1.0"); } }
                        OptionChip { label: "2.0×"; active: root.modify-note-length-scale-text == "2.0"; pressed => { root.update-control("note_length.scale", "2.0"); } }
                    }

                    InlineCustomRow {
                        label: "Fixed Length";
                        value: root.modify-note-length-fixed-ticks-text;
                        is-preset: root.modify-note-length-fixed-ticks-text == "";
                        custom-display: root.modify-note-length-fixed-ticks-text == "" ? "Off" : root.modify-note-length-fixed-ticks-text;
                        custom-submitted(v) => { root.update-control("note_length.fixed_ticks", v); }
                        OptionChip { label: "Off"; active: root.modify-note-length-fixed-ticks-text == ""; pressed => { root.update-control("note_length.fixed_ticks", ""); } }
                    }

                    InlineCustomRow {
                        label: "Minimum";
                        value: root.modify-note-length-min-ticks-text;
                        is-preset: root.modify-note-length-min-ticks-text == "";
                        custom-display: root.modify-note-length-min-ticks-text == "" ? "Off" : root.modify-note-length-min-ticks-text;
                        custom-submitted(v) => { root.update-control("note_length.min_ticks", v); }
                        OptionChip { label: "Off"; active: root.modify-note-length-min-ticks-text == ""; pressed => { root.update-control("note_length.min_ticks", ""); } }
                    }

                    InlineCustomRow {
                        label: "Maximum";
                        value: root.modify-note-length-max-ticks-text;
                        is-preset: root.modify-note-length-max-ticks-text == "";
                        custom-display: root.modify-note-length-max-ticks-text == "" ? "Off" : root.modify-note-length-max-ticks-text;
                        custom-submitted(v) => { root.update-control("note_length.max_ticks", v); }
                        OptionChip { label: "Off"; active: root.modify-note-length-max-ticks-text == ""; pressed => { root.update-control("note_length.max_ticks", ""); } }
                    }

                    Text {
                        text: "Length values in full notes (0.25 = quarter note). Fixed length overrides scale. Clamps apply after both. Does not move note starts.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                }

                // ────────────────────────────────
                //  channel_remap
                // ────────────────────────────────
                if root.modify-pass-key-text == "channel_remap" : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    InlineCustomRow {
                        label: "Mappings";
                        value: root.modify-channel-remap-mappings-text;
                        is-preset: false;
                        custom-submitted(v) => { root.update-control("channel_remap.mappings", v); }
                    }

                    Text {
                        text: "Comma-separated from→to channel pairs, e.g. 0->1, 9->15. Channels are zero-based (0-15). Duplicate source channels are not allowed.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                }

                // ────────────────────────────────
                //  track_route
                // ────────────────────────────────
                if root.modify-pass-key-text == "track_route" : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    InlineOptionRow {
                        label: "Mode";
                        OptionChip { label: "Collapse All"; active: root.modify-track-route-mode-text == "collapse_all"; pressed => { root.update-control("track_route.mode", "collapse_all"); } }
                        OptionChip { label: "Split by Ch"; active: root.modify-track-route-mode-text == "split_by_channel"; pressed => { root.update-control("track_route.mode", "split_by_channel"); } }
                        OptionChip { label: "Map"; active: root.modify-track-route-mode-text == "map"; pressed => { root.update-control("track_route.mode", "map"); } }
                    }

                    if root.modify-track-route-mode-text == "map" : InlineCustomRow {
                        label: "Mappings";
                        value: root.modify-track-route-mappings-text;
                        is-preset: false;
                        custom-submitted(v) => { root.update-control("track_route.mappings", v); }
                    }

                    if root.modify-track-route-mode-text == "collapse_all" : Text {
                        text: "Merges every source track into a single output track.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                    if root.modify-track-route-mode-text == "split_by_channel" : Text {
                        text: "Creates one track per MIDI channel. Non-channel events go to a dedicated bucket track.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                    if root.modify-track-route-mode-text == "map" : Text {
                        text: "Comma-separated source→target track pairs, e.g. 0->0, 1->0, 2->1. Sources mapped to the same target are merged.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                }

                // ────────────────────────────────
                //  key_map
                // ────────────────────────────────
                if root.modify-pass-key-text == "key_map" : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    InlineCustomRow {
                        label: "Mappings";
                        value: root.modify-key-map-mappings-text;
                        is-preset: false;
                        custom-submitted(v) => { root.update-control("key_map.mappings", v); }
                    }

                    InlineCustomRow {
                        label: "Fold to Range";
                        value: root.modify-key-map-fold-range-text;
                        is-preset: root.modify-key-map-fold-range-text == "";
                        custom-display: root.modify-key-map-fold-range-text == "" ? "Off" : root.modify-key-map-fold-range-text;
                        custom-submitted(v) => { root.update-control("key_map.fold_range", v); }
                        OptionChip { label: "Off"; active: root.modify-key-map-fold-range-text == ""; pressed => { root.update-control("key_map.fold_range", ""); } }
                    }

                    InlineOptionRow {
                        label: "Drop Unmapped";
                        OptionChip { label: "Off"; active: root.modify-key-map-drop-unmapped-text == "off"; pressed => { root.update-control("key_map.drop_unmapped", "off"); } }
                        OptionChip { label: "On"; active: root.modify-key-map-drop-unmapped-text == "on"; pressed => { root.update-control("key_map.drop_unmapped", "on"); } }
                    }

                    Text {
                        text: "Mappings = comma-separated from→to MIDI key pairs, e.g. 60->72, 61->73. Fold range = min-max, e.g. 48-72. Explicit mappings take precedence, then fold wraps remaining notes. Drop unmapped removes anything still unmatched.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                }

                // ────────────────────────────────
                //  velocity_map
                // ────────────────────────────────
                if root.modify-pass-key-text == "velocity_map" : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    InlineOptionRow {
                        label: "Mode";
                        OptionChip { label: "Scale"; active: root.modify-velocity-mode-text == "scale"; pressed => { root.update-control("velocity_map.mode", "scale"); } }
                        OptionChip { label: "Gamma"; active: root.modify-velocity-mode-text == "gamma"; pressed => { root.update-control("velocity_map.mode", "gamma"); } }
                        OptionChip { label: "Polyline"; active: root.modify-velocity-mode-text == "polyline"; pressed => { root.update-control("velocity_map.mode", "polyline"); } }
                    }

                    if root.modify-velocity-mode-text == "scale" : InlineCustomRow {
                        label: "Scale";
                        value: root.modify-velocity-scale-text;
                        is-preset: root.vel-scale-is-preset;
                        custom-submitted(v) => { root.update-control("velocity_map.scale", v); }
                        OptionChip { label: "0.5×"; active: root.modify-velocity-scale-text == "0.5"; pressed => { root.update-control("velocity_map.scale", "0.5"); } }
                        OptionChip { label: "1.0×"; active: root.modify-velocity-scale-text == "1.0"; pressed => { root.update-control("velocity_map.scale", "1.0"); } }
                        OptionChip { label: "2.0×"; active: root.modify-velocity-scale-text == "2.0"; pressed => { root.update-control("velocity_map.scale", "2.0"); } }
                    }

                    if root.modify-velocity-mode-text == "gamma" : InlineCustomRow {
                        label: "Gamma";
                        value: root.modify-velocity-gamma-text;
                        is-preset: root.vel-gamma-is-preset;
                        custom-submitted(v) => { root.update-control("velocity_map.gamma", v); }
                        OptionChip { label: "0.5"; active: root.modify-velocity-gamma-text == "0.5"; pressed => { root.update-control("velocity_map.gamma", "0.5"); } }
                        OptionChip { label: "1.0"; active: root.modify-velocity-gamma-text == "1.0"; pressed => { root.update-control("velocity_map.gamma", "1.0"); } }
                        OptionChip { label: "2.0"; active: root.modify-velocity-gamma-text == "2.0"; pressed => { root.update-control("velocity_map.gamma", "2.0"); } }
                    }

                    if root.modify-velocity-mode-text == "polyline" : InlineCustomRow {
                        label: "Points";
                        value: root.modify-velocity-points-text;
                        is-preset: false;
                        custom-submitted(v) => { root.update-control("velocity_map.points", v); }
                    }

                    Text {
                        text: root.modify-velocity-mode-text == "polyline"
                            ? "Comma-separated input:output velocity pairs, e.g. 0:0, 64:100, 127:127. Values clamped to 0-127."
                            : "Velocities are clamped to MIDI range (0-127) after transformation. Gamma < 1 boosts quiet notes, > 1 boosts loud notes.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                }

                // ────────────────────────────────
                //  pitch_bend
                // ────────────────────────────────
                if root.modify-pass-key-text == "pitch_bend" : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    InlineOptionRow {
                        label: "Strip All";
                        OptionChip { label: "Off"; active: root.modify-pitch-strip-text == "off"; pressed => { root.update-control("pitch_bend.strip", "off"); } }
                        OptionChip { label: "Strip"; active: root.modify-pitch-strip-text == "on"; pressed => { root.update-control("pitch_bend.strip", "on"); } }
                    }

                    InlineCustomRow {
                        label: "Scale";
                        value: root.modify-pitch-scale-text;
                        is-preset: root.pitch-scale-is-preset;
                        custom-submitted(v) => { root.update-control("pitch_bend.scale", v); }
                        OptionChip { label: "0.5×"; active: root.modify-pitch-scale-text == "0.5"; pressed => { root.update-control("pitch_bend.scale", "0.5"); } }
                        OptionChip { label: "1.0×"; active: root.modify-pitch-scale-text == "1.0"; pressed => { root.update-control("pitch_bend.scale", "1.0"); } }
                        OptionChip { label: "2.0×"; active: root.modify-pitch-scale-text == "2.0"; pressed => { root.update-control("pitch_bend.scale", "2.0"); } }
                    }

                    InlineCustomRow {
                        label: "Offset";
                        value: root.modify-pitch-offset-text;
                        is-preset: root.modify-pitch-offset-text == "0";
                        custom-submitted(v) => { root.update-control("pitch_bend.offset", v); }
                        OptionChip { label: "0"; active: root.modify-pitch-offset-text == "0"; pressed => { root.update-control("pitch_bend.offset", "0"); } }
                    }

                    InlineCustomRow {
                        label: "Min Bend";
                        value: root.modify-pitch-min-bend-text;
                        is-preset: root.modify-pitch-min-bend-text == "-8192";
                        custom-submitted(v) => { root.update-control("pitch_bend.min_bend", v); }
                        OptionChip { label: "-8192"; active: root.modify-pitch-min-bend-text == "-8192"; pressed => { root.update-control("pitch_bend.min_bend", "-8192"); } }
                    }

                    InlineCustomRow {
                        label: "Max Bend";
                        value: root.modify-pitch-max-bend-text;
                        is-preset: root.modify-pitch-max-bend-text == "8191";
                        custom-submitted(v) => { root.update-control("pitch_bend.max_bend", v); }
                        OptionChip { label: "8191"; active: root.modify-pitch-max-bend-text == "8191"; pressed => { root.update-control("pitch_bend.max_bend", "8191"); } }
                    }

                    Text {
                        text: "When strip is on, all other controls are ignored. Transform pipeline: scale → offset → clamp. Range: -8192 to 8191 (14-bit MIDI bend).";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                }

                // ────────────────────────────────
                //  program
                // ────────────────────────────────
                if root.modify-pass-key-text == "program" : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    InlineOptionRow {
                        label: "Strip Changes";
                        OptionChip { label: "Off"; active: root.modify-program-strip-changes-text == "off"; pressed => { root.update-control("program.strip_program_changes", "off"); } }
                        OptionChip { label: "Strip"; active: root.modify-program-strip-changes-text == "on"; pressed => { root.update-control("program.strip_program_changes", "on"); } }
                    }

                    InlineCustomRow {
                        label: "Force Program";
                        value: root.modify-program-force-program-text;
                        is-preset: root.modify-program-force-program-text == "";
                        custom-display: root.modify-program-force-program-text == "" ? "None" : root.modify-program-force-program-text;
                        custom-submitted(v) => { root.update-control("program.force_program", v); }
                        OptionChip { label: "None"; active: root.modify-program-force-program-text == ""; pressed => { root.update-control("program.force_program", ""); } }
                    }

                    InlineCustomRow {
                        label: "Startup Programs";
                        value: root.modify-program-startup-programs-text;
                        is-preset: root.modify-program-startup-programs-text == "";
                        custom-display: root.modify-program-startup-programs-text == "" ? "None" : root.modify-program-startup-programs-text;
                        custom-submitted(v) => { root.update-control("program.startup_programs", v); }
                        OptionChip { label: "None"; active: root.modify-program-startup-programs-text == ""; pressed => { root.update-control("program.startup_programs", ""); } }
                    }

                    Text {
                        text: "Force program = 0-127 GM program number applied to all channels. Startup = comma-separated ch:program pairs, e.g. 0:0, 9:128. Strip removes existing program change events.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                }

                // ────────────────────────────────
                //  control_change
                // ────────────────────────────────
                if root.modify-pass-key-text == "control_change" : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    Text { text: "STRIP"; color: Theme.text-faint; font-size: Theme.font-size-xs; font-weight: 700; letter-spacing: Theme.tracking-tight; }

                    InlineCustomRow {
                        label: "Controllers";
                        value: root.modify-control-strip-controllers-text;
                        is-preset: root.modify-control-strip-controllers-text == "";
                        custom-display: root.modify-control-strip-controllers-text == "" ? "None" : root.modify-control-strip-controllers-text;
                        custom-submitted(v) => { root.update-control("control_change.strip_controllers", v); }
                        OptionChip { label: "None"; active: root.modify-control-strip-controllers-text == ""; pressed => { root.update-control("control_change.strip_controllers", ""); } }
                    }

                    Rectangle { height: 2px; }
                    Text { text: "REMAP"; color: Theme.text-faint; font-size: Theme.font-size-xs; font-weight: 700; letter-spacing: Theme.tracking-tight; }

                    InlineCustomRow {
                        label: "Controllers";
                        value: root.modify-control-remap-controllers-text;
                        is-preset: root.modify-control-remap-controllers-text == "";
                        custom-display: root.modify-control-remap-controllers-text == "" ? "None" : root.modify-control-remap-controllers-text;
                        custom-submitted(v) => { root.update-control("control_change.remap_controllers", v); }
                        OptionChip { label: "None"; active: root.modify-control-remap-controllers-text == ""; pressed => { root.update-control("control_change.remap_controllers", ""); } }
                    }

                    Rectangle { height: 2px; }
                    Text { text: "SCALE"; color: Theme.text-faint; font-size: Theme.font-size-xs; font-weight: 700; letter-spacing: Theme.tracking-tight; }

                    InlineCustomRow {
                        label: "Controllers";
                        value: root.modify-control-scale-controllers-text;
                        is-preset: root.modify-control-scale-controllers-text == "";
                        custom-display: root.modify-control-scale-controllers-text == "" ? "None" : root.modify-control-scale-controllers-text;
                        custom-submitted(v) => { root.update-control("control_change.scale_controllers", v); }
                        OptionChip { label: "None"; active: root.modify-control-scale-controllers-text == ""; pressed => { root.update-control("control_change.scale_controllers", ""); } }
                    }

                    Rectangle { height: 2px; }
                    Text { text: "STARTUP INJECTION"; color: Theme.text-faint; font-size: Theme.font-size-xs; font-weight: 700; letter-spacing: Theme.tracking-tight; }

                    InlineCustomRow {
                        label: "Initial State";
                        value: root.modify-control-inject-start-text;
                        is-preset: root.modify-control-inject-start-text == "";
                        custom-display: root.modify-control-inject-start-text == "" ? "None" : root.modify-control-inject-start-text;
                        custom-submitted(v) => { root.update-control("control_change.inject_start", v); }
                        OptionChip { label: "None"; active: root.modify-control-inject-start-text == ""; pressed => { root.update-control("control_change.inject_start", ""); } }
                    }

                    Text {
                        text: "Strip = comma-separated CC numbers, e.g. 64, 11. Remap = from→to pairs, e.g. 1->11, 7->11. Scale = cc:factor pairs, e.g. 7:0.8, 11:1.2. Inject = ch:cc=val triples, e.g. 0:7=100, 0:10=64.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                }

                // ────────────────────────────────
                //  extract_track
                // ────────────────────────────────
                if root.modify-pass-key-text == "extract_track" : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    InlineCustomRow {
                        label: "Track Index";
                        value: root.modify-extract-track-index-text;
                        is-preset: false;
                        custom-submitted(v) => { root.update-control("extract_track.track_index", v); }
                    }

                    Text {
                        text: "Zero-based track index. Emits a new single-track MIDI containing only the selected track's events plus any track-0 metadata.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                }

                // ────────────────────────────────
                //  change_ppq
                // ────────────────────────────────
                if root.modify-pass-key-text == "change_ppq" : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    InlineCustomRow {
                        label: "Target PPQ";
                        value: root.modify-change-ppq-text;
                        is-preset: root.ppq-is-preset;
                        custom-submitted(v) => { root.update-control("change_ppq.ppq", v); }
                        OptionChip { label: "96"; active: root.modify-change-ppq-text == "96"; pressed => { root.update-control("change_ppq.ppq", "96"); } }
                        OptionChip { label: "120"; active: root.modify-change-ppq-text == "120"; pressed => { root.update-control("change_ppq.ppq", "120"); } }
                        OptionChip { label: "240"; active: root.modify-change-ppq-text == "240"; pressed => { root.update-control("change_ppq.ppq", "240"); } }
                        OptionChip { label: "480"; active: root.modify-change-ppq-text == "480"; pressed => { root.update-control("change_ppq.ppq", "480"); } }
                        OptionChip { label: "960"; active: root.modify-change-ppq-text == "960"; pressed => { root.update-control("change_ppq.ppq", "960"); } }
                    }

                    Text {
                        text: "Pulses per quarter note. Higher values = finer tick resolution. This resamples all tick positions — musical timing is preserved.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                }

                // ────────────────────────────────
                //  meta_text
                // ────────────────────────────────
                if root.modify-pass-key-text == "meta_text" : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    InlineCustomRow {
                        label: "Keep Kinds";
                        value: root.modify-meta-keep-kinds-text;
                        is-preset: false;
                        custom-submitted(v) => { root.update-control("meta.keep_kinds", v); }
                    }

                    Text {
                        text: "Comma-separated text event kinds to keep: track_name, marker, lyric, text, copyright, cue_point, program_name, device_name. Leave empty to drop all text meta events.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                }

                // ────────────────────────────────
                //  sysex
                // ────────────────────────────────
                if root.modify-pass-key-text == "sysex" : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    InlineOptionRow {
                        label: "Strip All";
                        OptionChip { label: "Off"; active: root.modify-sysex-strip-all-text == "off"; pressed => { root.update-control("sysex.strip_all", "off"); } }
                        OptionChip { label: "Strip"; active: root.modify-sysex-strip-all-text == "on"; pressed => { root.update-control("sysex.strip_all", "on"); } }
                    }

                    InlineCustomRow {
                        label: "Prepend";
                        value: root.modify-sysex-prepend-text;
                        is-preset: root.modify-sysex-prepend-text == "";
                        custom-display: root.modify-sysex-prepend-text == "" ? "None" : root.modify-sysex-prepend-text;
                        custom-submitted(v) => { root.update-control("sysex.prepend", v); }
                        OptionChip { label: "None"; active: root.modify-sysex-prepend-text == ""; pressed => { root.update-control("sysex.prepend", ""); } }
                    }

                    Text {
                        text: "Prepend messages are emitted at tick 0. Pipe-separated messages, space or comma-separated decimal bytes, e.g. 240 67 16 76 247 | 240 126 127 9 1 247.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                }

                // ────────────────────────────────
                //  shared_metadata_track
                // ────────────────────────────────
                if root.modify-pass-key-text == "shared_metadata_track" : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    // ── Destination ──
                    InlineOptionRow {
                        label: "Destination";
                        OptionChip { label: "Create New"; active: root.modify-shared-dest-mode-text == "create_new"; pressed => { root.update-control("shared_metadata.dest_mode", "create_new"); } }
                        OptionChip { label: "Insert Into"; active: root.modify-shared-dest-mode-text == "insert_into"; pressed => { root.update-control("shared_metadata.dest_mode", "insert_into"); } }
                    }

                    if root.modify-shared-dest-mode-text == "insert_into" : InlineCustomRow {
                        label: "Target Track";
                        value: root.modify-shared-dest-track-text;
                        is-preset: false;
                        custom-submitted(v) => { root.update-control("shared_metadata.dest_track", v); }
                    }

                    // ── Strip redundant ──
                    InlineOptionRow {
                        label: "Strip Redundant";
                        OptionChip { label: "Off"; active: root.modify-shared-strip-redundant-text == "off"; pressed => { root.update-control("shared_metadata.strip_redundant", "off"); } }
                        OptionChip { label: "On"; active: root.modify-shared-strip-redundant-text == "on"; pressed => { root.update-control("shared_metadata.strip_redundant", "on"); } }
                    }

                    Rectangle { height: 2px; }
                    Text { text: "META EVENTS"; color: Theme.text-faint; font-size: Theme.font-size-xs; font-weight: 700; letter-spacing: Theme.tracking-tight; }

                    InlineOptionRow {
                        label: "Tempo";
                        OptionChip { label: "Off"; active: root.modify-shared-move-tempo-text == "off"; pressed => { root.update-control("shared_metadata.move_tempo", "off"); } }
                        OptionChip { label: "Move"; active: root.modify-shared-move-tempo-text == "on"; pressed => { root.update-control("shared_metadata.move_tempo", "on"); } }
                    }

                    InlineOptionRow {
                        label: "Time Signatures";
                        OptionChip { label: "Off"; active: root.modify-shared-move-time-sig-text == "off"; pressed => { root.update-control("shared_metadata.move_time_sig", "off"); } }
                        OptionChip { label: "Move"; active: root.modify-shared-move-time-sig-text == "on"; pressed => { root.update-control("shared_metadata.move_time_sig", "on"); } }
                    }

                    InlineOptionRow {
                        label: "Key Signatures";
                        OptionChip { label: "Off"; active: root.modify-shared-move-key-sig-text == "off"; pressed => { root.update-control("shared_metadata.move_key_sig", "off"); } }
                        OptionChip { label: "Move"; active: root.modify-shared-move-key-sig-text == "on"; pressed => { root.update-control("shared_metadata.move_key_sig", "on"); } }
                    }

                    InlineOptionRow {
                        label: "Text Events";
                        OptionChip { label: "Off"; active: root.modify-shared-move-text-text == "off"; pressed => { root.update-control("shared_metadata.move_text", "off"); } }
                        OptionChip { label: "Move"; active: root.modify-shared-move-text-text == "on"; pressed => { root.update-control("shared_metadata.move_text", "on"); } }
                    }

                    InlineOptionRow {
                        label: "Unknown Meta";
                        OptionChip { label: "Off"; active: root.modify-shared-move-unknown-meta-text == "off"; pressed => { root.update-control("shared_metadata.move_unknown_meta", "off"); } }
                        OptionChip { label: "Move"; active: root.modify-shared-move-unknown-meta-text == "on"; pressed => { root.update-control("shared_metadata.move_unknown_meta", "on"); } }
                    }

                    InlineOptionRow {
                        label: "Channel Prefix";
                        OptionChip { label: "Off"; active: root.modify-shared-move-channel-prefix-text == "off"; pressed => { root.update-control("shared_metadata.move_channel_prefix", "off"); } }
                        OptionChip { label: "Move"; active: root.modify-shared-move-channel-prefix-text == "on"; pressed => { root.update-control("shared_metadata.move_channel_prefix", "on"); } }
                    }

                    InlineOptionRow {
                        label: "MIDI Port";
                        OptionChip { label: "Off"; active: root.modify-shared-move-midi-port-text == "off"; pressed => { root.update-control("shared_metadata.move_midi_port", "off"); } }
                        OptionChip { label: "Move"; active: root.modify-shared-move-midi-port-text == "on"; pressed => { root.update-control("shared_metadata.move_midi_port", "on"); } }
                    }

                    Rectangle { height: 2px; }
                    Text { text: "CHANNEL EVENTS"; color: Theme.text-faint; font-size: Theme.font-size-xs; font-weight: 700; letter-spacing: Theme.tracking-tight; }

                    InlineOptionRow {
                        label: "Control Change";
                        OptionChip { label: "Off"; active: root.modify-shared-move-cc-text == "off"; pressed => { root.update-control("shared_metadata.move_cc", "off"); } }
                        OptionChip { label: "Move"; active: root.modify-shared-move-cc-text == "on"; pressed => { root.update-control("shared_metadata.move_cc", "on"); } }
                    }

                    InlineOptionRow {
                        label: "Program Change";
                        OptionChip { label: "Off"; active: root.modify-shared-move-program-text == "off"; pressed => { root.update-control("shared_metadata.move_program", "off"); } }
                        OptionChip { label: "Move"; active: root.modify-shared-move-program-text == "on"; pressed => { root.update-control("shared_metadata.move_program", "on"); } }
                    }

                    InlineOptionRow {
                        label: "Pitch Bend";
                        OptionChip { label: "Off"; active: root.modify-shared-move-pitch-bend-text == "off"; pressed => { root.update-control("shared_metadata.move_pitch_bend", "off"); } }
                        OptionChip { label: "Move"; active: root.modify-shared-move-pitch-bend-text == "on"; pressed => { root.update-control("shared_metadata.move_pitch_bend", "on"); } }
                    }

                    InlineOptionRow {
                        label: "Channel Pressure";
                        OptionChip { label: "Off"; active: root.modify-shared-move-channel-pressure-text == "off"; pressed => { root.update-control("shared_metadata.move_channel_pressure", "off"); } }
                        OptionChip { label: "Move"; active: root.modify-shared-move-channel-pressure-text == "on"; pressed => { root.update-control("shared_metadata.move_channel_pressure", "on"); } }
                    }

                    Rectangle { height: 2px; }
                    Text {
                        text: "Create New = adds a new track 0 for metadata. Insert Into = merges into an existing track. Strip Redundant removes duplicate state events at the same tick. Channel events are typically left off unless you have a specific need.";
                        color: Theme.text-faint;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle { height: 16px; }
            Separator { }
            Rectangle { height: 16px; }

            // ══════════════════════════════════════
            //  4 · OUTPUT & RUN
            // ══════════════════════════════════════

            SectionHeader { title: "OUTPUT & RUN"; }
            Rectangle { height: 8px; }

            ModifyCard {
                // ── Output path ──
                HorizontalLayout {
                    spacing: 10px;

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Output";
                            color: Theme.text-faint;
                            font-size: Theme.font-size-sm;
                            font-weight: 600;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.has-output ? root.modify-output-path-text : "(choose output path)";
                            color: root.has-output ? Theme.text-primary : Theme.text-muted;
                            font-size: Theme.font-size-md;
                            font-weight: 600;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 56px;
                            height: 26px;
                            border-radius: 5px;
                            background: browse-touch.has-hover ? Theme.surface-control-hover : Theme.surface-control;

                        Text {
                            text: "Browse";
                            color: Theme.text-soft;
                            font-size: Theme.font-size-sm;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        browse-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.browse-output(); }
                        }
                    }
                    }
                }

                Separator { }

                // ── Buttons + progress ──
                HorizontalLayout {
                    spacing: 8px;

                    PrimaryButton {
                        label: root.modify-job-active ? "Processing…" : "Write Modified MIDI";
                        enabled: root.start-enabled;
                        pressed => { root.start-job(); }
                    }

                    Rectangle {
                        width: 100px;
                        height: 36px;
                        border-radius: 8px;
                        background: root.modify-job-active
                            ? (cancel-touch.has-hover ? #3a1820 : #261218)
                            : #111822;

                        Text {
                            text: "Cancel";
                            color: root.modify-job-active ? #ef6b73 : #415269;
                            font-size: Theme.font-size-lg;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cancel-touch := TouchArea {
                            mouse-cursor: root.modify-job-active ? pointer : default;
                            clicked => {
                                if (root.modify-job-active) {
                                    root.cancel-job();
                                }
                            }
                        }
                    }
                }

                if root.modify-progress > 0 : ProgressBar { progress: root.modify-progress; }

                if root.modify-detail-text != "" : Text {
                    text: root.modify-detail-text;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }

                // ── Compact last-result ──
                if root.modify-result-track-count-text != "—" : Separator { }
                if root.modify-result-track-count-text != "—" : HorizontalLayout {
                    spacing: 16px;
                    alignment: start;

                    Text { text: "Last result"; color: Theme.text-muted; font-size: Theme.font-size-xs; font-weight: 700; letter-spacing: Theme.tracking-tight; vertical-alignment: center; }
                    HorizontalLayout { spacing: 4px; Text { text: "Tracks"; color: Theme.text-faint; font-size: Theme.font-size-sm; vertical-alignment: center; } Text { text: root.modify-result-track-count-text; color: Theme.text-secondary; font-size: Theme.font-size-sm; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; } }
                    HorizontalLayout { spacing: 4px; Text { text: "PPQ"; color: Theme.text-faint; font-size: Theme.font-size-sm; vertical-alignment: center; } Text { text: root.modify-result-ppq-text; color: Theme.text-secondary; font-size: Theme.font-size-sm; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; } }
                    HorizontalLayout { spacing: 4px; Text { text: "Events"; color: Theme.text-faint; font-size: Theme.font-size-sm; vertical-alignment: center; } Text { text: root.modify-result-event-count-text; color: Theme.text-secondary; font-size: Theme.font-size-sm; font-family: Theme.font-family-mono; font-weight: 600; vertical-alignment: center; } }
                }
            }

            Rectangle { height: 16px; }
            Separator { }
            Rectangle { height: 16px; }

            // ══════════════════════════════════════
            //  5 · ADVANCED JSON
            // ══════════════════════════════════════

            ModifyCard {
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "Advanced JSON";
                        color: Theme.text-detail;
                        font-size: Theme.font-size-md;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        OptionChip {
                            label: root.advanced-open ? "Hide" : "Show";
                            active: root.advanced-open;
                            pressed => { root.advanced-open = !root.advanced-open; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        OptionChip {
                            label: "Reset";
                            active: false;
                            pressed => { root.reset-config(); }
                        }
                    }
                }

                Text {
                    text: root.modify-config-status-text;
                    color: root.modify-config-valid ? Theme.text-muted : #ef6b73;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }

                if root.advanced-open : Rectangle {
                    height: 300px;
                    border-radius: 8px;
                    background: #08111b;
                    border-width: 1px;
                    border-color: root.modify-config-valid ? #132031 : #4a1f2a;
                    clip: true;

                    config-edit := TextEdit {
                        text: root.modify-config-text;
                        placeholder-text: "{\n  \"tools\": []\n}";
                        x: 10px;
                        y: 10px;
                        width: parent.width - 20px;
                        height: parent.height - 20px;
                        edited => { root.edit-config(self.text); }
                    }
                }

                if !root.advanced-open : Text {
                    text: "Synchronized with controls above. Escape hatch for uncommon fields, multi-tool pipelines, and passes without structured controls.";
                    color: Theme.text-faint;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }
            }

            Rectangle { height: 24px; }
        }
    }
}

// ═══════════════════════════════════════════════════════════
//  Modify panel (profile 3) — right sidebar.
//
//  Scene configuration and real-time inspector. Uses the
//  *analysis* MIDI loading mode (no display/audio caches,
//  just parsed + processed MIDI).
//
//  This panel is for tweaking scene parameters and inspecting
//  the current configuration — not for rendering.
// ═══════════════════════════════════════════════════════════

import { MidiLoadState, InspectorRow } from "../structs.slint";
import { SectionHeader, Separator, FieldRow, ToggleButton, InspectorLine } from "../primitives.slint";
import { MidiStateSection } from "../midi_loading.slint";

export component ModifyPanel inherits Rectangle {
    // ── MIDI state bindings ──
    in property <MidiLoadState> midi-state: no-midi;
    in property <string> selected-midi-name: "";
    in property <string> loading-status: "Loading…";
    in property <float> loading-progress: 0;
    in property <string> load-error: "";

    // ── MIDI state callbacks ──
    callback select-file;
    callback load-midi;
    callback cancel-load;
    callback unload-midi;
    callback retry-load;

    // ── Scene config bindings ──
    in property <string> current-renderer-text;
    in property <string> time-space-text;

    // ── Stats bindings ──
    in property <string> note-count-text;
    in property <string> visible-note-count-text;
    in property <string> active-keys-text;
    in property <string> viewport-text;
    in property <string> fps-text;

    // ── Inspector ──
    in property <[InspectorRow]> inspector-items;

    // ── Callbacks ──
    callback select-renderer(string);
    callback select-time-space(string);

    VerticalLayout {
        padding: 16px;
        padding-left: 20px;
        spacing: 12px;
        alignment: start;

        // ── MIDI FILE ──
        MidiStateSection {
            midi-state: root.midi-state;
            file-name: root.selected-midi-name;
            load-description: "Parses MIDI for scene configuration and inspection.";
            load-label: "Load for Modify";
            mode-label: "modify";
            show-unload: false;
            loading-status: root.loading-status;
            loading-progress: root.loading-progress;
            error-message: root.load-error;
            select-file => { root.select-file(); }
            load => { root.load-midi(); }
            cancel-load => { root.cancel-load(); }
            unload => { root.unload-midi(); }
            retry-load => { root.retry-load(); }
        }

        Separator { }

        // ── Scene config ──
        VerticalLayout {
            spacing: 8px;
            SectionHeader { title: "RENDERER"; }
            HorizontalLayout {
                spacing: 4px;
                ToggleButton { label: "PFA";      active: root.current-renderer-text == "pfa";  pressed => { root.select-renderer("pfa"); } }
                ToggleButton { label: "Flat";     active: root.current-renderer-text == "flat"; pressed => { root.select-renderer("flat"); } }
                ToggleButton { label: "3D Trail"; active: root.current-renderer-text == "3d";   pressed => { root.select-renderer("3d"); } }
            }
        }

        VerticalLayout {
            spacing: 8px;
            SectionHeader { title: "TIME SPACE"; }
            HorizontalLayout {
                spacing: 4px;
                ToggleButton { label: "Time"; active: root.time-space-text == "time"; pressed => { root.select-time-space("time"); } }
                ToggleButton { label: "Tick"; active: root.time-space-text == "tick"; pressed => { root.select-time-space("tick"); } }
            }
        }

        Separator { }

        // ── Stats ──
        VerticalLayout {
            spacing: 4px;
            SectionHeader { title: "STATS"; }
            FieldRow { label: "Total notes"; value: root.note-count-text; }
            FieldRow { label: "Visible";     value: root.visible-note-count-text; }
            FieldRow { label: "Active keys"; value: root.active-keys-text; }
            FieldRow { label: "Viewport";    value: root.viewport-text; }
            FieldRow { label: "FPS";         value: root.fps-text; }
        }

        Separator { }

        // ── Inspector ──
        VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            SectionHeader { title: "INSPECTOR"; }

            Rectangle {
                vertical-stretch: 1;
                clip: true;

                Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-height: root.inspector-items.length * 34px;

                    VerticalLayout {
                        width: parent.width;
                        spacing: 2px;
                        alignment: start;

                        for row in root.inspector-items : InspectorLine {
                            section: row.section;
                            label: row.label;
                            value: row.value;
                        }
                    }
                }
            }
        }
    }
}

// ═══════════════════════════════════════════════════════════
//  Meridian — main application window.
//
//  Imports components from:
//   - structs.slint        (InspectorRow, MidiLoadState)
//   - primitives.slint     (SectionHeader, FieldRow, …)
//   - chrome.slint         (ProfileTab, TabGroupDivider, TransportButton, TimeScrubber)
//   - midi_loading.slint   (MidiStateSection, MidiFileBar, …)
//   - panels/*.slint       (PreviewWelcome, DropOverlay, VideoPanel, RenderPanel, …)
// ═══════════════════════════════════════════════════════════

import { InspectorRow, MidiLoadState, BarValue, EventCount, SliderCurve } from "structs.slint";
import { SectionHeader, FieldRow, OptionChip } from "primitives.slint";
import { ProfileTab, TabGroupDivider, TransportButton, TimeScrubber } from "chrome.slint";
import { PreviewWelcome, DropOverlay } from "panels/preview.slint";
import { VideoPanel } from "panels/video.slint";
import { RenderPanel } from "panels/render.slint";
import { AudioPanel } from "panels/audio.slint";
import { ModifyPanel } from "panels/modify.slint";
import { AnalysisPanel } from "panels/analysis.slint";

export { InspectorRow, MidiLoadState, BarValue, EventCount, SliderCurve }

export component App inherits Window {
    icon: @image-url("../../../assets/icons/meridian.png");

    // ── Viewport texture ──
    in-out property <image> viewport-image;
    in-out property <string> window-title: "Meridian";

    // ══════════════════════════════════════════
    //  MIDI FILE STATE
    // ══════════════════════════════════════════

    // Global selection (shared across all tabs)
    in-out property <string> selected-midi-name: "";

    // Per-mode load states (Rust sets these based on pipeline progress)
    in-out property <MidiLoadState> render-load-state:   no-midi;
    in-out property <MidiLoadState> audio-load-state:    no-midi;
    in-out property <MidiLoadState> analysis-load-state:  no-midi;

    // Per-context loading progress
    in-out property <string> render-loading-status: "";
    in-out property <float> render-loading-progress: 0;
    in-out property <string> render-load-error: "";
    in-out property <string> audio-loading-status: "";
    in-out property <float> audio-loading-progress: 0;
    in-out property <string> audio-load-error: "";
    in-out property <string> analysis-loading-status: "";
    in-out property <float> analysis-loading-progress: 0;
    in-out property <string> analysis-load-error: "";

    // Drag-and-drop state (set by Rust via winit events)
    in-out property <bool> drop-hovering: false;

    // MIDI file callbacks
    callback select-midi-file;                  // open file picker
    callback drop-midi-file(string);            // file dropped (path from Rust)
    callback load-for-preview;                  // load MIDI for preview playback (display + audio)
    callback load-for-render;                   // load MIDI for render/audio mode
    callback load-for-audio;                    // load MIDI for audio-only mode
    callback load-for-analysis;                 // load MIDI for modify/analysis mode
    callback cancel-load-preview;               // cancel preview loading
    callback cancel-load-render;                // cancel render-context loading
    callback cancel-load-audio;                 // cancel audio-context loading
    callback cancel-load-analysis;              // cancel analysis-context loading
    callback unload-preview;                    // unload the currently selected MIDI everywhere
    callback unload-render;                     // unload the currently selected MIDI everywhere
    callback unload-audio;                      // unload the currently selected MIDI everywhere
    callback unload-analysis;                   // unload the currently selected MIDI everywhere
    callback retry-load-preview;                // retry failed preview load
    callback retry-load-render;                 // retry failed render load
    callback retry-load-audio;                  // retry failed audio load
    callback retry-load-analysis;               // retry failed analysis load


    // ══════════════════════════════════════════
    //  SHARED STATE (stable API — do not rename)
    // ══════════════════════════════════════════

    in-out property <string> midi-path-text: "No MIDI loaded";
    in-out property <string> status-text: "Waiting for MIDI";
    in-out property <string> time-text: "0.000 s";
    in-out property <string> length-text: "0.000 s";
    in-out property <string> note-count-text: "0";
    in-out property <string> visible-note-count-text: "0";
    in-out property <string> active-keys-text: "0";
    in-out property <string> view-range-text: "500 ms";
    in-out property <string> play-label: "Play";
    in-out property <string> fps-text: "--";
    in-out property <string> scene-summary-text: "2D / PFA notes / PFA keyboard";
    in-out property <string> viewport-text: "1280 x 720";
    in-out property <string> current-renderer-text: "pfa";
    in-out property <string> time-space-text: "time";
    in-out property <string> video-view-range-value-text: "0.5";
    in-out property <string> video-first-key-text: "0";
    in-out property <string> video-last-key-text: "127";
    in-out property <string> video-keyboard-height-mode-text: "aspect_ratio";
    in-out property <string> video-keyboard-height-value-text: "0.08494";
    in-out property <string> video-note-same-width-text: "off";
    in-out property <string> video-border-width-text: "1.0";
    in-out property <string> video-keyboard-same-width-text: "off";
    in-out property <string> video-middle-c-text: "off";
    in-out property <string> video-top-color-text: "red";
    in-out property <string> video-top-bar-color-text: "#950A06";
    in-out property <string> video-palette-source-text: "default_track_colors";
    in-out property <string> video-palette-kind-text: "random";
    in-out property <string> video-palette-randomize-text: "on";
    in-out property <string> video-palette-path-text: "(palette png)";
    in-out property <string> video-ptc-same-width-text: "on";
    in-out property <string> video-ptc-fov-text: "60.0";
    in-out property <string> video-ptc-view-height-text: "0.50";
    in-out property <string> video-ptc-view-offset-text: "0.40";
    in-out property <string> video-ptc-view-pan-text: "0.00";
    in-out property <string> video-ptc-cam-ang-text: "32.09";
    in-out property <string> video-ptc-cam-rot-text: "0.00";
    in-out property <string> video-ptc-cam-spin-text: "0.00";
    in-out property <string> video-ptc-viewdist-text: "14.0";
    in-out property <string> video-ptc-viewback-text: "0.20";
    in-out property <string> video-ptc-vertical-notes-text: "off";
    in-out property <string> video-ptc-note-down-speed-text: "0.60";
    in-out property <string> video-ptc-note-up-speed-text: "0.20";
    in-out property <string> video-ptc-box-notes-text: "on";
    in-out property <string> video-ptc-light-shade-text: "off";
    in-out property <string> video-ptc-show-keyboard-text: "on";
    in-out property <string> video-ptc-tilt-keys-text: "on";
    in-out property <string> video-ptc-eat-notes-text: "off";
    in-out property <string> video-ptc-aura-enabled-text: "on";
    in-out property <string> video-ptc-aura-strength-text: "2.0";
    in-out property <string> video-ptc-notes-change-size-text: "off";
    in-out property <string> video-ptc-notes-change-tint-text: "on";
    in-out property <string> video-ptc-use-vel-text: "off";
    in-out property <string> video-ptc-aura-image-source-text: "builtin";
    in-out property <string> video-ptc-aura-image-name-text: "ring";
    in-out property <string> video-ptc-aura-image-path-text: "(aura png)";

    // ── Video panel float values (for slider components) ──
    in-out property <float> video-view-range-value-float: 0.5;
    in-out property <float> video-border-width-float: 1.0;
    in-out property <float> video-keyboard-height-value-float: 0.085;
    in-out property <float> video-ptc-fov-float: 60.0;
    in-out property <float> video-ptc-view-height-float: 0.5;
    in-out property <float> video-ptc-view-offset-float: 0.4;
    in-out property <float> video-ptc-view-pan-float: 0.0;
    in-out property <float> video-ptc-cam-ang-float: 32.08564;
    in-out property <float> video-ptc-cam-rot-float: 0.0;
    in-out property <float> video-ptc-cam-spin-float: 0.0;
    in-out property <float> video-ptc-viewdist-float: 14.0;
    in-out property <float> video-ptc-viewback-float: 0.2;
    in-out property <float> video-ptc-note-down-speed-float: 0.6;
    in-out property <float> video-ptc-note-up-speed-float: 0.2;
    in-out property <float> video-ptc-aura-strength-float: 2.0;

    in-out property <float> current-time-seconds: 0;
    in-out property <float> midi-length-seconds: 1;
    in-out property <[InspectorRow]> inspector-items;
    in-out property <string> analysis-note-count-text: "—";
    in-out property <string> analysis-track-count-text: "—";
    in-out property <string> analysis-midi-length-text: "—";
    in-out property <string> analysis-tempo-text: "—";
    in-out property <string> analysis-time-signature-text: "—";
    in-out property <string> analysis-key-range-text: "—";
    in-out property <string> analysis-avg-velocity-text: "—";
    in-out property <string> analysis-median-velocity-text: "—";
    in-out property <string> analysis-p90-velocity-text: "—";
    in-out property <string> analysis-low-velocity-share-text: "—";
    in-out property <string> analysis-high-velocity-share-text: "—";
    in-out property <string> analysis-note-density-text: "—";
    in-out property <string> analysis-note-traffic-count-text: "—";
    in-out property <string> analysis-note-traffic-share-text: "—";
    in-out property <float> analysis-note-traffic-fraction: 0;
    in-out property <string> analysis-other-events-count-text: "—";
    in-out property <string> analysis-other-events-share-text: "—";
    in-out property <float> analysis-other-events-fraction: 0;
    in-out property <string> analysis-top-non-note-family-text: "—";
    in-out property <string> analysis-top-non-note-share-text: "—";
    in-out property <float> analysis-top-non-note-fraction: 0;

    // ── Analysis: File metrics ──
    in-out property <string> analysis-file-size-text: "—";
    in-out property <string> analysis-gzip-size-text: "—";
    in-out property <string> analysis-gzip-ratio-text: "—";
    in-out property <string> analysis-format-text: "—";
    in-out property <string> analysis-declared-tracks-text: "—";
    in-out property <string> analysis-actual-tracks-text: "—";
    in-out property <string> analysis-ticks-per-quarter-text: "—";
    in-out property <string> analysis-total-events-text: "—";

    // ── Analysis: Tempo metrics ──
    in-out property <string> analysis-initial-bpm-text: "—";
    in-out property <string> analysis-min-bpm-text: "—";
    in-out property <string> analysis-max-bpm-text: "—";
    in-out property <string> analysis-avg-bpm-text: "—";

    // ── Analysis: Note metrics ──
    in-out property <string> analysis-avg-note-length-text: "—";
    in-out property <string> analysis-min-note-length-text: "—";
    in-out property <string> analysis-max-note-length-text: "—";
    in-out property <string> analysis-total-note-duration-text: "—";
    in-out property <string> analysis-max-polyphony-text: "—";
    in-out property <string> analysis-avg-polyphony-text: "—";
    in-out property <string> analysis-peak-nps-text: "—";
    in-out property <string> analysis-avg-nps-text: "—";
    in-out property <string> analysis-unique-onsets-text: "—";

    // ── Analysis: Summary ──
    in-out property <string> analysis-densest-key-text: "—";
    in-out property <string> analysis-densest-key-notes-text: "—";

    // ── Analysis: Histograms (model arrays) ──
    in-out property <[BarValue]> analysis-key-histogram: [];
    in-out property <[BarValue]> analysis-velocity-histogram: [];
    in-out property <[BarValue]> analysis-pitch-class-histogram: [];
    in-out property <[BarValue]> analysis-channel-histogram: [];
    in-out property <[BarValue]> analysis-track-histogram: [];
    in-out property <[BarValue]> analysis-density-timeline: [];

    // ── Analysis: Event breakdown ──
    in-out property <[EventCount]> analysis-event-composition: [];
    in-out property <[EventCount]> analysis-event-breakdown: [];
    in-out property <[EventCount]> analysis-event-breakdown-left: [];
    in-out property <[EventCount]> analysis-event-breakdown-right: [];
    in-out property <string> analysis-event-total-text: "—";
    in-out property <string> audio-backend-text: "xsynth";
    in-out property <string> audio-engine-status-text: "Idle";
    in-out property <string> audio-output-stream-text: "Stereo @ 48 kHz";
    in-out property <bool> audio-supports-44100: true;
    in-out property <bool> audio-supports-48000: true;
    in-out property <bool> audio-supports-88200: false;
    in-out property <bool> audio-supports-96000: false;
    in-out property <bool> audio-supports-176400: false;
    in-out property <bool> audio-supports-192000: false;
    in-out property <bool> audio-supports-mono: false;
    in-out property <bool> audio-supports-stereo: true;
    in-out property <string> audio-sample-rate-text: "48000";
    in-out property <string> audio-channel-count-text: "stereo";
    in-out property <string> audio-render-window-text: "10.0 ms";
    in-out property <string> audio-soundfont-text: "(default)";
    in-out property <string> audio-soundfont-count-text: "1 loaded";
    in-out property <bool> audio-soundfont-enabled: true;
    in-out property <string> audio-engine-detail-text: "Nearest / FX on";
    in-out property <string> audio-effects-text: "on";
    in-out property <string> audio-interpolation-text: "nearest";
    in-out property <string> audio-voice-count-text: "—";
    in-out property <string> audio-layer-limit-text: "4 max";
    in-out property <string> audio-limiter-text: "Off";
    in-out property <string> audio-threading-text: "none";
    in-out property <string> audio-ignore-range-text: "off";
    in-out property <string> audio-attack-curve-text: "exponential";
    in-out property <string> audio-decay-curve-text: "linear";
    in-out property <string> audio-release-curve-text: "linear";
    in-out property <string> audio-parallelism-text: "Auto / Auto";
    in-out property <float> video-render-progress: 0;
    in-out property <string> video-render-status: "Idle";
    in-out property <string> video-render-elapsed: "—";
    in-out property <string> video-render-output-text: "output.mp4";
    in-out property <float> audio-render-progress: 0;
    in-out property <string> audio-render-status: "Idle";
    in-out property <string> audio-render-elapsed: "—";
    in-out property <string> audio-render-output-text: "output.wav";
    in-out property <string> render-mode-text: "video_audio";
    in-out property <string> render-output-path-text: "";
    in-out property <string> render-video-resolution-text: "1920x1080";
    in-out property <string> render-video-width-text: "1920";
    in-out property <string> render-video-height-text: "1080";
    in-out property <string> render-video-fps-text: "60";
    in-out property <string> render-audio-format-text: "wav";
    in-out property <string> render-audio-sample-rate-text: "48000";
    in-out property <string> render-audio-channel-count-text: "stereo";
    in-out property <string> render-video-ffmpeg-args-text: "";
    in-out property <string> render-audio-ffmpeg-args-text: "";
    in-out property <string> render-video-codec-text: "libx264";
    in-out property <string> render-video-crf-text: "18";
    in-out property <string> render-video-preset-text: "medium";
    in-out property <string> render-video-pix-fmt-text: "yuv420p";
    in-out property <string> render-audio-bitrate-text: "192k";
    in-out property <bool> render-use-limiter: false;
    in-out property <bool> render-open-after-export: false;
    in-out property <float> render-export-progress: 0;
    in-out property <string> render-export-status: "Ready";
    in-out property <string> render-export-detail-text: "Choose a mode and output path.";


    // ── Profile (0=Preview 1=Video 2=Render 3=Audio 4=Modify 5=Analysis) ──
    in-out property <int> active-profile: 0;

    // ── Derived layout flags ──
    //   has-viewport:     profiles that show the wgpu viewport (Preview, Video, Audio)
    //   compact-viewport: viewport is small with a settings panel beside it
    //   full-viewport:    viewport fills the content area
    //   panel-only:       no viewport at all, just a full-width panel
    private property <bool> has-viewport:
        root.active-profile == 0 || root.active-profile == 1 || root.active-profile == 3;
    private property <bool> compact-viewport:
        root.active-profile == 1 || root.active-profile == 3;
    private property <bool> full-viewport:
        root.active-profile == 0;
    private property <bool> panel-only:
        root.active-profile == 2 || root.active-profile == 4 || root.active-profile == 5;

    // Whether the Preview page shows the welcome hero (no MIDI loaded)
    private property <MidiLoadState> preview-load-state:
        root.render-load-state == MidiLoadState.loading || root.audio-load-state == MidiLoadState.loading
            ? MidiLoadState.loading
            : root.render-load-state == MidiLoadState.error || root.audio-load-state == MidiLoadState.error
                ? MidiLoadState.error
                : root.render-load-state == MidiLoadState.loaded && root.audio-load-state == MidiLoadState.loaded
                    ? MidiLoadState.loaded
                    : root.selected-midi-name != ""
                        ? MidiLoadState.selected
                        : MidiLoadState.no-midi;
    private property <string> preview-loading-status:
        root.render-load-state == MidiLoadState.loading
            ? root.render-loading-status
            : root.audio-load-state == MidiLoadState.loading
                ? root.audio-loading-status
                : "";
    private property <float> preview-loading-progress:
        root.render-load-state == MidiLoadState.loading
            ? root.render-loading-progress
            : root.audio-load-state == MidiLoadState.loading
                ? root.audio-loading-progress
                : 0;
    private property <string> preview-load-error:
        root.render-load-state == MidiLoadState.error
            ? root.render-load-error
            : root.audio-load-state == MidiLoadState.error
                ? root.audio-load-error
                : "";
    private property <bool> show-preview-welcome:
        root.active-profile == 0 && root.preview-load-state != MidiLoadState.loaded;
    private property <bool> transport-hotkeys-enabled: !TextInputInterface.text-input-focused;
    private property <float> transport-hotkey-step-seconds: 5.0;

    // ── Viewport pixel dimensions (consumed by Rust) ──
    out property <float> viewport-px-width:  viewport-box.width  / 1px;
    out property <float> viewport-px-height: viewport-box.height / 1px;

    // ── Callbacks (stable API — do not rename) ──
    callback step-time(float);
    callback zoom(float);
    callback toggle-play();
    callback seek-time(float);
    callback select-renderer(string);
    callback select-time-space(string);
    callback update-video-control(string, string);
    callback update-video-control-float(string, float);
    callback browse-video-asset(string);
    callback reset-video-asset(string);
    callback select-audio-sample-rate(string);
    callback select-audio-channel-count(string);
    callback select-audio-render-window(string);
    callback select-audio-soundfont();
    callback reset-audio-soundfont();
    callback toggle-audio-soundfont-enabled();
    callback select-audio-interpolation(string);
    callback select-audio-effects(string);
    callback select-audio-layer-limit(string);
    callback select-audio-limiter(string);
    callback select-audio-threading(string);
    callback select-audio-ignore-range(string);
    callback select-audio-attack-curve(string);
    callback select-audio-decay-curve(string);
    callback select-audio-release-curve(string);
    callback select-render-mode(string);
    callback browse-render-output;
    callback select-render-resolution(string);
    callback submit-custom-render-resolution(string);
    callback select-render-fps(string);
    callback submit-custom-render-fps(string);
    callback select-render-audio-format(string);
    callback select-render-audio-sample-rate(string);
    callback select-render-audio-channel-count(string);
    callback change-render-video-ffmpeg-args(string);
    callback change-render-audio-ffmpeg-args(string);
    callback select-render-video-codec(string);
    callback select-render-video-crf(string);
    callback submit-custom-render-video-crf(string);
    callback select-render-video-preset(string);
    callback select-render-video-pix-fmt(string);
    callback select-render-audio-bitrate(string);
    callback submit-custom-render-audio-bitrate(string);
    callback toggle-render-use-limiter;
    callback toggle-render-open-after-export;
    callback start-export;
    callback cancel-export;
    callback start-render;
    callback cancel-render;
    callback start-audio-render;
    callback cancel-audio-render;

    title: root.window-title;
    preferred-width: 1540px;
    preferred-height: 940px;
    background: #060a11;

    shortcut-scope := FocusScope {
        width: 0px;
        height: 0px;

        init => {
            self.focus();
        }

        capture-key-pressed(event) => {
            if (!root.transport-hotkeys-enabled) {
                return reject;
            }
            if (event.text == Key.Space || event.text == " ") {
                root.toggle-play();
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.step-time(-root.transport-hotkey-step-seconds);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.step-time(root.transport-hotkey-step-seconds);
                return accept;
            }
            if (event.text == "[" || event.text == "{" || event.text == "-" || event.text == "_") {
                root.zoom(-1.0);
                return accept;
            }
            if (event.text == "]" || event.text == "}" || event.text == "=" || event.text == "+") {
                root.zoom(1.0);
                return accept;
            }
            if (event.text == Key.Home) {
                root.seek-time(0.0);
                return accept;
            }
            if (event.text == Key.End) {
                root.seek-time(root.midi-length-seconds);
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        spacing: 0px;

            // ══════════════════════════════════════════
            //  TOP CHROME
            // ══════════════════════════════════════════

            Rectangle {
                background: #0a1018;
                min-height: 84px;
                max-height: 84px;

                VerticalLayout {
                    spacing: 0px;

                    // ── Profile tabs ──
                    Rectangle {
                        height: 36px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 4px;

                            ProfileTab { label: "Preview";  active: root.active-profile == 0; pressed => { root.active-profile = 0; } }
                            ProfileTab { label: "Video";    active: root.active-profile == 1; pressed => { root.active-profile = 1; } }
                            ProfileTab { label: "Audio";    active: root.active-profile == 3; pressed => { root.active-profile = 3; } }
                            TabGroupDivider {}
                            ProfileTab { label: "Render";   active: root.active-profile == 2; pressed => { root.active-profile = 2; } }
                            ProfileTab { label: "Modify";   active: root.active-profile == 4; pressed => { root.active-profile = 4; } }
                            TabGroupDivider {}
                            ProfileTab { label: "Analysis"; active: root.active-profile == 5; pressed => { root.active-profile = 5; } }

                            Rectangle { horizontal-stretch: 1; }


                            VerticalLayout {
                                alignment: center;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: center;

                                    Image {
                                        width: 16px;
                                        height: 16px;
                                        source: @image-url("../../../assets/icons/meridian.png");
                                        image-fit: contain;
                                        vertical-alignment: center;
                                    }

                                    Text { text: "Meridian"; color: #2d3d52; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                                }
                            }
                        }

                        Rectangle { y: parent.height - 1px; height: 1px; background: #141e2e; }
                    }

                    // ── Transport rail ──
                    Rectangle {
                        height: 48px;

                        VerticalLayout {
                            alignment: center;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 16px;
                                spacing: 6px;

                                HorizontalLayout {
                                    spacing: 6px;

                                    TransportButton {
                                        icon: root.play-label == "Pause" ? "⏸" : "▶";
                                        active: root.play-label == "Pause";
                                        pressed => { root.toggle-play(); }
                                    }

                                    TimeScrubber {
                                        horizontal-stretch: 1;
                                        min-width: 200px;
                                        value: root.current-time-seconds;
                                        maximum: root.midi-length-seconds;
                                        scrubbed(v) => { root.seek-time(v); }
                                    }
                                }

                                // Time readout
                                Text { text: root.time-text;   color: #b0c0d4; font-family: "monospace"; font-size: 11px; font-weight: 600; vertical-alignment: center; min-width: 58px; horizontal-alignment: right; }
                                Text { text: "/";              color: #2d3d52; font-size: 11px; vertical-alignment: center; }
                                Text { text: root.length-text; color: #4d6580; font-family: "monospace"; font-size: 11px; vertical-alignment: center; min-width: 58px; }

                                Rectangle { width: 1px; background: #1a2740; }

                                VerticalLayout {
                                    alignment: center;

                                    HorizontalLayout {
                                        spacing: 4px;

                                        OptionChip {
                                            label: "250ms";
                                            active: root.video-view-range-value-float == 0.25;
                                            pressed => { root.update-video-control-float("view_range", 0.25); }
                                        }

                                        OptionChip {
                                            label: "500ms";
                                            active: root.video-view-range-value-float == 0.5;
                                            pressed => { root.update-video-control-float("view_range", 0.5); }
                                        }

                                        OptionChip {
                                            label: "2s";
                                            active: root.video-view-range-value-float == 2.0;
                                            pressed => { root.update-video-control-float("view_range", 2.0); }
                                        }

                                        OptionChip {
                                            label: "8s";
                                            active: root.video-view-range-value-float == 8.0;
                                            pressed => { root.update-video-control-float("view_range", 8.0); }
                                        }
                                    }
                                }
                            }
                        }
                }
            }
        }


        // ══════════════════════════════════════════
        //  CONTENT AREA
        //
        //  No `if` conditionals here — all branches use
        //  `visible:` so that `viewport-box :=` always
        //  exists and Rust can read its pixel dimensions.
        // ══════════════════════════════════════════

        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // ──────────────────────────────────────
            //  LEFT: Settings panel (Video / Audio)
            // ──────────────────────────────────────
            Rectangle {
                visible: root.compact-viewport;
                horizontal-stretch: root.compact-viewport ? 1 : 0;
                min-width: root.compact-viewport ? 100px : 0px;
                max-width: root.compact-viewport ? 100000px : 0px;
                background: #0a1018;

                // Right-edge separator
                Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: #141e2e; }

                VideoPanel {
                    visible: root.active-profile == 1;
                    x: 0; y: 0; width: parent.width; height: parent.height;

                    midi-state:            root.render-load-state;
                    selected-midi-name:    root.selected-midi-name;
                    loading-status:        root.render-loading-status;
                    loading-progress:      root.render-loading-progress;
                    load-error:            root.render-load-error;
                    select-file            => { root.select-midi-file(); }
                    load-midi              => { root.load-for-render(); }
                    cancel-load            => { root.cancel-load-render(); }
                    unload-midi            => { root.unload-render(); }
                    retry-load             => { root.retry-load-render(); }

                    current-renderer-text: root.current-renderer-text;
                    time-space-text:       root.time-space-text;
                    view-range-text:       root.view-range-text;
                    video-view-range-value-text: root.video-view-range-value-text;
                    video-first-key-text: root.video-first-key-text;
                    video-last-key-text: root.video-last-key-text;
                    scene-summary-text:    root.scene-summary-text;
                    video-keyboard-height-mode-text: root.video-keyboard-height-mode-text;
                    video-keyboard-height-value-text: root.video-keyboard-height-value-text;
                    video-note-same-width-text: root.video-note-same-width-text;
                    video-border-width-text: root.video-border-width-text;
                    video-keyboard-same-width-text: root.video-keyboard-same-width-text;
                    video-middle-c-text: root.video-middle-c-text;
                    video-top-color-text: root.video-top-color-text;
                    video-top-bar-color-text: root.video-top-bar-color-text;
                    video-palette-source-text: root.video-palette-source-text;
                    video-palette-kind-text: root.video-palette-kind-text;
                    video-palette-randomize-text: root.video-palette-randomize-text;
                    video-palette-path-text: root.video-palette-path-text;
                    video-ptc-same-width-text: root.video-ptc-same-width-text;
                    video-ptc-fov-text: root.video-ptc-fov-text;
                    video-ptc-view-height-text: root.video-ptc-view-height-text;
                    video-ptc-view-offset-text: root.video-ptc-view-offset-text;
                    video-ptc-view-pan-text: root.video-ptc-view-pan-text;
                    video-ptc-cam-ang-text: root.video-ptc-cam-ang-text;
                    video-ptc-cam-rot-text: root.video-ptc-cam-rot-text;
                    video-ptc-cam-spin-text: root.video-ptc-cam-spin-text;
                    video-ptc-viewdist-text: root.video-ptc-viewdist-text;
                    video-ptc-viewback-text: root.video-ptc-viewback-text;
                    video-ptc-vertical-notes-text: root.video-ptc-vertical-notes-text;
                    video-ptc-note-down-speed-text: root.video-ptc-note-down-speed-text;
                    video-ptc-note-up-speed-text: root.video-ptc-note-up-speed-text;
                    video-ptc-box-notes-text: root.video-ptc-box-notes-text;
                    video-ptc-light-shade-text: root.video-ptc-light-shade-text;
                    video-ptc-show-keyboard-text: root.video-ptc-show-keyboard-text;
                    video-ptc-tilt-keys-text: root.video-ptc-tilt-keys-text;
                    video-ptc-eat-notes-text: root.video-ptc-eat-notes-text;
                    video-ptc-aura-enabled-text: root.video-ptc-aura-enabled-text;
                    video-ptc-aura-strength-text: root.video-ptc-aura-strength-text;
                    video-ptc-notes-change-size-text: root.video-ptc-notes-change-size-text;
                    video-ptc-notes-change-tint-text: root.video-ptc-notes-change-tint-text;
                    video-ptc-use-vel-text: root.video-ptc-use-vel-text;
                    video-ptc-aura-image-source-text: root.video-ptc-aura-image-source-text;
                    video-ptc-aura-image-name-text: root.video-ptc-aura-image-name-text;
                    video-ptc-aura-image-path-text: root.video-ptc-aura-image-path-text;
                    video-view-range-value-float: root.video-view-range-value-float;
                    video-border-width-float: root.video-border-width-float;
                    video-keyboard-height-value-float: root.video-keyboard-height-value-float;
                    video-ptc-fov-float: root.video-ptc-fov-float;
                    video-ptc-view-height-float: root.video-ptc-view-height-float;
                    video-ptc-view-offset-float: root.video-ptc-view-offset-float;
                    video-ptc-view-pan-float: root.video-ptc-view-pan-float;
                    video-ptc-cam-ang-float: root.video-ptc-cam-ang-float;
                    video-ptc-cam-rot-float: root.video-ptc-cam-rot-float;
                    video-ptc-cam-spin-float: root.video-ptc-cam-spin-float;
                    video-ptc-viewdist-float: root.video-ptc-viewdist-float;
                    video-ptc-viewback-float: root.video-ptc-viewback-float;
                    video-ptc-note-down-speed-float: root.video-ptc-note-down-speed-float;
                    video-ptc-note-up-speed-float: root.video-ptc-note-up-speed-float;
                    video-ptc-aura-strength-float: root.video-ptc-aura-strength-float;
                    select-renderer(r)     => { root.select-renderer(r); }
                    select-time-space(ts)  => { root.select-time-space(ts); }
                    update-control(key, value) => { root.update-video-control(key, value); }
                    update-control-float(key, value) => { root.update-video-control-float(key, value); }
                    browse-asset(target)   => { root.browse-video-asset(target); }
                    reset-asset(target)    => { root.reset-video-asset(target); }
                }

                AudioPanel {
                    visible: root.active-profile == 3;
                    x: 0; y: 0; width: parent.width; height: parent.height;

                    midi-state:            root.audio-load-state;
                    selected-midi-name:    root.selected-midi-name;
                    loading-status:        root.audio-loading-status;
                    loading-progress:      root.audio-loading-progress;
                    load-error:            root.audio-load-error;
                    select-file            => { root.select-midi-file(); }
                    load-midi              => { root.load-for-audio(); }
                    cancel-load            => { root.cancel-load-audio(); }
                    unload-midi            => { root.unload-audio(); }
                    retry-load             => { root.retry-load-audio(); }

                    audio-backend-text:    root.audio-backend-text;
                    audio-engine-status-text: root.audio-engine-status-text;
                    audio-output-stream-text: root.audio-output-stream-text;
                    audio-supports-44100:  root.audio-supports-44100;
                    audio-supports-48000:  root.audio-supports-48000;
                    audio-supports-88200:  root.audio-supports-88200;
                    audio-supports-96000:  root.audio-supports-96000;
                    audio-supports-176400: root.audio-supports-176400;
                    audio-supports-192000: root.audio-supports-192000;
                    audio-supports-mono:   root.audio-supports-mono;
                    audio-supports-stereo: root.audio-supports-stereo;
                    audio-sample-rate-text: root.audio-sample-rate-text;
                    audio-channel-count-text: root.audio-channel-count-text;
                    audio-render-window-text: root.audio-render-window-text;
                    soundfont-text:         root.audio-soundfont-text;
                    soundfont-count-text:   root.audio-soundfont-count-text;
                    audio-soundfont-enabled: root.audio-soundfont-enabled;
                    audio-engine-detail-text: root.audio-engine-detail-text;
                    audio-effects-text:    root.audio-effects-text;
                    audio-interpolation-text: root.audio-interpolation-text;
                    audio-voice-count-text: root.audio-voice-count-text;
                    audio-layer-limit-text: root.audio-layer-limit-text;
                    audio-limiter-text:     root.audio-limiter-text;
                    audio-threading-text:  root.audio-threading-text;
                    audio-ignore-range-text: root.audio-ignore-range-text;
                    audio-attack-curve-text: root.audio-attack-curve-text;
                    audio-decay-curve-text: root.audio-decay-curve-text;
                    audio-release-curve-text: root.audio-release-curve-text;
                    audio-parallelism-text: root.audio-parallelism-text;
                    select-sample-rate(rate) => { root.select-audio-sample-rate(rate); }
                    select-channel-count(channels) => { root.select-audio-channel-count(channels); }
                    select-render-window(ms) => { root.select-audio-render-window(ms); }
                    select-soundfont      => { root.select-audio-soundfont(); }
                    reset-soundfont       => { root.reset-audio-soundfont(); }
                    toggle-soundfont-enabled => { root.toggle-audio-soundfont-enabled(); }
                    select-interpolation(mode) => { root.select-audio-interpolation(mode); }
                    select-effects(mode)  => { root.select-audio-effects(mode); }
                    select-layer-limit(limit) => { root.select-audio-layer-limit(limit); }
                    select-limiter(mode) => { root.select-audio-limiter(mode); }
                    select-threading(mode) => { root.select-audio-threading(mode); }
                    select-ignore-range(mode) => { root.select-audio-ignore-range(mode); }
                    select-attack-curve(mode) => { root.select-audio-attack-curve(mode); }
                    select-decay-curve(mode) => { root.select-audio-decay-curve(mode); }
                    select-release-curve(mode) => { root.select-audio-release-curve(mode); }
                }
            }


            // ──────────────────────────────────────
            //  CENTER: Viewport column
            //  (Preview / Video / Audio)
            // ──────────────────────────────────────
            VerticalLayout {
                visible: root.has-viewport;
                horizontal-stretch: root.full-viewport ? 1 : 0;
                vertical-stretch: root.has-viewport ? 1 : 0;
                min-width: root.has-viewport ? 100px : 0px;
                max-width: root.has-viewport ? 100000px : 0px;
                spacing: 0px;

                viewport-box := Rectangle {
                    horizontal-stretch: root.full-viewport ? 1 : 0;
                    vertical-stretch:   root.full-viewport ? 1 : 0;
                    min-width:  root.compact-viewport ? 460px    : 100px;
                    max-width:  root.compact-viewport ? 460px    : 100000px;
                    min-height: root.compact-viewport ? 259px    : 100px;
                    max-height: root.compact-viewport ? 259px    : 100000px;
                    background: #050810;

                    Image {
                        source: root.viewport-image;
                        width: parent.width;
                        height: parent.height;
                        image-fit: fill;
                    }

                    // FPS overlay (top-right) — expandable stats badge
                    Rectangle {
                        visible: root.render-load-state == MidiLoadState.loaded;
                        x: parent.width - self.width - 8px;
                        y: 8px;
                        width: stats-expanded ? 180px : 68px;
                        height: stats-expanded ? 156px : 22px;
                        border-radius: stats-expanded ? 8px : 4px;
                        background: stats-touch.has-hover
                            ? (stats-expanded ? #0a0e18e0 : #0c1220c0)
                            : #06091180;
                        clip: true;

                        property <bool> stats-expanded: false;

                        animate width { duration: 150ms; easing: ease-out; }
                        animate height { duration: 150ms; easing: ease-out; }
                        animate border-radius { duration: 150ms; }
                        animate background { duration: 100ms; }

                        VerticalLayout {
                            padding: stats-expanded ? 8px : 0px;
                            spacing: 0px;

                            // Collapsed: just FPS
                            if !stats-expanded : HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                height: 22px;
                                spacing: 4px;
                                alignment: center;

                                Text { text: root.fps-text; color: #4d6580; font-family: "monospace"; font-size: 10px; vertical-alignment: center; }
                                Text { text: "fps";         color: #2d3d52; font-size: 9px;           vertical-alignment: center; }
                            }

                            // Expanded: stats for nerds
                            if stats-expanded : VerticalLayout {
                                spacing: 2px;

                                // Header row
                                HorizontalLayout {
                                    spacing: 4px;
                                    height: 20px;

                                    Text { text: root.fps-text; color: #60a5fa; font-family: "monospace"; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                    Text { text: "fps";         color: #3d5068; font-size: 9px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: root.viewport-text; color: #2d3d52; font-family: "monospace"; font-size: 9px; vertical-alignment: center; }
                                }

                                // Separator
                                Rectangle { height: 1px; background: #141e2e; }
                                Rectangle { height: 4px; }

                                // Stats rows
                                HorizontalLayout {
                                    height: 18px;
                                    Text { text: "Notes"; color: #3d5068; font-size: 9px; vertical-alignment: center; min-width: 70px; }
                                    Text { text: root.note-count-text; color: #6b7d94; font-family: "monospace"; font-size: 9px; vertical-alignment: center; }
                                }
                                HorizontalLayout {
                                    height: 18px;
                                    Text { text: "Visible"; color: #3d5068; font-size: 9px; vertical-alignment: center; min-width: 70px; }
                                    Text { text: root.visible-note-count-text; color: #6b7d94; font-family: "monospace"; font-size: 9px; vertical-alignment: center; }
                                }
                                HorizontalLayout {
                                    height: 18px;
                                    Text { text: "Active Keys"; color: #3d5068; font-size: 9px; vertical-alignment: center; min-width: 70px; }
                                    Text { text: root.active-keys-text; color: #6b7d94; font-family: "monospace"; font-size: 9px; vertical-alignment: center; }
                                }
                                HorizontalLayout {
                                    height: 18px;
                                    Text { text: "Voices"; color: #3d5068; font-size: 9px; vertical-alignment: center; min-width: 70px; }
                                    Text { text: root.audio-voice-count-text; color: #6b7d94; font-family: "monospace"; font-size: 9px; vertical-alignment: center; }
                                }
                                HorizontalLayout {
                                    height: 18px;
                                    Text { text: "Stream"; color: #3d5068; font-size: 9px; vertical-alignment: center; min-width: 70px; }
                                    Text { text: root.audio-output-stream-text; color: #6b7d94; font-family: "monospace"; font-size: 9px; vertical-alignment: center; }
                                }
                            }
                        }

                        stats-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { parent.stats-expanded = !parent.stats-expanded; }
                        }
                    }

                    // ── Preview Welcome overlay ──
                    PreviewWelcome {
                        visible: root.show-preview-welcome;
                        x: 0; y: 0; width: parent.width; height: parent.height;

                        midi-state:         root.preview-load-state;
                        selected-midi-name: root.selected-midi-name;
                        loading-status:     root.preview-loading-status;
                        loading-progress:   root.preview-loading-progress;
                        load-error:         root.preview-load-error;
                        drop-hovering:      root.drop-hovering;
                        select-file         => { root.select-midi-file(); }
                        load-midi           => { root.load-for-preview(); }
                        cancel-load         => { root.cancel-load-preview(); }
                        unload-midi         => { root.unload-preview(); }
                        retry-load          => { root.retry-load-preview(); }
                    }
                }

                // ── Info pane below compact viewport ──
                Rectangle {
                    visible: root.compact-viewport;
                    vertical-stretch: root.compact-viewport ? 1 : 0;
                    min-height: root.compact-viewport ? 100px : 0px;
                    max-height: root.compact-viewport ? 100000px : 0px;
                    background: #080d16;

                    Rectangle { y: 0; height: 1px; width: parent.width; background: #141e2e; }

                    VerticalLayout {
                        padding: 16px;
                        spacing: 4px;
                        alignment: start;

                        SectionHeader { title: "PREVIEW"; }
                        Rectangle { height: 4px; }
                        FieldRow { label: "MIDI";        value: root.selected-midi-name != "" ? root.selected-midi-name : "No file selected"; }
                        FieldRow { label: "Total Notes"; value: root.note-count-text; }
                        FieldRow { label: "Visible";     value: root.visible-note-count-text; }
                        FieldRow { label: "Active Keys"; value: root.active-keys-text; }
                        FieldRow { label: "Viewport";    value: root.viewport-text; }
                        FieldRow { label: "FPS";         value: root.fps-text; }
                        Rectangle { height: 8px; }
                        Text { text: root.scene-summary-text; color: #2d3d52; font-size: 10px; overflow: elide; }
                    }
                }
            }


            // ──────────────────────────────────────
            //  FULL-WIDTH: Panel-only profiles
            //  (Render / Modify / Analysis — no viewport)
            // ──────────────────────────────────────
            Rectangle {
                visible: root.panel-only;
                horizontal-stretch: root.panel-only ? 1 : 0;
                min-width: root.panel-only ? 100px : 0px;
                max-width: root.panel-only ? 100000px : 0px;
                background: #0a1018;

                RenderPanel {
                    visible: root.active-profile == 2;
                    x: 0; y: 0; width: parent.width; height: parent.height;

                    selected-midi-name: root.selected-midi-name;
                    midi-length-text: root.length-text;
                    scene-summary-text: root.scene-summary-text;
                    render-load-state: root.render-load-state;
                    audio-load-state: root.audio-load-state;
                    render-mode-text: root.render-mode-text;
                    render-output-path-text: root.render-output-path-text;
                    render-video-resolution-text: root.render-video-resolution-text;
                    render-video-fps-text: root.render-video-fps-text;
                    render-audio-format-text: root.render-audio-format-text;
                    render-audio-sample-rate-text: root.render-audio-sample-rate-text;
                    render-audio-channel-count-text: root.render-audio-channel-count-text;
                    render-video-ffmpeg-args-text: root.render-video-ffmpeg-args-text;
                    render-audio-ffmpeg-args-text: root.render-audio-ffmpeg-args-text;
                    render-video-codec-text: root.render-video-codec-text;
                    render-video-crf-text: root.render-video-crf-text;
                    render-video-preset-text: root.render-video-preset-text;
                    render-video-pix-fmt-text: root.render-video-pix-fmt-text;
                    render-audio-bitrate-text: root.render-audio-bitrate-text;
                    render-use-limiter: root.render-use-limiter;
                    render-open-after-export: root.render-open-after-export;
                    audio-supports-44100: root.audio-supports-44100;
                    audio-supports-48000: root.audio-supports-48000;
                    audio-supports-88200: root.audio-supports-88200;
                    audio-supports-96000: root.audio-supports-96000;
                    audio-supports-176400: root.audio-supports-176400;
                    audio-supports-192000: root.audio-supports-192000;
                    audio-supports-mono: root.audio-supports-mono;
                    audio-supports-stereo: root.audio-supports-stereo;
                    video-render-progress: root.video-render-progress;
                    video-render-status: root.video-render-status;
                    video-render-elapsed: root.video-render-elapsed;
                    video-render-output-text: root.video-render-output-text;
                    audio-render-progress: root.audio-render-progress;
                    audio-render-status: root.audio-render-status;
                    audio-render-elapsed: root.audio-render-elapsed;
                    audio-render-output-text: root.audio-render-output-text;
                    export-progress: root.render-export-progress;
                    export-status: root.render-export-status;
                    export-detail-text: root.render-export-detail-text;
                    select-mode(mode) => { root.select-render-mode(mode); }
                    browse-output => { root.browse-render-output(); }
                    select-resolution(preset) => { root.select-render-resolution(preset); }
                    submit-custom-resolution(val) => { root.submit-custom-render-resolution(val); }
                    select-fps(fps) => { root.select-render-fps(fps); }
                    submit-custom-fps(val) => { root.submit-custom-render-fps(val); }
                    select-audio-format(format) => { root.select-render-audio-format(format); }
                    select-audio-sample-rate(rate) => { root.select-render-audio-sample-rate(rate); }
                    select-audio-channel-count(channels) => { root.select-render-audio-channel-count(channels); }
                    change-video-ffmpeg-args(args) => { root.change-render-video-ffmpeg-args(args); }
                    change-audio-ffmpeg-args(args) => { root.change-render-audio-ffmpeg-args(args); }
                    select-video-codec(codec) => { root.select-render-video-codec(codec); }
                    select-video-crf(crf) => { root.select-render-video-crf(crf); }
                    submit-custom-crf(val) => { root.submit-custom-render-video-crf(val); }
                    select-video-preset(preset) => { root.select-render-video-preset(preset); }
                    select-video-pix-fmt(fmt) => { root.select-render-video-pix-fmt(fmt); }
                    select-audio-bitrate(rate) => { root.select-render-audio-bitrate(rate); }
                    submit-custom-audio-bitrate(val) => { root.submit-custom-render-audio-bitrate(val); }
                    toggle-use-limiter => { root.toggle-render-use-limiter(); }
                    toggle-open-after-export => { root.toggle-render-open-after-export(); }
                    start-export => { root.start-export(); }
                    cancel-export => { root.cancel-export(); }
                }

                ModifyPanel {
                    visible: root.active-profile == 4;
                    x: 0; y: 0; width: parent.width; height: parent.height;

                    midi-state:               root.analysis-load-state;
                    selected-midi-name:       root.selected-midi-name;
                    loading-status:           root.analysis-loading-status;
                    loading-progress:         root.analysis-loading-progress;
                    load-error:               root.analysis-load-error;
                    select-file               => { root.select-midi-file(); }
                    load-midi                 => { root.load-for-analysis(); }
                    cancel-load               => { root.cancel-load-analysis(); }
                    unload-midi               => { root.unload-analysis(); }
                    retry-load                => { root.retry-load-analysis(); }

                    current-renderer-text:    root.current-renderer-text;
                    time-space-text:          root.time-space-text;
                    note-count-text:          root.note-count-text;
                    visible-note-count-text:  root.visible-note-count-text;
                    active-keys-text:         root.active-keys-text;
                    viewport-text:            root.viewport-text;
                    fps-text:                 root.fps-text;
                    inspector-items:          root.inspector-items;
                    select-renderer(r)        => { root.select-renderer(r); }
                    select-time-space(ts)     => { root.select-time-space(ts); }
                }

                AnalysisPanel {
                    visible: root.active-profile == 5;
                    x: 0; y: 0; width: parent.width; height: parent.height;

                    midi-state:            root.analysis-load-state;
                    selected-midi-name:    root.selected-midi-name;
                    loading-status:        root.analysis-loading-status;
                    loading-progress:      root.analysis-loading-progress;
                    load-error:            root.analysis-load-error;
                    select-file            => { root.select-midi-file(); }
                    load-midi              => { root.load-for-analysis(); }
                    cancel-load            => { root.cancel-load-analysis(); }
                    unload-midi            => { root.unload-analysis(); }
                    retry-load             => { root.retry-load-analysis(); }

                    note-count-text:       root.analysis-note-count-text;
                    track-count-text:      root.analysis-track-count-text;
                    midi-length-text:      root.analysis-midi-length-text;
                    tempo-text:            root.analysis-tempo-text;
                    time-signature-text:   root.analysis-time-signature-text;
                    key-range-text:        root.analysis-key-range-text;
                    avg-velocity-text:     root.analysis-avg-velocity-text;
                    median-velocity-text:  root.analysis-median-velocity-text;
                    p90-velocity-text:     root.analysis-p90-velocity-text;
                    low-velocity-share-text: root.analysis-low-velocity-share-text;
                    high-velocity-share-text: root.analysis-high-velocity-share-text;
                    note-density-text:     root.analysis-note-density-text;
                    note-traffic-count-text: root.analysis-note-traffic-count-text;
                    note-traffic-share-text: root.analysis-note-traffic-share-text;
                    note-traffic-fraction: root.analysis-note-traffic-fraction;
                    other-events-count-text: root.analysis-other-events-count-text;
                    other-events-share-text: root.analysis-other-events-share-text;
                    other-events-fraction: root.analysis-other-events-fraction;
                    top-non-note-family-text: root.analysis-top-non-note-family-text;
                    top-non-note-share-text: root.analysis-top-non-note-share-text;
                    top-non-note-fraction: root.analysis-top-non-note-fraction;

                    // File metrics
                    file-size-text:        root.analysis-file-size-text;
                    gzip-size-text:        root.analysis-gzip-size-text;
                    gzip-ratio-text:       root.analysis-gzip-ratio-text;
                    format-text:           root.analysis-format-text;
                    declared-tracks-text:  root.analysis-declared-tracks-text;
                    actual-tracks-text:    root.analysis-actual-tracks-text;
                    ticks-per-quarter-text: root.analysis-ticks-per-quarter-text;
                    total-events-text:     root.analysis-total-events-text;

                    // Tempo metrics
                    initial-bpm-text:      root.analysis-initial-bpm-text;
                    min-bpm-text:          root.analysis-min-bpm-text;
                    max-bpm-text:          root.analysis-max-bpm-text;
                    avg-bpm-text:          root.analysis-avg-bpm-text;

                    // Note metrics
                    avg-note-length-text:  root.analysis-avg-note-length-text;
                    min-note-length-text:  root.analysis-min-note-length-text;
                    max-note-length-text:  root.analysis-max-note-length-text;
                    total-note-duration-text: root.analysis-total-note-duration-text;
                    max-polyphony-text:    root.analysis-max-polyphony-text;
                    avg-polyphony-text:    root.analysis-avg-polyphony-text;
                    peak-nps-text:         root.analysis-peak-nps-text;
                    avg-nps-text:          root.analysis-avg-nps-text;
                    unique-onsets-text:    root.analysis-unique-onsets-text;

                    // Summary
                    densest-key-text:      root.analysis-densest-key-text;
                    densest-key-notes-text: root.analysis-densest-key-notes-text;

                    // Histograms
                    key-histogram:         root.analysis-key-histogram;
                    velocity-histogram:    root.analysis-velocity-histogram;
                    pitch-class-histogram: root.analysis-pitch-class-histogram;
                    channel-histogram:     root.analysis-channel-histogram;
                    track-histogram:       root.analysis-track-histogram;
                    density-timeline:      root.analysis-density-timeline;

                    // Event breakdown
                    event-composition:     root.analysis-event-composition;
                    event-breakdown:       root.analysis-event-breakdown;
                    event-breakdown-left:  root.analysis-event-breakdown-left;
                    event-breakdown-right: root.analysis-event-breakdown-right;
                    event-total-text:      root.analysis-event-total-text;
                }
            }
        }
    }

    // ══════════════════════════════════════════
    //  DROP OVERLAY (topmost layer)
    // ══════════════════════════════════════════
    DropOverlay {
        visible-when: root.drop-hovering && root.active-profile != 0;
        x: 0; y: 0;
        width: root.width;
        height: root.height;
    }
}

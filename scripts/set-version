#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
    echo "usage: scripts/set-version <version>" >&2
    exit 1
}

[[ $# -eq 1 ]] || usage

version="${1#v}"
if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z][0-9A-Za-z.-]*)?([+][0-9A-Za-z.-]+)?$ ]]; then
    echo "invalid version: $1" >&2
    exit 1
fi

printf '%s\n' "$version" > "$ROOT_DIR/VERSION"

perl -0pi -e 's/(\[workspace\.package\]\n(?:.*\n)*?version = ")[^"]+(")/${1}'"$version"'${2}/s' \
    "$ROOT_DIR/Cargo.toml"

perl -0pi -e 's/("version": ")[^"]+(")/${1}'"$version"'${2}/' \
    "$ROOT_DIR/sdk/typescript/package.json"

echo "set Meridian release version to $version"
